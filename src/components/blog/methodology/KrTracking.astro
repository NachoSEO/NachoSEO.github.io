---
/**
 * Seguimiento semanal del KR1 del ejemplo (fichas indexadas, de 19.700 a 38.400 en 13 semanas).
 * Ilustrativo: el ritmo lineal frente al real, con el retraso típico hasta que Google reacciona.
 */
const weeks = 13;
const start = 19700;
const goal = 38400;
const actual = [19700, 19720, 19760, 19800, 19900, 20900, 22800, 25300, 28100];
const projection = [28100, 30900, 33300, 35400, 37000, 38200];
const currentWeek = actual.length - 1;

const width = 640;
const height = 250;
const pad = { top: 18, right: 18, bottom: 34, left: 56 };
const plotW = width - pad.left - pad.right;
const plotH = height - pad.top - pad.bottom;
const minY = 18000;
const maxY = 40000;
const x = (week: number) => pad.left + (plotW * week) / weeks;
const y = (value: number) => pad.top + plotH * (1 - (value - minY) / (maxY - minY));
const points = (values: number[], offset = 0) => values.map((value, index) => `${x(index + offset)},${y(value)}`).join(' ');
const targetAt = (week: number) => start + ((goal - start) * week) / weeks;
// En español, forzamos el punto de miles también en números de 4 cifras (8.500), como en el resto del post
const format = (value: number) => value.toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions);
const ticks = [20000, 25000, 30000, 35000, 40000];
const gap = targetAt(currentWeek) - actual[currentWeek];
---

<figure class="kr-tracking not-prose my-10">
  <div class="kr-head">
    <p><span class="kr-tag">KR1</span> Fichas indexadas: de {format(start)} a {format(goal)}</p>
    <p class="kr-now">
      Semana {currentWeek}: <strong>{format(actual[currentWeek])}</strong> · ritmo lineal {format(Math.round(targetAt(currentWeek)))} ·
      <span>{format(Math.round(gap))} por debajo</span>
    </p>
  </div>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="kr-title" class="h-auto w-full">
    <title id="kr-title">
      Fichas indexadas por semana: casi planas hasta la semana 4 y subiendo desde la 5, por debajo del ritmo lineal en la semana 8 pero con la pendiente necesaria para llegar a 38.400
    </title>
    {
      ticks.map((tick) => (
        <g>
          <line x1={pad.left} x2={width - pad.right} y1={y(tick)} y2={y(tick)} class="grid" />
          <text x={pad.left - 8} y={y(tick) + 4} text-anchor="end" class="axis">{format(tick)}</text>
        </g>
      ))
    }
    {[0, 4, 8, 13].map((week) => <text x={x(week)} y={height - 12} text-anchor="middle" class="axis">S{week}</text>)}
    <line x1={x(0)} y1={y(goal)} x2={x(weeks)} y2={y(goal)} class="goal" />
    <text x={x(0) + 4} y={y(goal) - 6} class="goal-label">Objetivo: {format(goal)}</text>
    <line x1={x(0)} y1={y(start)} x2={x(weeks)} y2={y(goal)} class="target" />
    <rect x={x(3) - 1} y={pad.top} width={x(5) - x(3)} height={plotH} class="lag" />
    <text x={(x(3) + x(5)) / 2} y={y(36500)} text-anchor="middle" class="lag-label">noindex en filtros</text>
    <polyline points={points(projection, currentWeek)} class="projection" />
    <polyline points={points(actual)} class="actual" />
    <circle cx={x(currentWeek)} cy={y(actual[currentWeek])} r="4.5" class="now" />
  </svg>
  <ul class="kr-legend">
    <li><i class="l-actual" />Real</li>
    <li><i class="l-target" />Ritmo lineal hasta el objetivo</li>
    <li><i class="l-projection" />Proyección</li>
  </ul>
  <figcaption>
    Ilustrativo. Con el KR en absoluto se ve desde la semana 1 que la línea no se mueve hasta que sale el noindex, y que después la pendiente ya es la que hace falta.
  </figcaption>
</figure>

<style>
  @layer components {
    figure.kr-tracking p,
    figure.kr-tracking ul {
      margin-top: 0;
    }
    figure.kr-tracking ul {
      list-style: none;
      padding-left: 0;
    }
    figure.kr-tracking li + li {
      margin-top: 0;
    }
  }
  .kr-tracking {
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    background: var(--color-raised);
    padding: 0.9rem;
    font-size: 0.82rem;
  }
  .kr-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.4rem;
    font-weight: 600;
  }
  .kr-tag {
    margin-right: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent-ink);
  }
  .kr-now {
    color: var(--color-muted);
    font-weight: 400;
  }
  .kr-now strong {
    color: var(--color-ink);
  }
  .kr-now span {
    color: var(--color-accent-ink);
  }
  .grid {
    stroke: var(--color-line);
  }
  .axis {
    fill: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .goal {
    stroke: var(--color-ink);
    stroke-width: 1;
  }
  .goal-label {
    fill: var(--color-ink);
    font-size: 11px;
    font-weight: 600;
  }
  .target {
    stroke: var(--color-muted);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .lag {
    fill: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
  .lag-label {
    fill: var(--color-accent-ink);
    font-size: 10px;
  }
  .actual {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.5;
  }
  .projection {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-dasharray: 2 4;
  }
  .now {
    fill: var(--color-accent);
  }
  .kr-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--color-muted);
    font-size: 0.75rem;
  }
  .kr-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .kr-legend i {
    width: 1rem;
    height: 0;
    border-top: 2.5px solid var(--color-accent);
  }
  .kr-legend .l-target {
    border-top: 1.5px dashed var(--color-muted);
  }
  .kr-legend .l-projection {
    border-top: 2px dotted var(--color-accent);
  }
  .kr-tracking figcaption {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }
</style>
