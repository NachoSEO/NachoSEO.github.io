---
import { ogImagePathFor } from '../lib/og-path.mjs';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import CaseLogo from '../components/CaseLogo.astro';
import Cta from '../components/Cta.astro';
import { caseBrands } from '../data/case-brands';
import { localizedRoute } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  path: string;
  alternatePath?: string;
}

const { entry, path, alternatePath } = Astro.props;
const lang = entry.data.lang as Lang;
const { Content } = await render(entry);
const brand = caseBrands[entry.data.translationKey]?.brand;

const labels =
  lang === 'es'
    ? { cases: 'Casos', home: 'Inicio', eyebrow: 'Caso de éxito', back: 'Todos los casos' }
    : { cases: 'Case studies', home: 'Home', eyebrow: 'Case study', back: 'All case studies' };

const articleNode = {
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: lang === 'es' ? 'es-ES' : 'en',
  author: { '@id': `${Astro.site!.origin}/#person` },
  publisher: { '@id': `${Astro.site!.origin}/#person` },
  image: new URL(ogImagePathFor(path), Astro.site).href,
  isPartOf: { '@id': `${Astro.site!.origin}/#website` },
  mainEntityOfPage: new URL(path, Astro.site).href,
};
---

<Base
  lang={lang}
  title={entry.data.title.length > 45 ? entry.data.title : `${entry.data.title} — Nacho Mascort`}
  description={entry.data.description}
  path={path}
  alternatePath={alternatePath}
  ogType="article"
  breadcrumbs={[
    { name: labels.home, path: localizedRoute('home', lang) },
    { name: labels.cases, path: localizedRoute('cases', lang) },
    { name: entry.data.title, path },
  ]}
  extraSchemaNodes={[articleNode]}
>
  <article class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
    <p class="meta">
      <a href={localizedRoute('cases', lang)} class="hover:text-ink">{labels.cases}</a>
      <span aria-hidden="true"> / </span>{labels.eyebrow}
    </p>
    {
      brand && (
        <div class="mt-8 flex h-10 items-center">
          <CaseLogo brand={brand} variant="color" />
        </div>
      )
    }
    <h1 class="display-1 mt-5 max-w-[24ch]">{entry.data.title}</h1>
    <p class="lede mt-6">{entry.data.description}</p>

    <dl class="mt-12 grid grid-cols-2 border-t border-ink sm:grid-cols-4">
      {
        entry.data.metrics.map((metric) => (
          <div class="flex flex-col-reverse justify-end border-b border-line py-5 pr-4">
            <dt class="mt-1 text-sm text-muted">{metric.label}</dt>
            <dd class="font-display text-3xl font-semibold tracking-tight">{metric.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="article-body mt-12">
      <Content />
    </div>

    <a href={localizedRoute('cases', lang)} class="link-arrow mt-12 inline-block text-[0.95rem]">{labels.back}</a>
  </article>

  <Cta lang={lang} />
</Base>
