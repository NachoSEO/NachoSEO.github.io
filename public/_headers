# Cloudflare Pages: cabeceras de seguridad (única fuente de la CSP del sitio)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://umami-lyart-nu.vercel.app; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com https://umami-lyart-nu.vercel.app; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=(), usb=()
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap-index.xml>; rel="sitemap"; type="application/xml", </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"

# Recursos con hash en el nombre: caché de un año
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Versiones en Markdown para LLMs y agentes
/*.md
  Content-Type: text/markdown; charset=utf-8

# La portada anuncia su versión Markdown
/
  Link: </index.md>; rel="alternate"; type="text/markdown"

# Descubrimiento para agentes
/.well-known/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

# Descargas enlazadas desde los emails: fuera del índice
/descargas/*
  X-Robots-Tag: noindex
