---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';

const posts = await getCollection('blog', (entry) => entry.data.lang === 'en');
---

<Base
  lang="en"
  title="Blog on growth, AI & SEO — Nacho Mascort"
  description="Articles on growth, AI applied to marketing, SEO, GEO/AEO and automation, written from real execution."
  path="/en/blog/"
  alternatePath="/blog/"
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'Blog', path: '/en/blog/' },
  ]}
>
  <div class="mx-auto max-w-5xl px-5 sm:px-6 pt-16 pb-8">
    <p class="meta">Blog</p>
    <h1 class="display-1 mt-5">Blog</h1>
    <p class="lede mt-6">
      Growth, applied AI, SEO and automation, told from real projects.
    </p>
    <PostList posts={posts} lang="en" />
  </div>
</Base>
