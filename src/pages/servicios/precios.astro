---
/**
 * "Cuánto cuesta el SEO": sin tarifa publicada. Formatos, qué mueve el precio y el formulario de presupuesto
 * incrustado (pre-marcado en SEO y GEO). Contenido en src/data/pricing.ts, compartido con la versión Markdown.
 */
import Base from '../../layouts/Base.astro';
import BriefForm from '../../components/BriefForm.astro';
import FaqAccordion from '../../components/service/FaqAccordion.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { pricingPage, pricingPageEn } from '../../data/pricing';
---

<Base
  lang="es"
  title={`${pricingPage.title} — Nacho Mascort`}
  description={pricingPage.description}
  path={pricingPage.path}
  alternatePath={pricingPageEn.path}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/servicios/' },
    { name: pricingPage.title, path: pricingPage.path },
  ]}
  faq={[...pricingPage.faq]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 md:pt-20">
    <p class="section-label">Precios</p>
    <h1 class="display-1 mt-4">{pricingPage.title}</h1>
    <p class="lede mt-5 max-w-[62ch]">{pricingPage.lede}</p>
    <a href="#presupuesto" class="btn mt-8">Pide tu presupuesto</a>
  </div>

  <section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
    <SectionLabel label="Formatos" />
    <h2 class="display-2 mt-3">Cómo trabajo y cuánto dura cada proyecto</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        pricingPage.formats.map((format) => (
          <a href={format.href} class="card flex flex-col">
            <p class="meta">{format.duration}</p>
            <h3 class="card-title display-3 mt-2 transition-colors">{format.name}</h3>
            <p class="mt-3 flex-1 text-[0.95rem] text-muted">{format.detail}</p>
            <p class="link-arrow mt-5 text-[0.95rem]">Ver el servicio</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
    <SectionLabel label="El precio" />
    <h2 class="display-2 mt-3">Qué sube y qué baja el precio</h2>
    <ul class="row-list mt-8">
      {
        pricingPage.drivers.map((driver) => (
          <li class="grid gap-1 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6">
            <h3 class="font-semibold">{driver.title}</h3>
            <p class="max-w-[65ch] text-[0.95rem] text-muted">{driver.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
    <SectionLabel label="Antes de contratar" />
    <h2 class="display-2 mt-3">Qué pedir a cualquier presupuesto SEO</h2>
    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="display-3">Que te lo dejen claro</h3>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[0.95rem] marker:text-accent">
          {pricingPage.checklist.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="display-3">Señales para desconfiar</h3>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[0.95rem] marker:text-accent">
          {pricingPage.redFlags.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <FaqAccordion lang="es" faq={[...pricingPage.faq]} />

  <section id="presupuesto" class="mx-auto max-w-3xl scroll-mt-24 px-5 pt-16 pb-20 sm:px-6 md:pt-24">
    <SectionLabel label="Presupuesto" />
    <h2 class="display-2 mt-3">Cuéntame qué necesitas</h2>
    <p class="mt-4 text-muted">
      Son 5 minutos y solo verás las preguntas que afectan al precio de lo que marques. Si algo no lo sabes, déjalo en
      blanco: lo vemos juntos.
    </p>
    <div class="mt-10">
      <BriefForm lang="es" />
    </div>
  </section>
</Base>
