---
import type { CollectionEntry } from 'astro:content';
import PostDate from './PostDate.astro';
import { localizedRoute } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  posts: CollectionEntry<'blog'>[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
const base = localizedRoute('blog', lang);
const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<ul class="row-list mt-12">
  {
    sorted.map((post) => (
      <li>
        <a href={`${base}${post.data.slug}/`} class="row-link group block py-6 sm:px-2">
          <p class="meta">
            <PostDate date={post.data.pubDate} lang={lang} month="short" />
          </p>
          <h2 class="display-3 mt-1 transition-colors group-hover:text-accent-ink">
            {post.data.title}
          </h2>
          <p class="mt-2 text-sm text-muted">{post.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>
