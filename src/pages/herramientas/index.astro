---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { toolsFor } from '../../data/tools';

const tools = toolsFor('es');
---

<Base
  lang="es"
  title="Herramientas SEO gratis — Nacho Mascort"
  description="Herramientas SEO gratis: calculadora del valor de una sesión orgánica, generador de sitemap XML y comprobador de acceso de bots. Sin registro."
  path="/herramientas/"
  alternatePath="/en/tools/"
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Herramientas', path: '/herramientas/' },
  ]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
    <p class="meta">Herramientas</p>
    <h1 class="display-1 mt-5">Herramientas SEO gratis</h1>
    <p class="lede mt-6">
      Herramientas de SEO técnico que he ido construyendo. Son gratis, no hace falta registrarse y no guardo nada de lo que
      compruebas.
    </p>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        tools.map((tool) => (
          <a href={tool.href} class="card flex flex-col">
            <h2 class="card-title display-3 transition-colors">{tool.title}</h2>
            <p class="mt-3 text-[0.95rem]">{tool.tagline}</p>
            <p class="mt-3 flex-1 text-sm text-muted">{tool.detail}</p>
            <p class="link-arrow mt-5 text-[0.95rem]">Abrir herramienta</p>
          </a>
        ))
      }
    </div>
  </div>

  <Cta lang="es" />
</Base>
