---
/**
 * Las 48.000 fichas del ejemplo, partidas por estado de indexación. La barra es proporcional y,
 * debajo, una columna por estado: qué significa, cómo sale en Search Console y qué acción pide.
 */
const parts = [
  {
    label: 'Indexadas',
    value: 19700,
    tone: 'ok',
    meaning: 'Google las tiene en el índice y pueden salir en los resultados.',
    status: 'Indexada',
    action: 'Posicionarlas mejor',
  },
  {
    label: 'Descubiertas, sin rastrear',
    value: 19800,
    tone: 'crawl',
    meaning: 'Google sabe que existen, pero todavía no las ha visitado.',
    status: 'Descubierta: actualmente sin indexar',
    action: 'Liberar rastreo y enlazarlas',
  },
  {
    label: 'Rastreadas, sin indexar',
    value: 8500,
    tone: 'quality',
    meaning: 'Google las ha visitado y ha decidido no guardarlas en el índice.',
    status: 'Rastreada: actualmente sin indexar',
    action: 'Arreglar la calidad',
  },
];
const total = parts.reduce((sum, part) => sum + part.value, 0);
// En español, forzamos el punto de miles también en números de 4 cifras (8.500), como en el resto del post
const format = (value: number) => value.toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions);
---

<figure class="indexing-split not-prose my-10">
  <p class="is-title">Las {format(total)} fichas de producto, según Search Console</p>
  <div class="is-bar" role="img" aria-label={parts.map((part) => `${part.label}: ${format(part.value)}`).join('; ')}>
    {parts.map((part) => <span class={`is-seg is-${part.tone}`} style={`flex: ${part.value}`}>{format(part.value)}</span>)}
  </div>
  <div class="is-cols">
    {
      parts.map((part) => (
        <div class={`is-col is-border-${part.tone}`}>
          <p class="is-label">{part.label}</p>
          <p class="is-value">{format(part.value)}</p>
          <p class="is-meaning">{part.meaning}</p>
          <p class="is-status">En Search Console: «{part.status}»</p>
          <p class="is-action">→ {part.action}</p>
        </div>
      ))
    }
  </div>
  <figcaption>Datos inventados del ejemplo. Las dos partes sin indexar parecen el mismo problema y piden acciones opuestas.</figcaption>
</figure>

<style>
  @layer components {
    figure.indexing-split p {
      margin-top: 0;
    }
  }
  .indexing-split {
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    background: var(--color-raised);
    padding: 0.9rem;
    font-size: 0.82rem;
    line-height: 1.4;
  }
  .is-title {
    font-weight: 700;
  }
  .is-bar {
    display: flex;
    gap: 2px;
    height: 1.9rem;
    margin-top: 0.5rem;
    overflow: hidden;
    border-radius: 0.4rem;
  }
  .is-seg {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .is-ok {
    background: #2f6f4f;
  }
  .is-crawl {
    background: var(--color-ink);
  }
  .is-quality {
    background: var(--color-accent);
  }
  .is-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .is-col {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    border-top: 3px solid;
    padding-top: 0.5rem;
  }
  .is-border-ok {
    border-color: #2f6f4f;
  }
  .is-border-crawl {
    border-color: var(--color-ink);
  }
  .is-border-quality {
    border-color: var(--color-accent);
  }
  .is-label {
    font-weight: 700;
  }
  .is-value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .is-status {
    color: var(--color-muted);
    font-size: 0.75rem;
  }
  .is-action {
    font-weight: 600;
    color: var(--color-accent-ink);
  }
  .indexing-split figcaption {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }
  @media (max-width: 640px) {
    .is-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
