---
import { translatedPaths } from '../../../lib/translations';
import Post from '../../../layouts/Post.astro';

export function getStaticPaths() {
  return translatedPaths('blog', 'en');
}

const { entry, translationSlug } = Astro.props;
const path = `/en/blog/${entry.data.slug}/`;
const alternatePath = translationSlug ? `/blog/${translationSlug}/` : undefined;
---

<Post entry={entry} path={path} alternatePath={alternatePath} />
