---
import SectionLabel from './SectionLabel.astro';
import { media, mediaTypeLabels, talks, teaching } from '../data/appearances';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy =
  lang === 'es'
    ? {
        teaching: 'Docencia',
        teachingNote: 'Además, Google Product Expert en la comunidad de Search Console.',
        talks: 'Charlas',
        slides: 'Ver slides',
        media: 'Podcasts, medios y artículos',
      }
    : {
        teaching: 'Teaching',
        teachingNote: 'I am also a Google Product Expert in the Search Console community.',
        talks: 'Talks',
        slides: 'See slides',
        media: 'Podcasts, press and articles',
      };
---

<section id="docencia" class="mt-24 scroll-mt-8">
  <SectionLabel label={copy.teaching} asHeading />
  <ul class="row-list mt-8">
    {
      teaching.map((item) => (
        <li>
          <a
            href={item.url}
            rel="noopener"
            class="row-link group grid gap-1 py-5 sm:grid-cols-[9rem_1fr_auto] sm:gap-6 sm:px-2"
          >
            <span class="meta pt-1">{item.period}</span>
            <span>
              <span class="row-title block font-semibold transition-colors">
                {item.program[lang]} · {item.school}
              </span>
              <span class="mt-1 block text-[0.95rem] text-muted">{item.topics[lang]}</span>
            </span>
            <span class="hidden pt-1 text-muted sm:block" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-4 text-[0.95rem] text-muted">{copy.teachingNote}</p>
</section>

<section id="charlas" class="mt-24 scroll-mt-8">
  <SectionLabel label={copy.talks} asHeading />
  <ul class="row-list mt-8">
    {
      talks.map((talk) => (
        <li>
          <a
            href={talk.url}
            rel="noopener"
            class="row-link group grid gap-1 py-5 sm:grid-cols-[9rem_1fr_auto] sm:gap-6 sm:px-2"
          >
            <span class="meta pt-1">
              {talk.event} {talk.year}
            </span>
            <span class="row-title font-semibold transition-colors">{talk.title[lang]}</span>
            <span class="link-arrow text-[0.95rem]">{copy.slides}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<section id="medios" class="mt-24 scroll-mt-8">
  <SectionLabel label={copy.media} asHeading />
  <ul class="row-list mt-8">
    {
      media.map((item) => (
        <li>
          <a
            href={item.url}
            rel="noopener"
            hreflang={item.lang ?? 'es'}
            class="row-link group grid gap-1 py-4 sm:grid-cols-[9rem_12rem_1fr] sm:gap-6 sm:px-2"
          >
            <span class="meta pt-1">{mediaTypeLabels[item.type][lang]}</span>
            <span class="text-[0.95rem] font-semibold">{item.outlet}</span>
            <span class="row-title text-[0.95rem] text-muted transition-colors" lang={(item.lang ?? 'es') !== lang ? (item.lang ?? 'es') : undefined}>
              {item.title}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
