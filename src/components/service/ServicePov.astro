---
import SectionLabel from '../SectionLabel.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  pov: { title: string; paragraphs: string[] };
}

const { lang, pov } = Astro.props;
---

<section id="sistema" class="mx-auto max-w-5xl scroll-mt-8 px-5 pt-24 sm:px-6">
  <SectionLabel label={lang === 'es' ? 'Mi punto de vista' : 'My point of view'} />
  <h2 class="display-2 mt-3 max-w-[24ch]">{pov.title}</h2>
  <div class="mt-6 max-w-[65ch] space-y-5 text-[1.05rem] leading-relaxed">
    {pov.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
