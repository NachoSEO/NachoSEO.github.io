---
import Base from '../layouts/Base.astro';
import AboutPage from '../components/AboutPage.astro';
import { aboutPage } from '../data/profile';
---

<Base
  lang="es"
  title="Sobre mí — Nacho Mascort"
  description={aboutPage.es.description}
  path="/sobre-mi/"
  alternatePath="/en/about/"
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Sobre mí', path: '/sobre-mi/' },
  ]}
  extraSchemaNodes={[
    { '@type': 'ProfilePage', url: new URL('/sobre-mi/', Astro.site).href, mainEntity: { '@id': `${Astro.site!.origin}/#person` } },
  ]}
>
  <AboutPage lang="es" />
</Base>
