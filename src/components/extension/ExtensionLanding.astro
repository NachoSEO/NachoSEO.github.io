---
/**
 * Landing de la extensión SEO & GEO Inspector (es y en). Lo único va primero, con capturas reales de la extensión
 * en webs públicas; después el diagnóstico técnico, lo básico, quién la hizo, privacidad, versión y FAQ.
 */
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cta from '../Cta.astro';
import AuthorByline from '../AuthorByline.astro';
import BrowserScene from './BrowserScene.astro';
import FaqAccordion from '../service/FaqAccordion.astro';
import type { Lang } from '../../i18n/ui';
import {
  EXTENSION_STORE_URL,
  extensionLanding,
  extensionPaths,
  extensionVersion,
  type ExtensionShot,
} from '../../data/extension';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';
const paths = extensionPaths[lang];
const copy = extensionLanding[lang];
const toolsPath = es ? '/herramientas/' : '/en/tools/';

const shotFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/extension/*/*.png', { eager: true });
const shot = (name: ExtensionShot) => shotFiles[`../../assets/img/extension/${lang}/${name}.png`].default;

/** Párrafos con enlaces [texto](url): se escapa todo y solo se convierten esos enlaces */
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const withLinks = (text: string) =>
  escape(text).replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, (_, label: string, url: string) => `<a href="${url}" rel="noopener">${label}</a>`);

const t = es
  ? {
      title: 'SEO & GEO Inspector: extensión de Chrome gratis para SEO y GEO — Nacho Mascort',
      description:
        'Extensión de Chrome gratis para SEO y GEO: robots.txt con el parser de Google para Googlebot y los bots de IA, la página con y sin JavaScript lado a lado, Core Web Vitals, schema, enlaces y hreflang.',
      crumbs: ['Inicio', 'Herramientas', 'Extensión SEO & GEO Inspector'],
      meta: 'Extensión de Chrome',
      lede: 'Mira cualquier URL como la ven Googlebot y los bots de IA: qué la bloquea y en qué línea del robots.txt, qué cambia el JavaScript y por qué no es indexable.',
      install: 'Añadir a Chrome, es gratis',
      soon: 'Muy pronto en la Chrome Web Store',
      meanwhile: 'Mientras tanto, las herramientas web',
      facts: 'Gratis · Sin registro · La extensión no lleva analítica · Español e inglés',
      uniqueLabel: 'Lo que la hace distinta',
      uniqueTitle: 'Cuatro cosas que no vas a encontrar juntas en otra extensión',
      diagnosticsLabel: 'Diagnóstico técnico',
      diagnosticsTitle: 'Todo lo que reviso en una página, en un clic',
      basicsTitle: 'Y lo básico, bien hecho',
      whoLabel: 'Quién la ha hecho',
      who: 'Es lo que reviso en cada página cuando hago una auditoría, ahora en un clic. Llevo en SEO técnico desde 2014: he dirigido el SEO de Softonic, con más de 1.000 millones de usuarios al año, y el de word.tips.',
      privacyLabel: 'Privacidad',
      privacyTitle: 'Nada sale de tu navegador',
      privacy: [
        'La extensión no tiene servidor ni recoge datos de uso: todo se calcula en tu navegador. La única excepción la eliges tú: si añades tu cuenta de DataForSEO, las consultas de volumen van de tu navegador a DataForSEO.',
        'Nunca hace peticiones a tu red local (routers, IPs privadas), ni siquiera si una web redirige a ellas.',
      ],
      privacyLink: 'Política de privacidad de la extensión',
      webTools: 'Si prefieres no instalar nada, varias comprobaciones están como herramientas web: el',
      webToolsLinks: [
        ['/herramientas/robots-txt-tester/', 'tester de robots.txt'],
        ['/herramientas/comprobador-bots/', 'comprobador de acceso de bots'],
        ['/herramientas/comprobador-redirecciones/', 'comprobador de redirecciones'],
      ],
      versionLabel: 'Versión',
      updated: 'Actualizada el',
      ctaTitle: '¿Prefieres que alguien lo mire por ti?',
    }
  : {
      title: 'SEO & GEO Inspector: free Chrome extension for SEO and GEO — Nacho Mascort',
      description:
        'Free Chrome extension for SEO and GEO: robots.txt with Google’s parser for Googlebot and AI bots, the page with and without JavaScript side by side, Core Web Vitals, schema, links and hreflang.',
      crumbs: ['Home', 'Tools', 'SEO & GEO Inspector extension'],
      meta: 'Chrome extension',
      lede: 'See any URL the way Googlebot and AI bots see it: what blocks it and on which robots.txt line, what JavaScript changes and why it isn’t indexable.',
      install: 'Add to Chrome, it’s free',
      soon: 'Coming soon to the Chrome Web Store',
      meanwhile: 'Meanwhile, the web tools',
      facts: 'Free · No sign-up · The extension has no analytics · English and Spanish',
      uniqueLabel: 'What sets it apart',
      uniqueTitle: 'Four things you won’t find together in another extension',
      diagnosticsLabel: 'Technical diagnosis',
      diagnosticsTitle: 'Everything I check on a page, in one click',
      basicsTitle: 'And the basics, done well',
      whoLabel: 'Who built it',
      who: 'It is what I check on every page when I run an audit, now in one click. I have worked in technical SEO since 2014: I led SEO at Softonic, with over 1 billion users a year, and at word.tips.',
      privacyLabel: 'Privacy',
      privacyTitle: 'Nothing leaves your browser',
      privacy: [
        'The extension has no server and collects no usage data: everything is computed in your browser. The only exception is your choice: if you add your DataForSEO account, volume lookups go from your browser to DataForSEO.',
        'It never makes requests to your local network (routers, private IPs), not even when a site redirects to them.',
      ],
      privacyLink: 'Extension privacy policy',
      webTools: 'If you’d rather not install anything, several checks are available as web tools: the',
      webToolsLinks: [
        ['/en/tools/robots-txt-tester/', 'robots.txt tester'],
        ['/en/tools/bot-access-checker/', 'bot access checker'],
        ['/en/tools/redirect-checker/', 'redirect checker'],
      ],
      versionLabel: 'Version',
      updated: 'Updated on',
      ctaTitle: 'Would you rather have someone look at it for you?',
    };

const faq = es
  ? [
      {
        question: '¿Es gratis?',
        answer:
          'Sí, entera y sin registro. Lo único que puede costarte dinero son los volúmenes de búsqueda, porque salen de tu propia cuenta de DataForSEO: pagas a DataForSEO solo lo que consultas, y la extensión guarda cada volumen 30 días para no repetir consultas.',
      },
      {
        question: '¿En qué se diferencia de otras extensiones de SEO?',
        answer:
          'Otras extensiones te dicen si una URL está bloqueada. Esta usa el parser oficial de Google y te dice qué línea del robots.txt lo decide, para Googlebot y para cada bot de IA. Además enseña la página con y sin JavaScript lado a lado, con el diff completo, y su icono te dice de un vistazo si el problema es de indexación o de rastreo.',
      },
      {
        question: '¿Qué datos recoge?',
        answer:
          'Ninguno. No tiene cuentas, ni analítica, ni servidor propio: todo se calcula en tu navegador. Si añades tus credenciales de DataForSEO, se guardan solo en tu navegador y las llamadas van directamente de tu equipo a DataForSEO.',
      },
      {
        question: '¿Por qué pide acceso a todas las webs?',
        answer:
          'Para registrar las redirecciones y las cabeceras de cada página que visitas, descargar su robots.txt y su HTML sin renderizar, y comprobar los hreflang de las otras versiones. Esas peticiones salen de tu navegador y sus resultados no se envían a ningún sitio. Los permisos están explicados uno a uno en la política de privacidad.',
      },
      {
        question: '¿Cuándo estará en la Chrome Web Store?',
        answer:
          'La estoy preparando para publicarla. Cuando salga, el botón de arriba llevará a la ficha. Mientras tanto, el tester de robots.txt, el comprobador de bots y el de redirecciones funcionan como herramientas web.',
      },
    ]
  : [
      {
        question: 'Is it free?',
        answer:
          'Yes, all of it, with no sign-up. The only thing that can cost money is search volume, because it comes from your own DataForSEO account: you pay DataForSEO only for what you look up, and the extension caches each volume for 30 days to avoid repeat lookups.',
      },
      {
        question: 'How is it different from other SEO extensions?',
        answer:
          'Other extensions tell you whether a URL is blocked. This one uses Google’s official parser and tells you which robots.txt line decides it, for Googlebot and for every AI bot. It also shows the page with and without JavaScript side by side, with the full diff, and its icon tells you at a glance whether the problem is indexing or crawling.',
      },
      {
        question: 'What data does it collect?',
        answer:
          'None. No accounts, no analytics, no server of its own: everything runs in your browser. If you add your DataForSEO credentials, they stay in your browser and the calls go straight from your computer to DataForSEO.',
      },
      {
        question: 'Why does it ask for access to all sites?',
        answer:
          'To record the redirects and headers of each page you visit, download its robots.txt and unrendered HTML, and check the hreflang of the other versions. Those requests leave your browser and their results are not sent anywhere. Each permission is explained in the privacy policy.',
      },
      {
        question: 'When will it be on the Chrome Web Store?',
        answer:
          'I’m getting it ready to publish. Once it’s out, the button above will link to the listing. In the meantime, the robots.txt tester, the bot access checker and the redirect checker work as web tools.',
      },
    ];

const screenshots = await Promise.all(
  (['popup-bots', 'comparar-vista', 'popup-resumen'] as const).map(async (name) => `https://nachomascort.com${(await getImage({ src: shot(name), format: 'webp', width: 1280 })).src}`)
);

const softwareApplication = {
  '@type': 'SoftwareApplication',
  name: 'SEO & GEO Inspector',
  url: `https://nachomascort.com${paths.landing}`,
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome',
  softwareVersion: extensionVersion.number,
  inLanguage: ['es', 'en'],
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  screenshot: screenshots,
  author: { '@id': 'https://nachomascort.com/#person' },
  ...(EXTENSION_STORE_URL ? { downloadUrl: EXTENSION_STORE_URL, installUrl: EXTENSION_STORE_URL } : {}),
};

const [indexability, ...gallery] = copy.diagnostics;

/** Cada captura dentro de su escena: qué página hay detrás, qué URL y qué estado muestra el icono */
const blogUrl = es ? 'nachomascort.com/blog/quality-google-core-updates/' : 'nachomascort.com/en/blog/google-quality-core-updates/';
type Light = 'ok' | 'warn' | 'bad';
type Scene = { url: string; page?: ExtensionShot; kind: 'popup' | 'full' | 'bare' | 'plain'; icon?: [Light, Light]; badge?: string };
const SCENES: Record<ExtensionShot, Scene> = {
  'popup-resumen': { url: blogUrl, page: 'pagina-blog', kind: 'popup' },
  'popup-bots': { url: 'www.elmundo.es', page: 'pagina-elmundo', kind: 'popup' },
  'popup-js': { url: 'www.elmundo.es', page: 'pagina-elmundo', kind: 'popup' },
  'popup-vitals': { url: 'www.elmundo.es', page: 'pagina-elmundo', kind: 'popup' },
  'popup-schema': { url: blogUrl, page: 'pagina-blog', kind: 'popup' },
  'popup-hreflang': { url: blogUrl, page: 'pagina-blog', kind: 'popup' },
  'popup-fanout': { url: 'claude.ai', kind: 'bare' },
  'comparar-vista': { url: es ? 'SEO & GEO Inspector · Comparar renderizado' : 'SEO & GEO Inspector · Compare rendering', kind: 'full' },
  'comparar-codigo': { url: es ? 'SEO & GEO Inspector · Comparar renderizado' : 'SEO & GEO Inspector · Compare rendering', kind: 'full' },
  enlaces: { url: es ? 'SEO & GEO Inspector · Enlaces' : 'SEO & GEO Inspector · Links', kind: 'full' },
  'vitals-pagina': { url: 'www.elmundo.es', kind: 'full' },
  'icono-estados': { url: '', kind: 'plain' },
  'pagina-blog': { url: blogUrl, kind: 'full' },
  'pagina-elmundo': { url: 'www.elmundo.es', kind: 'full' },
};
const slug = (text: string) =>
  text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<Base
  lang={lang}
  title={t.title}
  description={t.description}
  path={paths.landing}
  alternatePath={extensionPaths[es ? 'en' : 'es'].landing}
  breadcrumbs={[
    { name: t.crumbs[0], path: es ? '/' : '/en/' },
    { name: t.crumbs[1], path: toolsPath },
    { name: t.crumbs[2], path: paths.landing },
  ]}
  faq={faq}
  extraSchemaNodes={[softwareApplication]}
>
  <!-- Cabecera: la promesa centrada y, debajo, la extensión funcionando sobre una página real -->
  <div class="ext-hero mx-auto max-w-6xl px-5 pt-14 sm:px-6 sm:pt-20">
    <div class="ext-hero-copy">
      <p class="meta"><a href={toolsPath} class="hover:text-ink">{t.crumbs[1]}</a> · {t.meta}</p>
      <h1 class="ext-title mt-5">SEO &amp; GEO Inspector</h1>
      <p class="lede ext-lede mt-6">{t.lede}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
        {
          EXTENSION_STORE_URL ? (
            <a href={EXTENSION_STORE_URL} class="btn" data-umami-event="extension-install">{t.install}</a>
          ) : (
            <>
              <a href={toolsPath} class="btn">{t.meanwhile}</a>
              <span class="ext-status"><span class="ext-status-dot" aria-hidden="true" />{t.soon}</span>
            </>
          )
        }
      </div>
      <p class="meta mt-6">{t.facts}</p>
    </div>
    <div class="ext-hero-scene">
      <BrowserScene url={blogUrl} page={shot('pagina-blog')} popup={shot('popup-resumen')} alt={copy.heroAlt} eager>
        <figcaption><strong>{indexability.title}.</strong> {indexability.detail[0]}</figcaption>
      </BrowserScene>
    </div>
  </div>

  <!-- Lo que la hace distinta: cada diferencial es una escena a todo el ancho con poco texto encima -->
  <section class="mx-auto max-w-6xl px-5 pt-28 sm:px-6 md:pt-40" aria-labelledby="ext-unique">
    <h2 id="ext-unique" class="display-2 max-w-[20ch]">{t.uniqueTitle}</h2>
    <div class="ext-scenes">
      {
        copy.differentiators.map((block) => {
          const id = `unique-${slug(block.title)}`;
          return (
            <article class="ext-scene-block" aria-labelledby={id}>
              <div class="ext-scene-text">
                <h3 id={id} class="display-3">{block.title}</h3>
                <div class="ext-scene-detail">
                  {block.detail.map((paragraph) => <p set:html={withLinks(paragraph)} />)}
                </div>
              </div>
              <div class:list={['ext-scene-shots', block.shots.length > 1 && 'ext-scene-shots--pair']}>
                {block.shots.map((item) => {
                  const scene = SCENES[item.shot];
                  if (scene.kind === 'plain')
                    return (
                      <figure class="ext-plain">
                        <Image src={shot(item.shot)} alt={item.alt} width={1520} format="webp" />
                        <figcaption>{item.caption}</figcaption>
                      </figure>
                    );
                  return (
                    <BrowserScene
                      url={scene.url}
                      alt={item.alt}
                      page={scene.page ? shot(scene.page) : undefined}
                      popup={scene.kind === 'popup' || scene.kind === 'bare' ? shot(item.shot) : undefined}
                      full={scene.kind === 'full' ? shot(item.shot) : undefined}
                    >
                      <figcaption>{item.caption}</figcaption>
                    </BrowserScene>
                  );
                })}
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- Diagnóstico técnico: galería con pestañas; cada panel es una escena. Sin JavaScript se ven todos seguidos -->
  <section class="ext-tour-band mt-28 md:mt-40" aria-labelledby="ext-diagnostics">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 md:py-28">
      <h2 id="ext-diagnostics" class="display-2 max-w-[20ch]">{t.diagnosticsTitle}</h2>
      <div class="ext-tour mt-10" data-ext-tour>
        <div class="ext-tour-tabs" role="tablist" aria-label={t.diagnosticsTitle} hidden data-ext-tablist>
          {
            gallery.map((block, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${slug(block.title)}`}
                aria-controls={`panel-${slug(block.title)}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? undefined : '-1'}
              >
                {block.title}
              </button>
            ))
          }
        </div>
        {
          gallery.map((block) => (
            <article class="ext-tour-panel" id={`panel-${slug(block.title)}`} role="tabpanel" aria-labelledby={`tab-${slug(block.title)}`} data-ext-panel>
              <div class="ext-tour-text">
                <h3 class="display-3">{block.title}</h3>
                {block.detail.map((paragraph) => <p set:html={withLinks(paragraph)} />)}
              </div>
              <div class="ext-tour-shots">
                {block.shots.map((item) => {
                  const scene = SCENES[item.shot];
                  return (
                    <BrowserScene
                      url={scene.url}
                      alt={item.alt}
                      page={scene.page ? shot(scene.page) : undefined}
                      popup={scene.kind === 'popup' || scene.kind === 'bare' ? shot(item.shot) : undefined}
                      full={scene.kind === 'full' ? shot(item.shot) : undefined}
                    >
                      <figcaption>{item.caption}</figcaption>
                    </BrowserScene>
                  );
                })}
              </div>
            </article>
          ))
        }
      </div>

      <h3 class="display-3 mt-20">{t.basicsTitle}</h3>
      <dl class="ext-basics mt-6">
        {
          copy.basics.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Quién la ha hecho, privacidad y versión -->
  <section class="mx-auto grid max-w-6xl gap-14 px-5 pt-24 sm:px-6 md:pt-28 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]" aria-labelledby="ext-privacy">
    <div>
      <h2 class="display-3">{t.whoLabel}</h2>
      <div class="mt-5">
        <AuthorByline lang={lang} lead={es ? 'Hecha por' : 'Built by'} />
      </div>
      <p class="mt-5 text-[0.98rem] leading-relaxed">{t.who}</p>
      <p class="meta mt-6">
        {t.versionLabel} {extensionVersion.number} · {t.updated} {extensionVersion.updated[lang]}
      </p>
      <ul class="mt-2 text-sm text-muted">
        {copy.changelog.map((entry) => <li>{entry.version}: {entry.notes}</li>)}
      </ul>
    </div>
    <div class="article-body">
      <h2 id="ext-privacy" class="!mt-0">{t.privacyTitle}</h2>
      {t.privacy.map((paragraph) => <p>{paragraph}</p>)}
      <p><a href={paths.privacy}>{t.privacyLink}</a></p>
      <p>
        {t.webTools}{' '}
        <a href={t.webToolsLinks[0][0]}>{t.webToolsLinks[0][1]}</a>, {es ? 'el' : 'the'}{' '}
        <a href={t.webToolsLinks[1][0]}>{t.webToolsLinks[1][1]}</a> {es ? 'y el' : 'and the'}{' '}
        <a href={t.webToolsLinks[2][0]}>{t.webToolsLinks[2][1]}</a>.
      </p>
    </div>
  </section>

  <FaqAccordion lang={lang} faq={faq} />
  <Cta lang={lang} title={t.ctaTitle} />
</Base>

<script>
  // Galería de diagnóstico: pestañas accesibles (flechas, Inicio, Fin). Sin JS, todos los paneles quedan visibles.
  for (const tour of document.querySelectorAll<HTMLElement>('[data-ext-tour]')) {
    const tablist = tour.querySelector<HTMLElement>('[data-ext-tablist]');
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...tour.querySelectorAll<HTMLElement>('[data-ext-panel]')];
    if (!tablist || !tabs.length) continue;
    tablist.hidden = false;
    tour.classList.add('is-tabbed');
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, position) => {
        const active = position === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[position].hidden = !active;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: index === last ? 0 : index + 1, ArrowLeft: index === 0 ? last : index - 1, Home: 0, End: last }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        select(next, true);
      });
    });
    select(0);
  }
</script>

<style>
  /* Cabecera centrada: el título manda y la escena va debajo, más ancha que el texto */
  .ext-hero-copy {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }
  .ext-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
  }
  .ext-lede {
    max-width: 40ch;
    margin-inline: auto;
    text-wrap: pretty;
  }
  .ext-hero-scene {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .ext-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--tone-muted);
  }
  .ext-status-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #e09a00;
    box-shadow: 0 0 0 4px rgb(224 154 0 / 0.18);
  }

  /* Diferenciales: título y texto en dos columnas, escena a todo el ancho debajo */
  .ext-scenes > *,
  .ext-scene-shots > *,
  .ext-tour-panel > * {
    min-width: 0;
  }
  .ext-scenes {
    display: grid;
    gap: clamp(5rem, 10vw, 8.5rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .ext-scene-text {
    display: grid;
    gap: 1rem 4rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .ext-scene-text {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
  .ext-scene-detail p {
    line-height: 1.65;
  }
  .ext-scene-detail p + p {
    margin-top: 0.9rem;
  }
  .ext-scene-detail :global(a),
  .ext-tour-text :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--tone-accent);
    text-underline-offset: 0.2em;
  }
  .ext-scene-shots {
    margin-top: 2.5rem;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .ext-scene-shots--pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .ext-plain {
    margin: 0;
    max-width: 50rem;
  }
  .ext-plain :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid var(--tone-line);
    background: var(--tone-raised);
  }
  .ext-plain figcaption {
    margin-top: 1rem;
