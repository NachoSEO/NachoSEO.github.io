---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';

const services = (await getCollection('services', (entry) => entry.data.lang === 'en')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  lang="en"
  title="Services — Nacho Mascort"
  description="Fractional Head of Growth, AI systems and automation, SEO/GEO consulting and training. Services for companies that want to grow with systems, not smoke."
  path="/en/services/"
  alternatePath="/servicios/"
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'Services', path: '/en/services/' },
  ]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
    <p class="meta">Services</p>
    <h1 class="display-1 mt-5">Growth, AI and SEO services</h1>
    <p class="lede mt-6">SEO and GEO consulting, fractional growth leadership, AI systems and training. In every case you work with me directly, and what we build keeps running after I finish.</p>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        services.map((service) => (
          <a href={`/en/services/${service.data.slug}/`} class="card flex flex-col">
            <h2 class="card-title display-3 transition-colors">{service.data.title}</h2>
            <p class="mt-3 text-[0.95rem]">{service.data.tagline}</p>
            <p class="mt-3 flex-1 text-sm text-muted">{service.data.proof}</p>
            <p class="link-arrow mt-5 text-[0.95rem]">See service</p>
          </a>
        ))
      }
    </div>
  </div>

  <Cta lang="en" />
</Base>
