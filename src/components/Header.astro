---
import { getCollection } from 'astro:content';
import LogoMark from './LogoMark.astro';
import { localizedRoute, otherLang, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** URL de la versión traducida exacta; si no existe, la home del otro idioma */
  alternatePath?: string;
}

const { lang, alternatePath } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const switchUrl = alternatePath ?? localizedRoute('home', other);
const currentPath = Astro.url.pathname;

const navLabel = lang === 'es' ? 'Principal' : 'Main';

type NavLink = { href: string; label: string; event?: string; muted?: boolean };
type NavItem = NavLink & { children?: NavLink[] };

const services = (await getCollection('services', (entry) => entry.data.lang === lang && entry.data.order <= 6)).sort(
  (a, b) => a.data.order - b.data.order,
);
const servicesBase = localizedRoute('services', lang);
const courseLink: NavLink = {
  href: 'https://nachomascort.gumroad.com/l/programacion-seo',
  label: t('nav.course'),
  event: 'course-click',
};

const nav: NavItem[] = [
  {
    href: servicesBase,
    label: t('nav.services'),
    children: [
      ...services.map((service) => ({ href: `${servicesBase}${service.data.slug}/`, label: service.data.title })),
      { href: lang === 'es' ? '/servicios/precios/' : '/en/services/pricing/', label: lang === 'es' ? 'Cuánto cuesta' : 'Pricing', muted: true },
      { href: servicesBase, label: lang === 'es' ? 'Todos los servicios' : 'All services', muted: true },
    ],
  },
  { href: localizedRoute('cases', lang), label: t('nav.cases') },
  {
    href: localizedRoute('blog', lang),
    label: t('nav.blog'),
    children: [
      { href: localizedRoute('blog', lang), label: lang === 'es' ? 'Todo el blog' : 'All posts' },
      ...(lang === 'es' ? [{ href: '/blog/seo-hacks/', label: 'SEO Hacks (archivo)', muted: true }] : []),
    ],
  },
  ...(lang === 'es' ? [{ href: '/estudios/', label: 'Estudios' }] : []),
  {
    href: localizedRoute('tools', lang),
    label: lang === 'es' ? 'Recursos' : 'Resources',
    children: [
      { href: localizedRoute('tools', lang), label: t('nav.tools') },
      { href: localizedRoute('skills', lang), label: t('nav.skills') },
      courseLink,
    ],
  },
  { href: localizedRoute('about', lang), label: t('nav.about') },
];

const isCurrent = (item: NavItem) =>
  item.children
    ? item.children.some((child) => !child.href.startsWith('http') && currentPath.startsWith(child.href))
    : currentPath.startsWith(item.href);
---

<header class="on-dark sticky top-0 z-50">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-x-8 px-5 py-4 sm:px-6">
    <a href={localizedRoute('home', lang)} class="logo-link flex items-center gap-3 leading-tight" aria-label="Nacho Mascort">
      <LogoMark class="h-10 w-10 shrink-0" />
      <span>
        <span class="block font-mono text-[1.15rem] font-bold tracking-[-0.03em]">nacho<span class="accent">mascort</span></span>
        <span class="mt-0.5 block text-[0.6rem] font-semibold uppercase tracking-[0.12em] text-on-dark-muted">
          {t('site.tagline')}
        </span>
      </span>
    </a>

    <nav aria-label={navLabel} class="ml-auto hidden md:block">
      <ul class="flex items-center gap-6 text-[0.9rem]">
        {
          nav.map((item) => (
            <li class:list={['relative', item.children && 'nav-drop']}>
              {item.children ? (
                <>
                  <button
                    type="button"
                    aria-expanded="false"
                    data-drop-toggle
                    class:list={[
                      'nav-drop-toggle flex items-center gap-1 whitespace-nowrap hover:text-on-dark',
                      isCurrent(item) ? 'text-on-dark underline decoration-accent-on-dark underline-offset-[0.4em]' : 'text-on-dark-muted',
                    ]}
                  >
                    {item.label}
                    <span aria-hidden="true" class="nav-caret" />
                  </button>
                  <ul class="nav-drop-panel">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          data-umami-event={child.event}
                          data-umami-event-placement={child.event ? 'header' : undefined}
                          aria-current={currentPath === child.href ? 'page' : undefined}
                          class:list={['nav-drop-link', child.muted && 'is-muted']}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={item.href}
                  aria-current={isCurrent(item) ? 'page' : undefined}
                  class:list={[
                    'whitespace-nowrap hover:text-on-dark',
                    isCurrent(item) ? 'text-on-dark underline decoration-accent-on-dark underline-offset-[0.4em]' : 'text-on-dark-muted',
                  ]}
                >
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-4 md:gap-5">
      <a href={switchUrl} hreflang={other} lang={other} aria-label={t('a11y.switchLang')} class="meta hover:text-on-dark">
        {other}
      </a>
      <a href={localizedRoute('contact', lang)} class="btn btn--small hidden md:inline-flex">
        {t('cta.book')}
      </a>
      <button
        type="button"
        class="menu-toggle -mr-2 flex h-11 w-11 items-center justify-center rounded-full md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">{t('a11y.menu')}</span>
        <span class="menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu max-h-[calc(100dvh-4.75rem)] overflow-y-auto border-t border-white/15 md:hidden">
    <nav aria-label={navLabel} class="mx-auto max-w-5xl px-5 pb-6 pt-2">
      <ul>
        {
          nav.map((item) => (
            <li class="border-b border-white/10">
              <a
                href={item.href}
                aria-current={isCurrent(item) ? 'page' : undefined}
                class:list={[
                  'font-display flex items-center justify-between py-4 text-2xl',
                  isCurrent(item) ? 'text-accent-on-dark' : 'text-on-dark',
                ]}
              >
                {item.label}
                <span aria-hidden="true" class="text-base text-on-dark-muted">→</span>
              </a>
              {item.children && (
                <ul class="-mt-1 grid gap-1 pb-4 pl-4">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        data-umami-event={child.event}
                        data-umami-event-placement={child.event ? 'mobile-menu' : undefined}
                        aria-current={currentPath === child.href ? 'page' : undefined}
                        class="block py-1.5 text-[1.05rem] text-on-dark-muted hover:text-on-dark"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <a href={localizedRoute('contact', lang)} class="btn mt-6 w-full justify-center">
        {t('cta.book')}
      </a>
    </nav>
  </div>
</header>

<style is:global>
  /* La cabecera es sticky: los saltos a anclas (#seccion) no deben quedar tapados por ella */
  html {
    scroll-padding-top: 5rem;
  }
</style>
