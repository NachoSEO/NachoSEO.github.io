---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';

const levels = [
  {
    code: 'L1',
    name: 'Manual',
    to: '25%',
    detail: es
      ? 'Todo lo hace una persona. Informes, contenido y datos, a mano.'
      : 'A person does everything. Reports, content and data, by hand.',
    marker: true,
  },
  {
    code: 'L2',
    name: es ? 'Asistido' : 'Assisted',
    to: '50%',
    detail: es
      ? 'ChatGPT abierto en una pestaña. Ayuda, pero nada corre solo.'
      : 'ChatGPT open in a tab. It helps, but nothing runs on its own.',
    marker: true,
  },
  {
    code: 'L3',
    name: es ? 'Orquestado' : 'Orchestrated',
    to: '75%',
    detail: es
      ? 'Procesos completos automatizados con supervisión humana en lo crítico.'
      : 'Complete processes automated, with human oversight on what matters.',
  },
  {
    code: 'L4',
    name: es ? 'Autónomo' : 'Autonomous',
    to: '100%',
    detail: es
      ? 'Sistemas que operan canales enteros y reportan resultados. Aquí te llevo.'
      : 'Systems operating entire channels and reporting results. This is where I take you.',
    accent: true,
  },
];
---

<section class="mx-auto max-w-5xl px-6 pt-24">
  <div class="reveal">
    <p class="eyebrow">{es ? 'madurez de ia' : 'ai maturity'}</p>
    <h2 class="font-display mt-4 text-3xl font-bold tracking-tight">
      {es ? '¿En qué nivel está tu operación?' : 'What level is your operation at?'}
    </h2>
  </div>

  <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      levels.map((level, index) => (
        <li
          class:list={[
            'reveal rounded-2xl border p-6',
            level.accent ? 'border-accent bg-raised shadow-[0_0_24px_-8px_var(--tone-accent)]' : 'border-line',
          ]}
          style={`--reveal-delay: ${index * 120}ms`}
        >
          <p class="flex items-baseline justify-between">
            <span class:list={['font-mono text-xs', level.accent ? 'text-accent' : 'text-muted']}>
              {level.code}
            </span>
            {level.marker && (
              <span class="font-mono text-[10px] text-muted">
                {es ? '¿estás aquí?' : 'you here?'}
              </span>
            )}
          </p>
          <h3 class="font-display mt-2 text-lg font-bold">{level.name}</h3>
          <div class="meter mt-3" style={`--to: ${level.to}; --d: ${index * 150}ms`} aria-hidden="true">
            <span />
          </div>
          <p class="mt-3 text-sm text-muted">{level.detail}</p>
        </li>
      ))
    }
  </ol>
</section>
