---
/**
 * Escena de producto: una ventana de navegador dibujada en CSS con una página real dentro, el icono de la
 * extensión en la barra (dos mitades: indexación y rastreo) y el popup abierto encima, como al navegar.
 * Sin página de fondo (`page` vacío), el popup se presenta solo dentro de la ventana.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type Light = 'ok' | 'warn' | 'bad';

interface Props {
  /** Texto de la barra de direcciones */
  url: string;
  page?: ImageMetadata;
  popup?: ImageMetadata;
  /** Captura ancha que ocupa toda la ventana (comparativa, tabla de enlaces) */
  full?: ImageMetadata;
  alt: string;
  icon?: [Light, Light];
  badge?: string;
  /** La escena de cabecera carga sin espera */
  eager?: boolean;
}

const { url, page, popup, full, alt, icon = ['ok', 'ok'], badge, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<figure class="scene" aria-label={alt}>
  <div class="scene-window">
    <div class="scene-bar" aria-hidden="true">
      <span class="scene-dots"><i></i><i></i><i></i></span>
      <span class="scene-url">{url}</span>
      <span class="scene-icon" data-left={icon[0]} data-right={icon[1]}>
        <span></span><span></span>
        {badge && <b>{badge}</b>}
      </span>
    </div>
    <div class:list={['scene-view', full && 'scene-view--full', !page && !full && 'scene-view--bare']}>
      {full && <Image src={full} alt={alt} width={1600} format="webp" loading={loading} fetchpriority={eager ? 'high' : undefined} />}
      {page && <Image class="scene-page" src={page} alt="" width={1600} format="webp" loading={loading} />}
      {
        popup && (
          <div class="scene-popup">
            <Image src={popup} alt={alt} width={1100} format="webp" loading={loading} fetchpriority={eager ? 'high' : undefined} />
          </div>
        )
      }
    </div>
  </div>
  <slot />
</figure>

<style>
  .scene {
    margin: 0;
    min-width: 0;
  }
  .scene-window {
    border-radius: 1rem;
    overflow: hidden;
    background: var(--tone-raised);
    border: 1px solid rgb(20 51 63 / 0.14);
    box-shadow:
      0 40px 80px -40px rgb(20 51 63 / 0.55),
      0 12px 24px -16px rgb(20 51 63 / 0.25);
  }
  /* Barra del navegador: puntos, dirección e icono de la extensión */
  .scene-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.9rem;
    background: #e9eded;
    border-bottom: 1px solid rgb(20 51 63 / 0.1);
  }
  .scene-dots {
    display: flex;
    gap: 0.4rem;
  }
  .scene-dots i {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: #c9d0d2;
  }
  .scene-url {
    flex: 1;
    min-width: 0;
    padding: 0.32rem 0.8rem;
    border-radius: 999px;
    background: var(--tone-raised);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    color: var(--tone-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .scene-icon {
    position: relative;
    display: flex;
    gap: 2px;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 0.3rem;
    overflow: visible;
    flex: none;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.9);
  }
  .scene-icon > span {
    flex: 1;
    background: #1e9e5a;
  }
  .scene-icon > span:first-child {
    border-radius: 0.3rem 0 0 0.3rem;
  }
  .scene-icon > span:nth-child(2) {
    border-radius: 0 0.3rem 0.3rem 0;
  }
  .scene-icon[data-left='warn'] > span:first-child,
  .scene-icon[data-right='warn'] > span:nth-child(2) {
    background: #e09a00;
  }
  .scene-icon[data-left='bad'] > span:first-child,
  .scene-icon[data-right='bad'] > span:nth-child(2) {
    background: #d61f4f;
  }
  .scene-icon b {
    position: absolute;
    right: -0.7rem;
    bottom: -0.5rem;
    padding: 0 0.25rem;
    border-radius: 0.25rem;
    background: var(--tone-ink);
    color: #fff;
    font-size: 0.6rem;
    line-height: 1.35;
  }
  /* Vista: la página de fondo y el popup anclado bajo el icono */
  .scene-view {
    position: relative;
    aspect-ratio: 16 / 9.5;
    overflow: hidden;
    background: #fff;
  }
  .scene-view--full,
  .scene-view--bare {
    aspect-ratio: auto;
  }
  .scene-view--bare {
    padding: clamp(1.25rem, 4vw, 3rem);
    background: linear-gradient(160deg, #eef2f2, #e2e9ea);
    display: grid;
    place-items: center;
  }
  .scene-view :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .scene-view :global(.scene-page) {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* La página se apaga un poco para que el popup mande */
  .scene-view:not(.scene-view--bare):not(.scene-view--full)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(20 51 63 / 0.14);
    pointer-events: none;
  }
  .scene-popup {
    position: absolute;
    z-index: 1;
    top: 0.4rem;
    right: clamp(0.6rem, 2.5%, 1.6rem);
    width: min(50%, 36rem);
    border-radius: 0.7rem;
    overflow: hidden;
    border: 1px solid rgb(20 51 63 / 0.18);
    box-shadow:
      0 30px 60px -24px rgb(20 51 63 / 0.6),
      0 8px 18px -10px rgb(20 51 63 / 0.35);
  }
  .scene-view--bare .scene-popup {
    position: static;
    width: min(100%, 36rem);
  }
  /* En móvil el popup no cabe encima: va debajo de la página, a todo el ancho */
  @media (max-width: 640px) {
    .scene-view:not(.scene-view--bare):not(.scene-view--full) {
      aspect-ratio: auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }
    .scene-view :global(.scene-page) {
      height: 9rem;
    }
    .scene-popup {
      position: relative;
      top: auto;
      right: auto;
      width: auto;
      margin: -2.5rem 0.6rem 0.6rem;
    }
  }
  .scene :global(figcaption) {
    margin-top: 1rem;
    max-width: 62ch;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--tone-muted);
  }
</style>
