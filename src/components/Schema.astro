---
/**
 * Emite un único bloque JSON-LD con @graph por página.
 * WebSite + Person van siempre (consistencia de entidad para GEO/AEO);
 * el resto de nodos se añaden vía props según el tipo de página.
 */
import type { Lang } from '../i18n/ui';

interface Breadcrumb {
  name: string;
  path: string;
}

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  lang: Lang;
  breadcrumbs?: Breadcrumb[];
  faq?: Faq[];
  /** Nodos extra ya construidos (Article, Service…) que se anexan al @graph */
  extraNodes?: Record<string, unknown>[];
}

const { lang, breadcrumbs, faq, extraNodes = [] } = Astro.props;
const site = Astro.site!.origin;

const personId = `${site}/#person`;
const websiteId = `${site}/#website`;
const gradualId = 'https://gradual.pro/#organization';

const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Nacho Mascort',
  url: `${site}/`,
  image: `${site}/img/nacho.jpg`,
  jobTitle:
    lang === 'es'
      ? ['Consultor de SEO, GEO e IA', 'Head of AI y Head of Organic Marketing en Reverse Tech']
      : ['SEO, GEO & AI consultant', 'Head of AI and Head of Organic Marketing at Reverse Tech'],
  worksFor: [{ '@type': 'Organization', name: 'Reverse Tech' }, { '@id': gradualId }],
  description:
    lang === 'es'
      ? 'Consultor de SEO, GEO e IA en Barcelona. Ex ingenieros de Google Search le contrataron para dirigir su SEO en Cliqpod y Reverse Tech. Ha dirigido el SEO de Softonic (más de 1.000 millones de usuarios al año), Grupo Planeta y word.tips, y montó desde cero el área orgánica de Reverse Tech hasta más de 2 M$ de margen.'
      : 'SEO, GEO and AI consultant based in Barcelona. Former Google Search engineers hired him to run their SEO at Cliqpod and Reverse Tech. He led SEO at Softonic (1B+ users a year), Grupo Planeta and word.tips, and built Reverse Tech\'s organic area from scratch to over $2M in margin.',
  knowsAbout: [
    'SEO',
    'Generative Engine Optimization (GEO)',
    'Answer Engine Optimization (AEO)',
    'Growth marketing',
    'AI agents',
    'Marketing automation',
    'CRM',
    'Affiliate marketing',
    'YouTube growth',
    'Team management',
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
  sameAs: [
    'https://www.linkedin.com/in/nachomascort',
    'https://twitter.com/NachoMascort',
    'https://github.com/NachoSEO',
    'https://speakerdeck.com/nachomascort',
    'https://www.slideshare.net/NachoMascortSEOSpeci',
    'https://nachomascort.gumroad.com',
  ],
};

/** Gradual, la agencia de IA de Nacho */
const gradual = {
  '@type': 'Organization',
  '@id': gradualId,
  name: 'Gradual',
  url: 'https://gradual.pro',
  founder: { '@id': personId },
};

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: `${site}/`,
  name: 'Nacho Mascort',
  inLanguage: lang === 'es' ? 'es-ES' : 'en',
  publisher: { '@id': personId },
};

const graph: Record<string, unknown>[] = [website, person, gradual];

if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.path, site).href,
    })),
  });
}

if (faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}

graph.push(...extraNodes);

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<script type="application/ld+json" set:html={jsonLd} />
