---
/** Icono de línea por servicio (clave = translationKey). Trazo con currentColor dentro de un cuadrado petróleo. */
interface Props {
  slug: string;
}

const { slug } = Astro.props;

const paths: Record<string, string> = {
  // SEO técnico: corchetes de código
  'seo-geo': 'M9 7 4 12l5 5M15 7l5 5-5 5M13 5l-2 14',
  // Auditoría: lupa con check
  'seo-audit': 'M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13ZM20 20l-4.6-4.6M7.8 10.6l1.9 1.9 3.5-3.6',
  // Migraciones: dos flechas que cambian de lado
  'seo-migrations': 'M4 8h13M13 4l4 4-4 4M20 16H7M11 12l-4 4 4 4',
  // Internacional: globo
  'international-seo': 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3.5 9h17M3.5 15h17M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9M12 3C9.5 5.6 8.3 8.6 8.3 12s1.2 6.4 3.7 9',
  // Recuperar tráfico: línea que cae y vuelve a subir
  'traffic-recovery': 'M3 6l5 7 4-3 4 5 5-8M17 7h4v4',
  // GEO: burbuja de respuesta con destello
  geo: 'M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-4 3v-3H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2ZM12 8l.9 2.1L15 11l-2.1.9L12 14l-.9-2.1L9 11l2.1-.9L12 8Z',
};

const d = paths[slug] ?? 'M5 12h14M12 5v14';
---

<span class="service-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d={d}></path>
  </svg>
</span>

<style>
  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.6rem;
    background: var(--tone-dark);
    color: var(--tone-accent-on-dark);
  }
  .service-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
