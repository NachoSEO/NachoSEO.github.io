---
/** Lista de comprobación marcable con contador. Sin JS se lee como una lista normal. */
interface Props {
  title: string;
  items: string[];
}
const { title, items } = Astro.props;
---

<figure class="checklist not-prose" data-checklist>
  <div class="checklist-head">
    <p class="checklist-title">{title}</p>
    <p class="checklist-count"><span data-done>0</span> de {items.length}</p>
  </div>
  <div class="checklist-bar" aria-hidden="true"><span data-bar></span></div>
  <ul>
    {
      items.map((item) => (
        <li>
          <label>
            <input type="checkbox" />
            <span set:html={item} />
          </label>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  figure.checklist p {
    margin-top: 0;
  }
  figure.checklist ul {
    list-style: none;
    padding-left: 0;
  }
  figure.checklist li + li {
    margin-top: 0;
  }
  .checklist {
    margin-block: 1.5rem 2rem;
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-accent);
    border-radius: 0.875rem;
    background: var(--color-raised);
    padding: 1rem 1.1rem 0.9rem;
  }
  .checklist-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .checklist-title {
    font-weight: 600;
  }
  .checklist-count {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .checklist-bar {
    height: 4px;
    margin-top: 0.6rem;
    border-radius: 999px;
    background: var(--color-line);
    overflow: hidden;
  }
  .checklist-bar span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-accent);
    transition: width 0.3s ease;
  }
  .checklist ul {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.6rem;
  }
  .checklist label {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 0.35rem 0.25rem;
    border-radius: 0.4rem;
    cursor: pointer;
    font-size: 0.95rem;
  }
  .checklist label:hover {
    background: var(--color-paper);
  }
  .checklist input {
    flex-shrink: 0;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.2rem;
    accent-color: var(--color-accent);
  }
  .checklist input:checked + span {
    color: var(--color-muted);
    text-decoration: line-through;
    text-decoration-color: var(--color-line);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-checklist]')) {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const update = () => {
      const done = boxes.filter((box) => box.checked).length;
      root.querySelector('[data-done]')!.textContent = String(done);
      root.querySelector<HTMLElement>('[data-bar]')!.style.width = `${(done / boxes.length) * 100}%`;
    };
    boxes.forEach((box) => box.addEventListener('change', update));
  }
</script>
