---
import Base from '../../layouts/Base.astro';
import { site } from '../../site';
import { localizedRoute, useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<Base
  lang="en"
  title="Contact — Nacho Mascort"
  description="Book a 30-minute call with Nacho Mascort to talk growth, AI or SEO. No strings attached: I'll tell you honestly whether I can help."
  path="/en/contact/"
  alternatePath="/contacto/"
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'Contact', path: '/en/contact/' },
  ]}
>
  <div class="mx-auto max-w-5xl px-5 sm:px-6 pt-16">
    <p class="meta">Contact</p>
    <h1 class="display-1 mt-5">
      Let's talk about your case
    </h1>
    <p class="lede mt-6">
      Book a 30-minute call. Tell me where you are and what you want to achieve, and I'll tell you
      honestly whether I can help and where I'd start.
    </p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a
        href={site.calUrl}
        data-umami-event="call-booking-click"
        data-umami-event-placement="contact-page"
        class="btn"
      >
        {t('cta.call30')}
      </a>
      <a href={localizedRoute('quote', 'en')} data-umami-event="quote-click" data-umami-event-placement="contact-page" class="btn btn--ghost">
        Get a quote
      </a>
    </div>

    <section class="mt-16 max-w-[62ch] border-t border-ink pt-6">
      <h2 class="display-3">What to expect from the call</h2>
      <ul class="row-list mt-5 max-w-[62ch]">
        <li class="py-3">30 minutes, no sales script.</li>
        <li class="py-3">If I'm not the right person, I'll say so — and refer you to someone who is, if I can.</li>
        <li class="py-3">You'll leave with at least one actionable idea, whether we work together or not.</li>
      </ul>
    </section>

    <section class="mt-14 max-w-[62ch] border-t border-ink pt-6">
      <h2 class="display-3">Other ways</h2>
      <p class="mt-4 text-muted">
        Email: <a href={`mailto:${site.email}`} data-umami-event="email-click" data-umami-event-placement="contact-page" class="underline decoration-accent underline-offset-4 hover:text-accent-ink">{site.email}</a
        ><br />
        LinkedIn: <a href={site.social.linkedin} class="underline decoration-accent underline-offset-4 hover:text-accent-ink"
          >linkedin.com/in/nachomascort</a
        >
      </p>
    </section>
  </div>
</Base>
