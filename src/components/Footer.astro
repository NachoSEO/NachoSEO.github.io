---
import { localizedRoute, useTranslations } from '../i18n/utils';
import { site } from '../site';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const links = [
  { href: site.social.linkedin, label: 'LinkedIn', rel: 'me' },
  { href: site.social.twitter, label: 'Twitter/X', rel: 'me' },
  { href: site.social.github, label: 'GitHub', rel: 'me' },
  { href: localizedRoute('rss', lang), label: 'RSS', rel: undefined },
];
---

<footer class="on-dark mt-20 md:mt-28">
  <div class="mx-auto grid max-w-5xl gap-8 px-5 py-10 sm:grid-cols-3 sm:px-6">
    <div>
      <p class="font-display text-lg font-semibold">Nacho Mascort</p>
      <p class="mt-1 text-sm text-on-dark-muted">{t('footer.role')}</p>
      <p class="text-sm text-on-dark-muted">{t('footer.location')}</p>
    </div>

    <ul class="space-y-1 text-sm">
      {
        links.map((link) => (
          <li>
            <a href={link.href} rel={link.rel} class="text-on-dark-muted hover:text-on-dark">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="text-sm sm:text-right">
      <a href={`mailto:${site.email}`} class="underline decoration-accent-on-dark underline-offset-4 hover:text-accent-on-dark">
        {site.email}
      </a>
      <p class="meta mt-4">
        © {year} · <a href={localizedRoute('contact', lang)} class="hover:text-on-dark">{t('nav.contact')}</a>
        · <a href={localizedRoute('tools', lang)} class="hover:text-on-dark">{t('nav.tools')}</a>
      </p>
    </div>
  </div>
</footer>
