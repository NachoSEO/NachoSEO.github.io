---
/** Páginas de destino del formulario de contacto (functions/api/contact.ts) */
import Base from '../layouts/Base.astro';
import { localizedRoute } from '../i18n/utils';
import { site } from '../site';

interface Props {
  lang: 'es' | 'en';
  variant: 'ok' | 'error';
  path: string;
}

const { lang, variant, path } = Astro.props;
const linkClass = 'underline decoration-accent underline-offset-4 hover:text-accent-ink';

const copy = {
  es: {
    ok: {
      eyebrow: 'Mensaje enviado',
      title: 'Gracias, te respondo pronto',
      body: 'Me ha llegado tu mensaje y te contestaré personalmente al email que me has dejado.',
    },
    error: {
      eyebrow: 'Algo ha fallado',
      title: 'No he podido enviar tu mensaje',
      body: 'Vuelve atrás e inténtalo de nuevo. Si sigue fallando, escríbeme directamente a',
    },
    back: 'Volver al inicio',
  },
  en: {
    ok: {
      eyebrow: 'Message sent',
      title: "Thanks, I'll get back to you soon",
      body: "Your message reached me and I'll reply personally to the email you left.",
    },
    error: {
      eyebrow: 'Something went wrong',
      title: "I couldn't send your message",
      body: 'Go back and try again. If it keeps failing, email me directly at',
    },
    back: 'Back to home',
  },
}[lang];

const text = copy[variant];
---

<Base lang={lang} title={`${text.title} — Nacho Mascort`} description={text.title} path={path} noindex>
  <div class="mx-auto max-w-5xl px-5 py-16 sm:px-6 md:py-24">
    <p class="meta">{text.eyebrow}</p>
    <h1 class="display-1 mt-5">{text.title}</h1>
    <p class="mt-5 max-w-[60ch] text-muted">
      {text.body}
      {variant === 'error' && <a href={`mailto:${site.email}`} class={linkClass}>{site.email}</a>}
      {variant === 'error' && '.'}
    </p>
    <p class="mt-8"><a href={localizedRoute('home', lang)} class={linkClass}>{copy.back}</a></p>
  </div>
</Base>
