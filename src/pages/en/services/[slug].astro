---
import { translatedPaths } from '../../../lib/translations';
import Service from '../../../layouts/Service.astro';

export function getStaticPaths() {
  return translatedPaths('services', 'en');
}

const { entry, translationSlug } = Astro.props;
const path = `/en/services/${entry.data.slug}/`;
const alternatePath = translationSlug ? `/servicios/${translationSlug}/` : undefined;
---

<Service entry={entry} path={path} alternatePath={alternatePath} />
