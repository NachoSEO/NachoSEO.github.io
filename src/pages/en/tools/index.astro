---
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';

const tools = [
  {
    href: '/en/tools/organic-session-value-calculator/',
    title: 'Organic session value calculator',
    tagline: 'What each Google visit is worth for your business model: sales, leads or advertising.',
    detail: 'Value per session, per month, per year and per 1,000 extra clicks. Prioritize page types with numbers.',
  },
  {
    href: '/en/tools/sitemap-generator/',
    title: 'XML Sitemap Generator',
    tagline: 'Turn a list of URLs or a CSV into a sitemap.xml ready for Search Console.',
    detail: 'Automatic indexes past 50,000 URLs, one sitemap per domain, and everything runs in your browser.',
  },
  {
    href: '/en/tools/bot-access-checker/',
    title: 'Bot access checker',
    tagline: 'See whether Googlebot and the ChatGPT, Claude or Perplexity bots can reach your site.',
    detail: 'robots.txt, HTTP response, firewall blocks, noindex and sitemap for 15 bots in one pass.',
  },
];
---

<Base
  lang="en"
  title="Free SEO Tools — Nacho Mascort"
  description="Free SEO tools: organic session value calculator, XML sitemap generator and a search and AI bot access checker. No sign-up."
  path="/en/tools/"
  alternatePath="/herramientas/"
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'Tools', path: '/en/tools/' },
  ]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
    <p class="meta">Tools</p>
    <h1 class="display-1 mt-5">Free SEO tools</h1>
    <p class="lede mt-6">
      Technical SEO tools I've been building. They're free, there's no sign-up and I don't store anything you check.
    </p>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        tools.map((tool) => (
          <a href={tool.href} class="card flex flex-col">
            <h2 class="card-title display-3 transition-colors">{tool.title}</h2>
            <p class="mt-3 text-[0.95rem]">{tool.tagline}</p>
            <p class="mt-3 flex-1 text-sm text-muted">{tool.detail}</p>
            <p class="link-arrow mt-5 text-[0.95rem]">Open tool</p>
          </a>
        ))
      }
    </div>
  </div>

  <Cta lang="en" />
</Base>
