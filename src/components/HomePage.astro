---
import { getCollection } from 'astro:content';
import ClientLogos from './ClientLogos.astro';
import CasesBand from './CasesBand.astro';
import CourseBand from './CourseBand.astro';
import Cta from './Cta.astro';
import Portrait from './Portrait.astro';
import PostDate from './PostDate.astro';
import RecognitionLogos from './RecognitionLogos.astro';
import SectionLabel from './SectionLabel.astro';
import ServiceIcon from './ServiceIcon.astro';
import { localizedRoute, useTranslations } from '../i18n/utils';
import { site } from '../site';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const allServices = (await getCollection('services', (entry) => entry.data.lang === lang)).sort(byOrder);
// La home enseña solo los servicios de SEO técnico y GEO (order < 7); growth, IA y formación van en la página de servicios
const services = allServices.filter((service) => service.data.order < 7);

// Si aún no hay artículos en el idioma de la página, se muestran los del otro idioma.
// El archivo de SEO Hacks (2015–2017) no cuenta como "lo último".
const allPosts = (await getCollection('blog', (post) => post.data.category !== 'seohacks' && !post.data.unlisted)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const localPosts = allPosts.filter((post) => post.data.lang === lang);
const posts = (localPosts.length > 0 ? localPosts : allPosts).slice(0, 3);

const servicesBase = localizedRoute('services', lang);

const copy =
  lang === 'es'
    ? {
        title: [
          { text: 'Consultoría de ' },
          { text: 'SEO, IA y growth', accent: true },
          { text: ' que genera ' },
          { text: 'negocio', accent: true },
        ],
        intro:
          'He llevado webs como Softonic o word.tips, con millones de URLs y millones de visitas al día. He montado equipos, he hecho crecer negocios y trabajo con IA desde antes de que existiera ChatGPT.',
        secondary: 'Escríbeme',
        photoAlt: 'Nacho Mascort, consultor de SEO, IA y growth',
        pillarsLabel: 'Por qué yo',
        pillarsTitle: 'Por qué trabajar conmigo y no con una agencia',
        pillars: [
          {
            title: 'Me contrataron ex ingenieros de Google Search',
            body: 'Un equipo que conoce el algoritmo por dentro me eligió para llevar el SEO de su proyecto. Saben que entender Google y convertirlo en negocio son cosas distintas.',
          },
          {
            title: 'He llevado algunas de las webs más visitadas del mundo',
            body: 'Softonic, download.com y CNET, con más de 1.000 millones de usuarios al año, y word.tips, donde dupliqué el tráfico hasta los 2 millones de visitas al día.',
          },
          {
            title: 'He visto muchas webs caer en un core update',
            body: 'Sé qué mirar y qué cambiar, y la mayoría de las que he trabajado han recuperado su tráfico. En Softonic perdimos un 20 y pico por ciento en uno; con el siguiente, el dominio principal ya estaba por encima de su nivel anterior.',
          },
        ],
        servicesLabel: 'Servicios',
        servicesTitle: 'Los problemas en los que te puedo ayudar',
        servicesIntro: 'Trabajas directamente conmigo, sin juniors ni subcontratas. Y si otra opción te conviene más, te lo digo en la primera llamada.',
        otherServices: { text: 'También hago growth, sistemas de IA y formación', href: '/servicios/#otros' },
        pricing: { text: 'Cuánto cuesta y cómo calculo el precio', href: '/servicios/precios/' },
        talksLabel: 'Docencia y charlas',
        talksTitle: 'Más de diez años enseñando lo que hago',
        talks: [
          { what: 'Profesor del Máster en Buscadores', where: 'Universitat Pompeu Fabra', period: '2015 — 2024', url: 'https://web.archive.org/web/20230130085546/https://www.bsm.upf.edu/es/master-universitario-online-en-buscadores' },
          { what: 'Profesor del Máster SEO', where: 'Webpositer Academy', period: '2018 — actualidad', url: 'https://www.webpositeracademy.com/master-seo/' },
          { what: 'Profesor del Máster SEO', where: 'BigSEO Academy', period: 'Actualidad', url: 'https://romualdfons.com/master-seo-posicionamiento-web/' },
          { what: 'Profesor del Máster de SEO Técnico', where: 'Asdrubal SEO', period: 'Actualidad', url: 'https://sanchezdonate.net/master-seo-tecnico/' },
          { what: 'Google Product Expert', where: 'Comunidad de Search Console', period: 'Google' },
          { what: 'Ponente y formador', where: 'DoYouSEO, SEOnTheBeach, Clinic SEO, SEOPLUS, La Vanguardia', period: 'Charlas', url: '/sobre-mi/#charlas' },
        ],
        about: 'Mi trayectoria completa',
        blogLabel: 'Blog',
        blogTitle: 'Lo último que he escrito',
        blogAll: 'Ir al blog',
        ctaTitle: 'Cuéntame tu proyecto',
      }
    : {
        title: [
          { text: 'SEO, AI & growth', accent: true },
          { text: ' consulting that drives ' },
          { text: 'revenue', accent: true },
        ],
        intro:
          "I've run sites like Softonic and word.tips, with millions of URLs and millions of visits a day. I've hired teams, scaled businesses and worked with AI since before ChatGPT existed.",
        secondary: 'Email me',
        photoAlt: 'Nacho Mascort, SEO, AI and growth consultant',
        pillarsLabel: 'Why me',
        pillarsTitle: 'Three reasons to hire me instead of an agency',
        pillars: [
          {
            title: 'Former Google Search engineers hired me',
            body: 'A team that knows the algorithm from the inside chose me to run SEO for their project. They know that understanding Google and turning it into revenue are different things.',
          },
          {
            title: "I've run some of the most visited sites in the world",
            body: 'Softonic, download.com and CNET, with over 1 billion users a year, and word.tips, where I doubled traffic to 2 million visits a day.',
          },
          {
            title: 'I build in-house solutions that cut costs',
            body: 'Instead of paying for expensive tools, I build custom systems. The AI ad factory at Reverse Tech saves around €20,000 a month on external platforms, almost €240,000 a year.',
          },
        ],
        servicesLabel: 'Services',
        servicesTitle: 'The problems I can help with',
        servicesIntro: "You work with me directly, with no juniors or subcontractors. And if another option suits you better, I'll tell you on the first call.",
        otherServices: { text: 'I also do growth, AI systems and training', href: '/en/services/#other' },
        pricing: { text: 'How much it costs and how I price it', href: '/en/services/pricing/' },
        talksLabel: 'Teaching and talks',
        talksTitle: 'Over ten years teaching what I do',
        talks: [
          { what: 'Lecturer, Master in Search Engines', where: 'Universitat Pompeu Fabra', period: '2015 — 2024', url: 'https://web.archive.org/web/20230130085546/https://www.bsm.upf.edu/es/master-universitario-online-en-buscadores' },
          { what: 'Lecturer, SEO Master', where: 'Webpositer Academy', period: '2018 — present', url: 'https://www.webpositeracademy.com/master-seo/' },
          { what: 'Lecturer, SEO Master', where: 'BigSEO Academy', period: 'Present', url: 'https://romualdfons.com/master-seo-posicionamiento-web/' },
          { what: 'Lecturer, Technical SEO Master', where: 'Asdrubal SEO', period: 'Present', url: 'https://sanchezdonate.net/master-seo-tecnico/' },
          { what: 'Google Product Expert', where: 'Search Console community', period: 'Google' },
          { what: 'Speaker and trainer', where: 'DoYouSEO, SEOnTheBeach, Clinic SEO, SEOPLUS, La Vanguardia', period: 'Talks', url: '/en/about/#charlas' },
        ],
        about: 'My full background',
        blogLabel: 'Blog',
        blogTitle: "What I've written lately",
        blogAll: 'Go to the blog',
        ctaTitle: 'Tell me about your project',
      };
---

<section class="on-dark overflow-hidden">
  <div class="mx-auto grid max-w-5xl items-end gap-8 px-5 pt-12 sm:px-6 md:grid-cols-[1.2fr_1fr] md:gap-10 md:pt-16">
    <div class="pb-4 md:pb-20">
      <h1 class="display-1 max-w-[16ch]">
        {copy.title.map((part) => (part.accent ? <span class="accent">{part.text}</span> : part.text))}
      </h1>
      <p class="lede mt-7">{copy.intro}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={site.calUrl} data-umami-event="call-booking-click" data-umami-event-placement="home" class="btn">{t('cta.call30')} →</a>
        <a href={`mailto:${site.email}`} data-umami-event="email-click" data-umami-event-placement="home" class="btn btn--ghost">{copy.secondary}</a>
      </div>
    </div>
    <Portrait alt={copy.photoAlt} class="mx-auto w-full max-w-[20rem] md:max-w-[26rem]" />
  </div>
</section>

<ClientLogos lang={lang} />

<section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
  <SectionLabel label={copy.pillarsLabel} />
  <h2 class="display-2 mt-3 max-w-[24ch]">{copy.pillarsTitle}</h2>
  <div class="mt-10 grid gap-5 md:grid-cols-3">
    {
      copy.pillars.map((pillar) => (
        <div class="card reveal">
          <h3 class="display-3">{pillar.title}</h3>
          <p class="mt-3 text-[0.95rem] text-muted">{pillar.body}</p>
        </div>
      ))
    }
  </div>
</section>

<CasesBand
  lang={lang}
  exclude={['ad-factory']}
  summaries={{
    'organic-growth':
      lang === 'es'
        ? 'Área orgánica montada desde cero y una fábrica de anuncios con IA'
        : 'Organic area built from scratch, plus an AI ad factory',
  }}
/>

<section class="mx-auto max-w-5xl px-5 pb-16 pt-16 md:pb-24 md:pt-24 sm:px-6">
  <SectionLabel label={copy.servicesLabel} />
  <h2 class="display-2 mt-3">{copy.servicesTitle}</h2>
  <p class="mt-4 max-w-[60ch] text-muted">{copy.servicesIntro}</p>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      services.map((service) => (
        <a href={`${servicesBase}${service.data.slug}/`} class="service-tile card reveal group flex flex-col">
          <ServiceIcon slug={service.data.translationKey} />
          <h3 class="card-title mt-4 text-lg font-semibold leading-snug transition-colors">{service.data.title}</h3>
          <p class="mt-2 text-[0.9rem] text-muted">{service.data.tagline}</p>
        </a>
      ))
    }
  </div>
  {
    'pricing' in copy && (
      <p class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-[0.95rem]">
        <a href={copy.pricing.href} class="link-arrow">{copy.pricing.text}</a>
        <a href={copy.otherServices.href} class="link-arrow">{copy.otherServices.text}</a>
      </p>
    )
  }
</section>

<section class="border-b border-line bg-raised">
  <div class="mx-auto grid max-w-5xl gap-12 px-5 py-14 md:py-20 sm:px-6 md:grid-cols-[1fr_1.5fr]">
    <div>
      <SectionLabel label={copy.talksLabel} />
      <h2 class="display-2 mt-3">{copy.talksTitle}</h2>
      <a href={localizedRoute('about', lang)} class="link-arrow mt-8 inline-block text-[0.95rem]">{copy.about}</a>
    </div>
    <ul class="row-list self-start">
      {
        copy.talks.map((talk) => {
          const content = (
            <>
              <div>
                <p class="row-title font-semibold transition-colors">{talk.what}</p>
                <p class="mt-0.5 text-[0.95rem] text-muted">{talk.where}</p>
              </div>
              <p class="meta sm:pt-1 sm:text-right">{talk.period}</p>
            </>
          );
          const rowClass = 'grid gap-1 py-5 sm:grid-cols-[1fr_auto] sm:gap-6';
          return (
            <li>
              {'url' in talk && talk.url ? (
                <a href={talk.url} class:list={['row-link group sm:px-2', rowClass]}>
                  {content}
                </a>
              ) : (
                <div class:list={[rowClass, 'sm:px-2']}>{content}</div>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<RecognitionLogos lang={lang} />

<div class="border-b border-line bg-raised pb-16 md:pb-24">
  <CourseBand lang={lang} />
</div>

{
  posts.length > 0 && (
    <section class="border-b border-line">
      <div class="mx-auto max-w-5xl px-5 py-16 md:py-24 sm:px-6">
      <SectionLabel label={copy.blogLabel} />
      <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
        <h2 class="display-2">{copy.blogTitle}</h2>
        <a href={localizedRoute('blog', lang)} class="link-arrow text-[0.95rem]">{copy.blogAll}</a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`${localizedRoute('blog', post.data.lang)}${post.data.slug}/`}
            hreflang={post.data.lang !== lang ? post.data.lang : undefined}
            class="card reveal flex flex-col"
          >
            <p class="meta">
              <PostDate date={post.data.pubDate} lang={lang} month="short" />
              {post.data.lang !== lang && <span> · {post.data.lang.toUpperCase()}</span>}
            </p>
            <h3 class="card-title mt-3 flex-1 text-lg font-semibold leading-snug transition-colors">{post.data.title}</h3>
          </a>
        ))}
      </div>
      </div>
    </section>
  )
}

<div class="-mb-20 bg-raised pb-16 md:-mb-28 md:pb-20">
  <Cta lang={lang} title={copy.ctaTitle} />
</div>
