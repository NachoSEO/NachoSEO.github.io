---
/**
 * Bloque de contacto al final de las páginas: formulario (POST nativo a functions/api/contact.ts,
 * con Turnstile) y, como alternativa, llamada de 30 minutos o email.
 */
import { site } from '../site';
import { localizedRoute, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Turnstile from './Turnstile.astro';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang, title } = Astro.props;
const t = useTranslations(lang);

const copy =
  lang === 'es'
    ? {
        label: 'Hablemos',
        heading: title ?? 'Cuéntame tu proyecto',
        body: 'Escríbeme qué quieres conseguir y en qué punto estás. Te respondo personalmente y con franqueza si puedo ayudarte.',
        name: 'Nombre',
        email: 'Email',
        message: '¿En qué te puedo ayudar?',
        messagePlaceholder: 'Qué quieres conseguir, qué has probado, plazos…',
        submit: 'Enviar mensaje',
        privacy: 'Uso tus datos solo para responderte.',
        privacyLink: 'Política de privacidad',
        or: '¿Prefieres hablar?',
        alt: 'O escríbeme a',
      }
    : {
        label: "Let's talk",
        heading: title ?? 'Tell me about your project',
        body: "Tell me what you want to achieve and where you are now. I'll reply personally and tell you honestly whether I can help.",
        name: 'Name',
        email: 'Email',
        message: 'How can I help?',
        messagePlaceholder: 'What you want to achieve, what you have tried, timelines…',
        submit: 'Send message',
        privacy: 'I only use your data to reply to you.',
        privacyLink: 'Privacy policy',
        or: 'Prefer to talk?',
        alt: 'Or email me at',
      };

const page = Astro.url.pathname;
const idPrefix = `contact-${lang}`;
---

<section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
  <div class="on-dark reveal contact-grid rounded-2xl px-6 py-9 sm:px-10 sm:py-10">
    <div class="contact-intro">
      <p class="section-label">{copy.label}</p>
      <h2 class="display-2 mt-3 max-w-[18ch]">{copy.heading}</h2>
      <p class="mt-3 text-on-dark-muted">{copy.body}</p>
      <p class="mt-5 text-sm text-on-dark-muted">
        {copy.or} <a href={site.calUrl} data-umami-event="call-booking-click" data-umami-event-placement="contact" class="contact-link">{t('cta.call30')}</a><br />
        {copy.alt} <a href={`mailto:${site.email}`} data-umami-event="email-click" data-umami-event-placement="contact" class="contact-link">{site.email}</a>
      </p>
    </div>

    <form action="/api/contact" method="post" class="contact-form">
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="page" value={page} />
      <div class="contact-honeypot" aria-hidden="true">
        <label for={`${idPrefix}-company`}>Company</label>
        <input type="text" id={`${idPrefix}-company`} name="company" tabindex="-1" autocomplete="off" />
      </div>

      <div class="contact-row">
        <div class="contact-field">
          <label for={`${idPrefix}-name`}>{copy.name}</label>
          <input type="text" id={`${idPrefix}-name`} name="name" required maxlength="100" autocomplete="name" />
        </div>
        <div class="contact-field">
          <label for={`${idPrefix}-email`}>{copy.email}</label>
          <input type="email" id={`${idPrefix}-email`} name="email" required maxlength="254" autocomplete="email" />
        </div>
      </div>
      <div class="contact-field">
        <label for={`${idPrefix}-message`}>{copy.message}</label>
        <textarea
          id={`${idPrefix}-message`}
          name="message"
          required
          minlength="10"
          maxlength="5000"
          rows="3"
          placeholder={copy.messagePlaceholder}></textarea>
      </div>

      <Turnstile lang={lang} theme="dark" />

      <div class="contact-actions">
        <button type="submit" data-umami-event="contact-submit" class="btn">{copy.submit}</button>
        <p class="text-xs text-on-dark-muted">
          {copy.privacy}
          <a href={localizedRoute('privacy', lang)} class="contact-link">{copy.privacyLink}</a>.
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 52rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 2.5rem;
      align-items: start;
    }
  }
  .contact-intro,
  .contact-form {
    min-width: 0;
  }
  .contact-form {
    display: grid;
    gap: 0.7rem;
  }
  .contact-row {
    display: grid;
    gap: 0.7rem;
  }
  @media (min-width: 40rem) {
    .contact-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .contact-field {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .contact-field label {
    font-size: 0.8rem;
    color: var(--tone-on-dark-muted);
  }
  .contact-field input,
  .contact-field textarea {
    width: 100%;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--tone-dark-2);
    border-radius: 0.6rem;
    background: var(--tone-raised);
    color: var(--tone-ink);
    font: inherit;
    font-size: 0.95rem;
  }
  .contact-field textarea {
    resize: vertical;
    min-height: 5.5rem;
  }
  .contact-field input:focus-visible,
  .contact-field textarea:focus-visible {
    outline: 2px solid var(--tone-accent-on-dark);
    outline-offset: 1px;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .contact-link {
    color: var(--tone-on-dark);
    text-decoration: underline;
    text-decoration-color: var(--tone-accent-on-dark);
    text-underline-offset: 0.2em;
  }
  .contact-link:hover {
    color: var(--tone-accent-on-dark);
  }
  .contact-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
