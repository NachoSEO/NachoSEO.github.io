---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  comparison: {
    options: { name: string; me?: boolean }[];
    rows: { criterion: string; cells: string[] }[];
  };
}

const { lang, comparison } = Astro.props;
const es = lang === 'es';
const meIndex = comparison.options.findIndex((option) => option.me);
---

<section class="mx-auto max-w-5xl px-6 pt-24">
  <div class="reveal">
    <p class="eyebrow">{es ? 'comparativa honesta' : 'honest comparison'}</p>
    <h2 class="font-display mt-4 text-3xl font-bold tracking-tight">
      {es ? '¿Qué opción te conviene de verdad?' : 'Which option actually suits you?'}
    </h2>
    <p class="mt-3 max-w-2xl text-sm text-muted">
      {es
        ? 'Incluyo las filas donde no gano yo. Si otra opción te encaja mejor, te lo diré también en la llamada.'
        : "I include the rows where I don't win. If another option fits you better, I'll say so on the call too."}
    </p>
  </div>

  <!-- Desktop: tabla -->
  <div class="reveal mt-10 hidden overflow-hidden rounded-2xl border border-line md:block">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-line bg-raised">
          <th scope="col" class="p-4 font-mono text-xs font-medium text-muted"></th>
          {
            comparison.options.map((option) => (
              <th
                scope="col"
                class:list={[
                  'p-4 font-display font-bold',
                  option.me ? 'bg-accent/10 text-accent' : '',
                ]}
              >
                {option.name}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {
          comparison.rows.map((row) => (
            <tr>
              <th scope="row" class="p-4 font-mono text-xs font-medium text-muted">
                {row.criterion}
              </th>
              {row.cells.map((cell, cellIndex) => (
                <td class:list={['p-4 text-muted', cellIndex === meIndex ? 'bg-accent/10 font-medium text-ink' : '']}>
                  {cell}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <!-- Móvil: tarjetas apiladas -->
  <div class="mt-10 space-y-4 md:hidden">
    {
      comparison.options.map((option, optionIndex) => (
        <div
          class:list={[
            'reveal rounded-2xl border p-5',
            option.me ? 'border-accent bg-raised' : 'border-line',
          ]}
          style={`--reveal-delay: ${optionIndex * 90}ms`}
        >
          <h3 class:list={['font-display font-bold', option.me ? 'text-accent' : '']}>
            {option.name}
          </h3>
          <dl class="mt-3 space-y-2">
            {comparison.rows.map((row) => (
              <div class="grid grid-cols-[1fr_1fr] gap-3 text-xs">
                <dt class="font-mono text-muted">{row.criterion}</dt>
                <dd>{row.cells[optionIndex]}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>
</section>
