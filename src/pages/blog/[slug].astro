---
import { translatedPaths } from '../../lib/translations';
import Post from '../../layouts/Post.astro';

export function getStaticPaths() {
  return translatedPaths('blog', 'es');
}

const { entry, translationSlug } = Astro.props;
const path = `/blog/${entry.data.slug}/`;
const alternatePath = translationSlug ? `/en/blog/${translationSlug}/` : undefined;
---

<Post entry={entry} path={path} alternatePath={alternatePath} />
