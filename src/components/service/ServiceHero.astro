---
import { localizedRoute, useTranslations } from '../../i18n/utils';
import { site } from '../../site';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  tagline: string;
  /** Línea de prueba bajo el CTA */
  proof: string;
}

const { lang, title, tagline, proof } = Astro.props;
const es = lang === 'es';
const t = useTranslations(lang);
---

<section class="on-dark">
  <div class="mx-auto max-w-5xl px-5 pb-16 pt-12 sm:px-6 sm:pb-20 sm:pt-16">
    <p class="section-label">
      <a href={localizedRoute('services', lang)} class="hover:underline">
        {es ? 'Servicios' : 'Services'}
      </a>
    </p>
    <h1 class="display-1 mt-4 max-w-[22ch]">{title}</h1>
    <p class="lede mt-6">{tagline}</p>
    <a href={site.calUrl} class="btn mt-9">
      {t('cta.call30')} →
    </a>
    <p class="mt-10 max-w-[62ch] border-l-2 border-accent-on-dark pl-4 text-[0.95rem] text-on-dark-muted">
      {proof}
    </p>
  </div>
</section>
