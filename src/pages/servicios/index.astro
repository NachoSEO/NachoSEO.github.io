---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';

const services = (await getCollection('services', (entry) => entry.data.lang === 'es')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  lang="es"
  title="Servicios — Nacho Mascort"
  description="Head of Growth fraccional, sistemas de IA y automatización, consultoría SEO/GEO y formación. Servicios para empresas que quieren crecer con sistemas, no con humo."
  path="/servicios/"
  alternatePath="/en/services/"
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/servicios/' },
  ]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
    <p class="meta">Servicios</p>
    <h1 class="display-1 mt-5">Servicios de growth, IA y SEO</h1>
    <p class="lede mt-6">Consultoría SEO y GEO, dirección de growth a tiempo parcial, sistemas de IA y formación. En todos trabajas directamente conmigo, y lo que montamos sigue funcionando cuando yo me voy.</p>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        services.map((service) => (
          <a href={`/servicios/${service.data.slug}/`} class="card flex flex-col">
            <h2 class="card-title display-3 transition-colors">{service.data.title}</h2>
            <p class="mt-3 text-[0.95rem]">{service.data.tagline}</p>
            <p class="mt-3 flex-1 text-sm text-muted">{service.data.proof}</p>
            <p class="link-arrow mt-5 text-[0.95rem]">Ver servicio</p>
          </a>
        ))
      }
    </div>
  </div>

  <Cta lang="es" />
</Base>
