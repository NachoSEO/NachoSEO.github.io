---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';

interface Props {
  posts: CollectionEntry<'blog'>[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
const base = lang === 'es' ? '/blog/' : '/en/blog/';
const dateFormatter = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<ul class="mt-10 divide-y divide-line">
  {
    sorted.map((post) => (
      <li>
        <a href={`${base}${post.data.slug}/`} class="group block py-6">
          <p class="font-mono text-xs text-muted">
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
              {dateFormatter.format(post.data.pubDate)}
            </time>
          </p>
          <h2 class="font-display mt-1 text-xl font-bold group-hover:text-accent">
            {post.data.title}
          </h2>
          <p class="mt-2 text-sm text-muted">{post.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>
