---
/**
 * "How much SEO costs": no published rate. Formats, what moves the price and the embedded quote form
 * (preselected on SEO and GEO). Content lives in src/data/pricing.ts, shared with the Markdown version.
 */
import Base from '../../../layouts/Base.astro';
import BriefForm from '../../../components/BriefForm.astro';
import FaqAccordion from '../../../components/service/FaqAccordion.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import { pricingPage, pricingPageEn } from '../../../data/pricing';
---

<Base
  lang="en"
  title={`${pricingPageEn.title} — Nacho Mascort`}
  description={pricingPageEn.description}
  path={pricingPageEn.path}
  alternatePath={pricingPage.path}
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'Services', path: '/en/services/' },
    { name: pricingPageEn.title, path: pricingPageEn.path },
  ]}
  faq={[...pricingPageEn.faq]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 md:pt-20">
    <p class="section-label">Pricing</p>
    <h1 class="display-1 mt-4">{pricingPageEn.title}</h1>
    <p class="lede mt-5 max-w-[62ch]">{pricingPageEn.lede}</p>
    <a href="#presupuesto" class="btn mt-8">Get a quote</a>
  </div>

  <section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
    <SectionLabel label="Formats" />
    <h2 class="display-2 mt-3">How I work and how long each project lasts</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        pricingPageEn.formats.map((format) => (
          <a href={format.href} class="card flex flex-col">
            <p class="meta">{format.duration}</p>
            <h3 class="card-title display-3 mt-2 transition-colors">{format.name}</h3>
            <p class="mt-3 flex-1 text-[0.95rem] text-muted">{format.detail}</p>
            <p class="link-arrow mt-5 text-[0.95rem]">See the service</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
    <SectionLabel label="The price" />
    <h2 class="display-2 mt-3">What pushes the price up or down</h2>
    <ul class="row-list mt-8">
      {
        pricingPageEn.drivers.map((driver) => (
          <li class="grid gap-1 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6">
            <h3 class="font-semibold">{driver.title}</h3>
            <p class="max-w-[65ch] text-[0.95rem] text-muted">{driver.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
    <SectionLabel label="Before you hire" />
    <h2 class="display-2 mt-3">What to ask of any SEO quote</h2>
    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="display-3">Get it spelled out</h3>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[0.95rem] marker:text-accent">
          {pricingPageEn.checklist.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="display-3">Red flags</h3>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[0.95rem] marker:text-accent">
          {pricingPageEn.redFlags.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <FaqAccordion lang="en" faq={[...pricingPageEn.faq]} />

  <section id="presupuesto" class="mx-auto max-w-3xl scroll-mt-24 px-5 pt-16 pb-20 sm:px-6 md:pt-24">
    <SectionLabel label="Quote" />
    <h2 class="display-2 mt-3">Tell me what you need</h2>
    <p class="mt-4 text-muted">
      It takes 5 minutes and you only see the questions that affect the price of what you tick. If you do not know
      something, leave it blank: we will work it out together.
    </p>
    <div class="mt-10">
      <BriefForm lang="en" />
    </div>
  </section>
</Base>
