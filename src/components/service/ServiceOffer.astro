---
/**
 * Qué te llevas y cómo se contrata: entregables con su miniatura, los formatos lado a lado
 * y un bloque oscuro con el precio, la disponibilidad y las llamadas a la acción.
 */
import DeliverablePreview from './DeliverablePreview.astro';
import ServiceEngagement from './ServiceEngagement.astro';
import SectionLabel from '../SectionLabel.astro';
import { site } from '../../site';
import { localizedRoute, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import type { ServiceId } from '../../lib/brief';

interface Props {
  lang: Lang;
  deliverables: { title: string; detail: string }[];
  formats: { name: string; detail: string }[];
  pricing: string;
  availability?: string;
  briefService?: ServiceId;
  /** Enseña el rango de implicación entre los formatos y el precio */
  engagement?: boolean;
}

const { lang, deliverables, formats, pricing, availability, briefService, engagement = false } = Astro.props;
const es = lang === 'es';
const t = useTranslations(lang);
const quoteUrl = `${localizedRoute('quote', lang)}${briefService ? `?${es ? 'servicios' : 'services'}=${briefService}` : ''}`;
---

<section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
  <SectionLabel label={es ? 'Entregables' : 'Deliverables'} />
  <h2 class="display-2 mt-3">{es ? 'Lo que te llevas' : 'What you take away'}</h2>
  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      deliverables.map((deliverable, index) => (
        <li class:list={['card flex flex-col gap-4', deliverables.length % 3 === 2 && index === 0 && 'lg:col-span-2']}>
          <DeliverablePreview title={deliverable.title} />
          <div>
            <h3 class="font-semibold">{deliverable.title}</h3>
            <p class="mt-1.5 text-[0.95rem] text-muted">{deliverable.detail}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <h3 class="display-3 mt-16">{es ? 'Cómo lo puedes contratar' : 'How you can hire me'}</h3>
  <div class:list={['mt-6 grid gap-5', formats.length > 1 && 'md:grid-cols-2']}>
    {
      formats.map((format, index) => (
        <div class="format-card">
          <p class="meta text-accent-ink">{es ? `Formato ${index + 1}` : `Format ${index + 1}`}</p>
          <h4 class="display-3 mt-2">{format.name}</h4>
          <p class="mt-3 text-[0.95rem] text-muted">{format.detail}</p>
        </div>
      ))
    }
  </div>

  {engagement && <ServiceEngagement lang={lang} embedded />}

  <div class="price-box on-dark mt-10">
    <div>
      <p class="meta text-accent-on-dark">{es ? 'Precio' : 'Pricing'}</p>
      <p class="mt-2 text-[1rem]">{pricing}</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 md:justify-end">
      <a href={site.calUrl} data-umami-event="call-booking-click" data-umami-event-placement="service-offer" class="btn">{t('cta.call30')}</a>
      <a href={quoteUrl} data-umami-event="quote-click" data-umami-event-placement="service-offer" class="btn btn--ghost">{es ? 'Pide presupuesto' : 'Get a quote'}</a>
      {es && <a href="/servicios/precios/" class="w-full text-sm text-on-dark-muted underline decoration-accent-on-dark underline-offset-4 hover:text-on-dark md:text-right">Cuánto cuesta y cómo calculo el precio</a>}
    </div>
  </div>
</section>

<style>
  .format-card {
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-accent);
    border-radius: 0.875rem;
    background: var(--color-raised);
    padding: 1.4rem 1.5rem;
  }
  .price-box {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    border-radius: 1rem;
    background: var(--color-dark);
    color: var(--color-on-dark);
    padding: 1.5rem 1.6rem;
  }
  @media (min-width: 768px) {
    .price-box {
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
