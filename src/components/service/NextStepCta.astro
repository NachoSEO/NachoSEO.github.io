---
import { site } from '../../site';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';
const t = useTranslations(lang);

const steps = es
  ? [
      'Una llamada de 30 minutos: me cuentas en qué punto estás y qué quieres conseguir.',
      'En menos de 24 horas te digo si puedo ayudarte y por dónde empezaría.',
      'Te mando una propuesta con alcance y plazos, o te digo con franqueza que no te hace falta.',
    ]
  : [
      'A 30-minute call: tell me where you are and what you want to achieve.',
      "Within 24h I tell you whether I can help and where I'd start.",
      "A concrete proposal with scope and milestones, or I tell you that you don't need it.",
    ];
---

<section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
  <div class="border-t border-ink pt-10">
    <h2 class="display-2">{es ? '¿Hablamos de tu caso?' : 'Want to talk about your case?'}</h2>
    <p class="mt-4 text-muted">
      {es ? 'Así funciona cuando reservas:' : 'This is exactly what happens when you book:'}
    </p>

    <ol class="mt-8 grid gap-x-8 gap-y-6 md:grid-cols-3">
      {
        steps.map((text, index) => (
          <li class="border-t border-line pt-4">
            <p class="meta text-accent-ink">{String(index + 1).padStart(2, '0')}</p>
            <p class="mt-2 text-[0.95rem]">{text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href={site.calUrl} class="btn">{t('cta.call30')}</a>
      <p class="text-sm text-muted">
        {es ? 'O escríbeme a' : 'Or email me at'}
        <a href={`mailto:${site.email}`} class="text-ink underline decoration-accent underline-offset-4 hover:text-accent-ink">{site.email}</a>
      </p>
    </div>
  </div>
</section>
