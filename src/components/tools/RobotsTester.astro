---
import type { Lang } from '../../i18n/ui';
import { BOTS } from '../../data/bots';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';

/** Marcados al abrir: Google, Bing y los bots de IA que más se bloquean */
const DEFAULT_AGENTS = ['googlebot', 'bingbot', 'oai-searchbot', 'gptbot', 'claudebot', 'perplexitybot', 'google-extended'];

const copy = es
  ? {
      urlLabel: 'Web',
      urlPlaceholder: 'https://example.com',
      load: 'Cargar robots.txt',
      robotsLabel: 'robots.txt (puedes editarlo)',
      urlsLabel: 'URLs o rutas a probar, una por línea',
      agentsLegend: 'User-agents',
      customLabel: 'Otro user-agent',
      customHelp: 'Solo el nombre, sin versión: AdsBot-Google, Googlebot-Image…',
      run: 'Probar',
      noscript: 'El tester funciona con JavaScript. Actívalo para probar tu robots.txt.',
      resultLabel: 'Resultado',
      reportTitle: 'Lo que Google entiende de tu robots.txt',
    }
  : {
      urlLabel: 'Site',
      urlPlaceholder: 'https://example.com',
      load: 'Load robots.txt',
      robotsLabel: 'robots.txt (you can edit it)',
      urlsLabel: 'URLs or paths to test, one per line',
      agentsLegend: 'User-agents',
      customLabel: 'Another user-agent',
      customHelp: 'Just the name, no version: AdsBot-Google, Googlebot-Image…',
      run: 'Test',
      noscript: 'The tester runs on JavaScript. Enable it to test your robots.txt.',
      resultLabel: 'Result',
      reportTitle: 'What Google makes of your robots.txt',
    };

/** Textos que necesita el script del cliente */
const messages = es
  ? {
      loading: 'Cargando…',
      loaded: 'Cargado de {url} · HTTP {status} · {size}',
      notFound: 'HTTP {status}: no hay robots.txt. Google entiende que puede rastrearlo todo.',
      serverError: 'HTTP {status}: con un error de servidor Google deja de rastrear la web mientras dure.',
      unreachable: 'No he podido descargarlo ({error}). Si a Google le pasa lo mismo, deja de rastrear la web.',
      truncated: 'Pasa de 500 KiB: Google ignora todo lo que va detrás.',
      notRobots: 'HTTP {status}, pero la respuesta no es un robots.txt (parece HTML u otro formato). Google no entendería reglas en ella.',
      invalidUrl: 'Escribe la URL de una web pública, como https://example.com.',
      errorGeneric: 'No he podido cargar el robots.txt. Prueba otra vez en un momento.',
      errorEngine: 'No se ha podido cargar el parser en tu navegador. Prueba a recargar la página.',
      noUrls: 'Añade al menos una URL o ruta.',
      noAgents: 'Elige al menos un user-agent.',
      invalidAgent: '«{agent}» no vale: un user-agent solo lleva letras, guiones y guiones bajos.',
      urlColumn: 'URL',
      allowed: 'Permitido',
      blocked: 'Bloqueado',
      lineRule: 'Línea {line}: {rule}',
      noRule: 'Ninguna regla',
      wildcard: 'grupo *',
      summary: '{rules} reglas · {unused} directivas que Google ignora · {lines} líneas',
      issueTypo: 'Errata que Google acepta igualmente.',
      issueColon: 'Falta el «:». Google la lee, otros buscadores quizá no.',
      issueUnused: 'Google reconoce la directiva pero no la usa.',
      issueUnknown: 'Google no la entiende y la ignora.',
      issueTooLong: 'Pasa de 16.664 bytes y Google la corta.',
      noIssues: 'Google entiende todas las líneas.',
      invalidLine: 'URL no válida',
    }
  : {
      loading: 'Loading…',
      loaded: 'Loaded from {url} · HTTP {status} · {size}',
      notFound: 'HTTP {status}: there is no robots.txt. Google takes it as permission to crawl everything.',
      serverError: 'HTTP {status}: on a server error Google stops crawling the site while it lasts.',
      unreachable: "I couldn't download it ({error}). If Google can't either, it stops crawling the site.",
      truncated: 'It is over 500 KiB: Google ignores everything after that.',
      notRobots: "HTTP {status}, but the response isn't a robots.txt (it looks like HTML or another format). Google wouldn't find rules in it.",
      invalidUrl: 'Enter the URL of a public website, like https://example.com.',
      errorGeneric: "I couldn't load the robots.txt. Try again in a moment.",
      errorEngine: "The parser couldn't load in your browser. Try reloading the page.",
      noUrls: 'Add at least one URL or path.',
      noAgents: 'Pick at least one user-agent.',
      invalidAgent: '"{agent}" is not valid: a user-agent only has letters, hyphens and underscores.',
      urlColumn: 'URL',
      allowed: 'Allowed',
      blocked: 'Blocked',
      lineRule: 'Line {line}: {rule}',
      noRule: 'No rule',
      wildcard: '* group',
      summary: '{rules} rules · {unused} directives Google ignores · {lines} lines',
      issueTypo: 'A typo Google accepts anyway.',
      issueColon: 'Missing ":". Google reads it, other search engines may not.',
      issueUnused: 'Google recognises the directive but does not use it.',
      issueUnknown: "Google doesn't understand it and ignores it.",
      issueTooLong: 'Over 16,664 bytes, so Google cuts it.',
      noIssues: 'Google understands every line.',
      invalidLine: 'Invalid URL',
    };

const inputClass =
  'w-full rounded-lg border border-line bg-paper px-4 py-3 text-[0.95rem] text-ink transition-colors focus:border-ink';
const sampleRobots = 'User-agent: *\nDisallow: /search\nAllow: /search/about\n\nUser-agent: GPTBot\nDisallow: /\n\nSitemap: https://example.com/sitemap.xml';
---

<div class="card sm:p-8" data-robots-tester data-lang={lang} data-messages={JSON.stringify(messages)}>
  <form class="flex flex-col gap-3 sm:flex-row sm:items-end" data-load-form novalidate>
    <div class="flex-1">
      <label for="robots-url" class="text-sm font-semibold">{copy.urlLabel}</label>
      <input id="robots-url" type="url" inputmode="url" autocomplete="url" placeholder={copy.urlPlaceholder} class:list={[inputClass, 'mt-2']} data-url />
    </div>
    <button type="submit" class="btn btn--ghost shrink-0" data-load data-umami-event="robots-tester-load">{copy.load}</button>
  </form>
  <p class="meta mt-3" data-load-status aria-live="polite"></p>

  <label for="robots-body" class="mt-6 block text-sm font-semibold">{copy.robotsLabel}</label>
  <textarea id="robots-body" rows="12" spellcheck="false" autocomplete="off" class:list={[inputClass, 'mt-2 font-mono text-[0.85rem] leading-relaxed']} data-robots>{sampleRobots}</textarea>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div>
      <label for="robots-urls" class="text-sm font-semibold">{copy.urlsLabel}</label>
      <textarea id="robots-urls" rows="6" spellcheck="false" autocomplete="off" class:list={[inputClass, 'mt-2 font-mono text-[0.85rem] leading-relaxed']} data-urls>{'/\n/search?q=seo\n/search/about'}</textarea>
    </div>
    <fieldset>
      <legend class="text-sm font-semibold">{copy.agentsLegend}</legend>
      <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-[0.9rem]">
        {
          BOTS.map((bot) => (
            <label class="flex cursor-pointer items-center gap-2">
              <input type="checkbox" class="h-4 w-4 shrink-0 accent-[var(--tone-accent)]" value={bot.name} checked={DEFAULT_AGENTS.includes(bot.token)} data-agent />
              {bot.name}
            </label>
          ))
        }
      </div>
      <label for="robots-custom-agent" class="mt-4 block text-sm font-semibold">{copy.customLabel}</label>
      <input id="robots-custom-agent" type="text" spellcheck="false" autocomplete="off" class:list={[inputClass, 'mt-2 font-mono']} aria-describedby="robots-custom-help" data-custom-agent />
      <p id="robots-custom-help" class="mt-2 text-sm text-muted">{copy.customHelp}</p>
    </fieldset>
  </div>

  <div class="mt-6">
    <button type="button" class="btn" data-run data-umami-event="robots-tester-run">{copy.run}</button>
  </div>
  <p role="alert" class="mt-4 text-sm font-semibold text-accent-ink" data-error hidden></p>
  <noscript><p class="mt-4 text-sm font-semibold text-accent-ink">{copy.noscript}</p></noscript>
</div>

<section class="card mt-5 sm:p-8" aria-labelledby="robots-result-title" aria-live="polite" data-result hidden>
  <h2 id="robots-result-title" class="section-label">{copy.resultLabel}</h2>
  <div class="mt-5 overflow-x-auto">
    <table class="robots-table w-full text-left text-sm" data-matrix></table>
  </div>

  <h3 class="display-3 mt-10">{copy.reportTitle}</h3>
  <p class="meta mt-2" data-report-summary></p>
  <ul class="row-list mt-4 text-[0.9rem]" data-report-list></ul>
</section>

<script>
  import wasmUrl from '../../lib/robotstxt/robotstxt.wasm?url';
  import { loadRobotsEngine, robotsLines, RobotsTag, ruleText, type RobotsEngine } from '../../lib/robotstxt';

  const tool = document.querySelector<HTMLElement>('[data-robots-tester]');
  const result = document.querySelector<HTMLElement>('[data-result]');

  if (tool && result) {
    const messages: Record<string, string> = JSON.parse(tool.dataset.messages ?? '{}');
    const numberFormat = new Intl.NumberFormat(tool.dataset.lang === 'es' ? 'es-ES' : 'en-US');
    const format = (key: string, values: Record<string, string | number> = {}) =>
      messages[key].replace(/\{(\w+)\}/g, (_, name) =>
        typeof values[name] === 'number' ? numberFormat.format(values[name] as number) : String(values[name])
      );
    const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') =>
      Object.assign(document.createElement(tag), { className, textContent: text });

    const urlInput = tool.querySelector<HTMLInputElement>('[data-url]')!;
    const loadForm = tool.querySelector<HTMLFormElement>('[data-load-form]')!;
    const loadButton = tool.querySelector<HTMLButtonElement>('[data-load]')!;
    const loadStatus = tool.querySelector<HTMLElement>('[data-load-status]')!;
    const robotsInput = tool.querySelector<HTMLTextAreaElement>('[data-robots]')!;
    const urlsInput = tool.querySelector<HTMLTextAreaElement>('[data-urls]')!;
    const agentInputs = [...tool.querySelectorAll<HTMLInputElement>('[data-agent]')];
    const customAgentInput = tool.querySelector<HTMLInputElement>('[data-custom-agent]')!;
    const runButton = tool.querySelector<HTMLButtonElement>('[data-run]')!;
    const errorBox = tool.querySelector<HTMLElement>('[data-error]')!;
    const loadLabel = loadButton.textContent ?? '';

    // Base para las rutas relativas: la web cargada o, si no hay, un dominio de ejemplo
    let baseUrl = 'https://example.com/';
    let engine: Promise<RobotsEngine> | undefined;
    const getEngine = () =>
      (engine ??= WebAssembly.compileStreaming(fetch(wasmUrl))
        .catch(() => fetch(wasmUrl).then((response) => response.arrayBuffer()).then((bytes) => WebAssembly.compile(bytes)))
        .then(loadRobotsEngine));

    function showError(message: string) {
      errorBox.textContent = message;
      errorBox.hidden = !message;
    }

    const formatSize = (bytes: number) => (bytes < 1024 ? `${bytes} B` : `${numberFormat.format(Math.round(bytes / 102.4) / 10)} KB`);

    loadForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      showError('');
      loadButton.disabled = true;
      loadButton.textContent = messages.loading;
      loadStatus.textContent = '';
      try {
        const response = await fetch(`/api/robots-txt?url=${encodeURIComponent(urlInput.value.trim())}`);
        const data = await response.json();
        if (data.error === 'invalid-url') return showError(messages.invalidUrl);
        if (!response.ok) return showError(messages.errorGeneric);
        baseUrl = new URL('/', data.finalUrl).href;
        if (data.status === null) {
          loadStatus.textContent = format('unreachable', { error: data.error ?? '?' });
          robotsInput.value = '';
        } else if (data.status >= 500 || data.status === 429) {
          loadStatus.textContent = format('serverError', { status: data.status });
          robotsInput.value = '';
        } else if (data.status >= 400) {
          loadStatus.textContent = format('notFound', { status: data.status });
          robotsInput.value = '';
        } else if (data.notRobots) {
          loadStatus.textContent = format('notRobots', { status: data.status });
          robotsInput.value = '';
        } else {
          const size = new TextEncoder().encode(data.body).length;
          loadStatus.textContent = `${format('loaded', { url: data.finalUrl, status: data.status, size: formatSize(size) })}${data.truncated ? ` · ${messages.truncated}` : ''}`;
          robotsInput.value = data.body;
        }
        run();
      } catch {
        showError(messages.errorGeneric);
      } finally {
        loadButton.disabled = false;
        loadButton.textContent = loadLabel;
      }
    });

    /** Rutas relativas contra la web cargada; new URL aplica el %-encoding que pide el parser */
    const toUrl = (line: string) => {
      try {
        return new URL(/^https?:\/\//i.test(line) ? line : line.startsWith('/') ? line : `/${line}`, baseUrl).href;
      } catch {
        return null;
      }
    };

    async function run() {
      showError('');
      const lines = urlsInput.value.split('\n').map((line) => line.trim()).filter(Boolean);
      const customAgent = customAgentInput.value.trim();
      const agents = [...agentInputs.filter((input) => input.checked).map((input) => input.value), ...(customAgent ? [customAgent] : [])];
      if (lines.length === 0) return showError(messages.noUrls);
      if (agents.length === 0) return showError(messages.noAgents);

      let robots: RobotsEngine;
      try {
        robots = await getEngine();
      } catch {
        engine = undefined;
        return showError(messages.errorEngine);
      }
      if (customAgent && !robots.isValidUserAgent(customAgent)) return showError(format('invalidAgent', { agent: customAgent }));

      const body = robotsInput.value;
      renderMatrix(robots, body, lines, agents);
      renderReport(robots, body);
      result.hidden = false;
    }

    function renderMatrix(robots: RobotsEngine, body: string, lines: string[], agents: string[]) {
      const table = result!.querySelector<HTMLTableElement>('[data-matrix]')!;
      const headRow = element('tr');
      headRow.append(element('th', 'py-2 pr-4 font-semibold', messages.urlColumn), ...agents.map((agent) => element('th', 'py-2 pr-4 font-semibold whitespace-nowrap', agent)));
      const head = element('thead');
      head.append(headRow);
      const tbody = element('tbody');
      for (const line of lines) {
        const row = element('tr', 'border-t border-line align-top');
        row.append(element('td', 'py-3 pr-4 font-mono text-[0.8rem] break-all', line));
        const url = toUrl(line);
        for (const agent of agents) {
          const cell = element('td', 'py-3 pr-4');
          if (!url) {
            cell.append(element('span', 'text-muted', messages.invalidLine));
          } else {
            const verdict = robots.check(body, agent, url);
            cell.append(element('span', `bot-badge bot-badge-${verdict.allowed ? 'ok' : 'blocked'}`, verdict.allowed ? messages.allowed : messages.blocked));
            const rule = ruleText(body, verdict.line);
            const detail = rule ? format('lineRule', { line: verdict.line, rule }) : messages.noRule;
            cell.append(element('code', 'mt-1 block text-xs text-muted', verdict.specificAgent || !rule ? detail : `${detail} · ${messages.wildcard}`));
          }
          row.append(cell);
        }
        tbody.append(row);
      }
      table.replaceChildren(head, tbody);
      // Las celdas de tabla ignoran min-width: el ancho mínimo va en la tabla (12rem de URL + 8rem por bot)
      table.style.minWidth = `${12 + agents.length * 8}rem`;
    }

    function renderReport(robots: RobotsEngine, body: string) {
      const report = robots.report(body);
      const textLines = robotsLines(body);
      const rules = report.lines.filter((parsed) => parsed.tag === RobotsTag.Allow || parsed.tag === RobotsTag.Disallow).length;
      result!.querySelector<HTMLElement>('[data-report-summary]')!.textContent = format('summary', {
        rules,
        unused: report.unusedDirectives,
        lines: textLines.length,
      });

      const issues = report.lines.flatMap((parsed) => {
        const notes = [
          parsed.typo && messages.issueTypo,
          parsed.missingColon && messages.issueColon,
          parsed.tooLong && messages.issueTooLong,
          parsed.tag === RobotsTag.Unused && messages.issueUnused,
          parsed.tag === RobotsTag.Unknown && !parsed.empty && !parsed.comment && messages.issueUnknown,
        ].filter((note): note is string => Boolean(note));
        return notes.length ? [{ line: parsed.line, text: textLines[parsed.line - 1] ?? '', notes }] : [];
      });

      const list = result!.querySelector<HTMLElement>('[data-report-list]')!;
      if (issues.length === 0) {
        list.replaceChildren(element('li', 'py-2.5 bot-tone-ok font-semibold', messages.noIssues));
        return;
      }
      list.replaceChildren(
        ...issues.map((issue) => {
          const item = element('li', 'py-2.5');
          const code = element('code', 'block font-mono text-[0.8rem] break-all', `${issue.line} │ ${issue.text.slice(0, 200)}`);
          item.append(code, element('span', 'mt-1 block bot-tone-warning', issue.notes.join(' ')));
          return item;
        })
      );
    }

    runButton.addEventListener('click', run);
  }
</script>
