---
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';

const tools = [
  {
    href: '/en/tools/sitemap-generator/',
    title: 'XML Sitemap Generator',
    tagline: 'Turn a list of URLs or a CSV into a sitemap.xml ready for Search Console.',
    detail: 'Automatic indexes past 50,000 URLs, one sitemap per domain, and everything runs in your browser.',
  },
];
---

<Base
  lang="en"
  title="Free SEO Tools — Nacho Mascort"
  description="Free SEO tools I use in my own projects: XML sitemap generator and more. No sign-up, and your data never leaves your browser."
  path="/en/tools/"
  alternatePath="/herramientas/"
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'Tools', path: '/en/tools/' },
  ]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
    <p class="meta">Tools</p>
    <h1 class="display-1 mt-5">Free SEO tools</h1>
    <p class="lede mt-6">
      Utilities I built to handle repetitive technical SEO tasks. I use them in my own projects and keep them open: no
      sign-up, and your data stays in your browser.
    </p>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        tools.map((tool) => (
          <a href={tool.href} class="card flex flex-col">
            <h2 class="card-title display-3 transition-colors">{tool.title}</h2>
            <p class="mt-3 text-[0.95rem]">{tool.tagline}</p>
            <p class="mt-3 flex-1 text-sm text-muted">{tool.detail}</p>
            <p class="link-arrow mt-5 text-[0.95rem]">Open tool</p>
          </a>
        ))
      }
    </div>
  </div>

  <Cta lang="en" />
</Base>
