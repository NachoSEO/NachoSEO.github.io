---
/**
 * Panel oscuro "sistema en producción": diagrama de workflow agéntico animado
 * + terminal ejecutando un run real. El módulo firma de la web.
 */
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy =
  lang === 'es'
    ? {
        eyebrow: 'sistema en producción',
        title: 'Así trabaja un sistema mientras tú no miras',
        body: 'Esto no es un diagrama de venta: es la anatomía de los sistemas que construyo. Una señal entra, un agente decide con tus reglas, las acciones se ejecutan y el resultado queda medido.',
        nodes: [
          { badge: 'señal', title: 'Algo ocurre', detail: 'Nuevo lead · keyword detectada · dato que cambia' },
          { badge: 'agente ia', title: 'El agente decide', detail: 'Analiza, prioriza y redacta con tus reglas y tu tono', live: true },
          { badge: 'acciones', title: 'Se ejecuta', detail: 'CRM actualizado · contenido publicado · informe enviado' },
          { badge: 'resultado', title: 'Queda medido', detail: 'Horas ahorradas cada semana, con log de cada decisión' },
        ],
        terminalLines: [
          '$ sistema/nuevo-lead --fuente formulario-web',
          '→ lead recibido: maria@empresa.com',
          '→ agente: analizando encaje… ICP 87/100',
          '→ agente: redactando respuesta personalizada… ok',
          '→ crm: contacto creado + etiqueta "alta prioridad"',
          '→ email: enviado en 42s',
          '✓ hecho — 0 intervenciones humanas',
        ],
        cta: 'Quiero un sistema así',
        ctaHref: '/servicios/ia-automatizacion/',
      }
    : {
        eyebrow: 'system in production',
        title: "This is how a system works while you're not looking",
        body: "This isn't a sales diagram: it's the anatomy of the systems I build. A signal comes in, an agent decides with your rules, actions execute and the result gets measured.",
        nodes: [
          { badge: 'signal', title: 'Something happens', detail: 'New lead · keyword detected · data changes' },
          { badge: 'ai agent', title: 'The agent decides', detail: 'Analyzes, prioritizes and writes with your rules and tone', live: true },
          { badge: 'actions', title: 'It executes', detail: 'CRM updated · content published · report sent' },
          { badge: 'result', title: 'It gets measured', detail: 'Hours saved every week, with a log of every decision' },
        ],
        terminalLines: [
          '$ system/new-lead --source web-form',
          '→ lead received: maria@company.com',
          '→ agent: scoring fit… ICP 87/100',
          '→ agent: drafting personalized reply… ok',
          '→ crm: contact created + tag "high priority"',
          '→ email: sent in 42s',
          '✓ done — 0 human interventions',
        ],
        cta: 'I want a system like this',
        ctaHref: '/en/services/ai-automation/',
      };
---

<section class="panel-system relative mt-24 overflow-hidden py-20">
  <div class="glow-orb parallax-slow absolute -top-24 right-[10%] h-72 w-72" aria-hidden="true">
  </div>

  <div class="relative mx-auto max-w-5xl px-6">
    <div class="reveal">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 class="font-display mt-4 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
        {copy.title}
      </h2>
      <p class="mt-4 max-w-2xl text-muted">{copy.body}</p>
    </div>

    <div class="reveal mt-12" style="--reveal-delay: 120ms">
      <div id="net-wrap" class="relative flex flex-col items-stretch gap-0 lg:flex-row lg:items-center">
        <canvas id="net-canvas" class="net-canvas" aria-hidden="true"></canvas>
        {
          copy.nodes.map((node, index) => (
            <>
              {index > 0 && (
                <>
                  <div class="flow-line hidden min-w-8 flex-1 lg:block" aria-hidden="true" />
                  <div class="flow-line-v mx-auto lg:hidden" aria-hidden="true" />
                </>
              )}
              <div class:list={['flow-node p-5 lg:max-w-56', node.live && 'flow-node--live']}>
                <p class="eyebrow">{node.badge}</p>
                <h3 class="font-display mt-2 font-bold">{node.title}</h3>
                <p class="mt-1 text-xs leading-relaxed text-muted">{node.detail}</p>
              </div>
            </>
          ))
        }
      </div>
    </div>

    <div class="mt-12 grid items-center gap-8 lg:grid-cols-[1fr_auto]">
      <div class="terminal reveal p-5" role="img" aria-label={copy.terminalLines.join('. ')}>
        {
          copy.terminalLines.map((line, index) => (
            <p
              class:list={[
                'terminal-line',
                index === copy.terminalLines.length - 1 && 'terminal-cursor',
                line.startsWith('✓') ? 'text-[#7ee787]' : line.startsWith('$') ? 'text-ink' : 'text-muted',
              ]}
              style={`--line-index: ${index}`}
            >
              {line}
            </p>
          ))
        }
      </div>
      <div class="reveal" style="--reveal-delay: 200ms">
        <a
          href={copy.ctaHref}
          class="inline-block btn-cta px-8 py-3 font-medium"
        >
          {copy.cta}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Red de agentes: partículas fluyendo entre los flow-nodes reales.
  // Decorativo puro; si algo falla, las flow-lines CSS quedan como estaban.
  const wrap = document.getElementById('net-wrap');
  const canvas = document.getElementById('net-canvas') as HTMLCanvasElement | null;
  const desktop = matchMedia('(min-width: 64rem)');
  const motionOK = matchMedia('(prefers-reduced-motion: no-preference)');

  if (wrap && canvas && motionOK.matches && desktop.matches) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      wrap.classList.add('net-on');

      let centers: { x: number; y: number }[] = [];
      let width = 0;
      let height = 0;
      let accent = '#7c96ff';

      const readColors = () => {
        accent = getComputedStyle(wrap).getPropertyValue('--tone-accent').trim() || accent;
      };

      const layout = () => {
        const wrapRect = wrap.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = wrapRect.width;
        height = wrapRect.height + 64;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        centers = [...wrap.querySelectorAll('.flow-node')].map((node) => {
          const rect = node.getBoundingClientRect();
          return {
            x: rect.left - wrapRect.left + rect.width / 2,
            y: rect.top - wrapRect.top + rect.height / 2 + 32,
          };
        });
      };

      type Particle = { edge: number; t: number; speed: number; size: number; bob: number };
      const particles: Particle[] = Array.from({ length: 14 }, (_, i) => ({
        edge: i % 3,
        t: (i * 0.23) % 1,
        speed: 0.08 + (i % 5) * 0.022,
        size: 1.6 + (i % 3) * 0.9,
        bob: (i % 7) * 0.9,
      }));

      let last = 0;
      let raf = 0;
      let running = false;

      const frame = (now: number) => {
        if (!running) return;
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        ctx.clearRect(0, 0, width, height);

        for (let i = 0; i < centers.length - 1; i++) {
          ctx.beginPath();
          ctx.moveTo(centers[i].x, centers[i].y);
          ctx.lineTo(centers[i + 1].x, centers[i + 1].y);
          ctx.globalAlpha = 0.14;
          ctx.strokeStyle = accent;
          ctx.lineWidth = 1;
          ctx.stroke();
        }

        const pulse = 4 + Math.sin(now / 450) * 2;
        if (centers[1]) {
          ctx.beginPath();
          ctx.arc(centers[1].x, centers[1].y, 26 + pulse, 0, Math.PI * 2);
          ctx.globalAlpha = 0.08;
          ctx.fillStyle = accent;
          ctx.fill();
        }

        for (const particle of particles) {
          const a = centers[particle.edge];
          const b = centers[particle.edge + 1];
          if (!a || !b) continue;
          particle.t += particle.speed * dt * 3;
          if (particle.t > 1) {
            particle.t = 0;
            particle.edge = (particle.edge + 1) % (centers.length - 1);
          }
          const x = a.x + (b.x - a.x) * particle.t;
          const wobble = Math.sin(particle.t * Math.PI * 2 + particle.bob) * 5;
          const y = a.y + (b.y - a.y) * particle.t + wobble;
          ctx.beginPath();
          ctx.arc(x, y, particle.size, 0, Math.PI * 2);
          ctx.globalAlpha = 0.35 + 0.55 * Math.sin(particle.t * Math.PI);
          ctx.fillStyle = accent;
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(frame);
      };

      const start = () => {
        if (running) return;
        running = true;
        last = performance.now();
        raf = requestAnimationFrame(frame);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(raf);
      };

      readColors();
      layout();
      new ResizeObserver(layout).observe(wrap);
      new MutationObserver(readColors).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      let intersecting = false;
      const sync = () => (intersecting && !document.hidden ? start() : stop());
      new IntersectionObserver(
        (entries) => {
          intersecting = entries[0].isIntersecting;
          sync();
        },
        { threshold: 0 }
      ).observe(wrap);
      document.addEventListener('visibilitychange', sync);
    }
  }
</script>
