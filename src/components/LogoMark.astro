---
/** Símbolo del logo: prompt de terminal (>) con tres barras que suben en lugar del guion bajo.
    Usa currentColor para el trazo; las barras usan el frambuesa de las palabras destacadas sobre petróleo. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['logo-mark', className]} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect x="1.5" y="1.5" width="61" height="61" rx="15" fill="none" stroke="currentColor" stroke-width="3"></rect>
  <polyline class="logo-prompt" points="15,21 27,32 15,43" fill="none" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"></polyline>
  <g>
    <rect class="logo-bar logo-bar-1" x="33" y="38" width="6" height="6" rx="1"></rect>
    <rect class="logo-bar logo-bar-2" x="41" y="32" width="6" height="12" rx="1"></rect>
    <rect class="logo-bar logo-bar-3" x="49" y="25" width="6" height="19" rx="1"></rect>
  </g>
</svg>

<style>
  .logo-bar {
    fill: var(--tone-highlight-on-dark);
    transform-box: fill-box;
    transform-origin: bottom;
  }
  .logo-prompt {
    stroke-dasharray: 36;
  }

  /* Las barras vuelven a crecer al pasar el ratón por el logo y en la primera página vista de la sesión */
  @media (prefers-reduced-motion: no-preference) {
    :global(.logo-link:hover) .logo-bar,
    :global(.logo-link:focus-visible) .logo-bar,
    :global(html.logo-intro) .logo-bar {
      animation: logo-rise 0.45s cubic-bezier(0.3, 0.7, 0.3, 1.2) both;
    }
    :global(.logo-link:hover) .logo-bar-2,
    :global(.logo-link:focus-visible) .logo-bar-2,
    :global(html.logo-intro) .logo-bar-2 {
      animation-delay: 0.12s;
    }
    :global(.logo-link:hover) .logo-bar-3,
    :global(.logo-link:focus-visible) .logo-bar-3,
    :global(html.logo-intro) .logo-bar-3 {
      animation-delay: 0.24s;
    }
    :global(html.logo-intro) .logo-prompt {
      animation: logo-draw 0.5s ease-out both;
    }
    :global(html.logo-intro) .logo-bar {
      animation-delay: 0.35s;
    }
    :global(html.logo-intro) .logo-bar-2 {
      animation-delay: 0.47s;
    }
    :global(html.logo-intro) .logo-bar-3 {
      animation-delay: 0.59s;
    }
  }

  @keyframes logo-rise {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes logo-draw {
    from {
      stroke-dashoffset: 36;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // Animación de entrada solo en la primera página de la sesión
  try {
    if (!sessionStorage.getItem('logo-intro')) {
      sessionStorage.setItem('logo-intro', '1');
      document.documentElement.classList.add('logo-intro');
    }
  } catch {
    // Sin sessionStorage el logo se queda estático
  }
</script>
