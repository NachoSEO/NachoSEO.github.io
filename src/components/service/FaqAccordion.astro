---
import SectionLabel from '../SectionLabel.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  faq: { question: string; answer: string }[];
}

const { lang, faq } = Astro.props;
const es = lang === 'es';
---

<section class="mx-auto max-w-5xl px-5 pt-24 sm:px-6">
  <SectionLabel label="FAQ" />
  <div class="mt-6 grid gap-10 md:grid-cols-[1fr_2fr] md:gap-14">
    <h2 class="display-2">{es ? 'Preguntas frecuentes' : 'Frequently asked questions'}</h2>
    <div class="row-list">
      {
        faq.map((item) => (
          <details name="faq" class="faq-item py-5">
            <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 font-semibold">
              {item.question}
              <span class="faq-marker shrink-0 font-mono text-accent-ink" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-[62ch] pt-3 text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
