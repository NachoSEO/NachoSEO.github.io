---
import { localizedRoute, otherLang, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** URL de la versión traducida exacta; si no existe, la home del otro idioma */
  alternatePath?: string;
}

const { lang, alternatePath } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const switchUrl = alternatePath ?? localizedRoute('home', other);
const currentPath = Astro.url.pathname;

const navLabel = lang === 'es' ? 'Principal' : 'Main';
const nav = [
  { href: localizedRoute('services', lang), label: t('nav.services') },
  { href: localizedRoute('cases', lang), label: t('nav.cases') },
  { href: localizedRoute('blog', lang), label: t('nav.blog') },
  { href: 'https://nachomascort.gumroad.com/l/programacion-seo', label: t('nav.course'), event: 'course-click' },
  { href: localizedRoute('about', lang), label: t('nav.about') },
].map((item) => ({ ...item, isCurrent: currentPath.startsWith(item.href) }));
---

<header class="on-dark relative">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-x-8 px-5 py-4 sm:px-6">
    <a href={localizedRoute('home', lang)} class="group leading-tight">
      <span class="font-display block text-xl font-semibold tracking-tight group-hover:text-accent-on-dark">
        Nacho Mascort
      </span>
      <span class="block text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-on-dark-muted">
        {t('site.tagline')}
      </span>
    </a>

    <nav aria-label={navLabel} class="ml-auto hidden gap-6 text-[0.9rem] md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-umami-event={item.event}
            data-umami-event-placement={item.event ? 'header' : undefined}
            aria-current={item.isCurrent ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap hover:text-on-dark',
              item.isCurrent ? 'text-on-dark underline decoration-accent-on-dark underline-offset-[0.4em]' : 'text-on-dark-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4 md:gap-5">
      <a href={switchUrl} hreflang={other} lang={other} aria-label={t('a11y.switchLang')} class="meta hover:text-on-dark">
        {other}
      </a>
      <a href={localizedRoute('contact', lang)} class="btn btn--small hidden md:inline-flex">
        {t('cta.book')}
      </a>
      <button
        type="button"
        class="menu-toggle -mr-2 flex h-11 w-11 items-center justify-center rounded-full md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">{t('a11y.menu')}</span>
        <span class="menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu border-t border-white/15 md:hidden">
    <nav aria-label={navLabel} class="mx-auto max-w-5xl px-5 pb-6 pt-2">
      <ul>
        {
          nav.map((item) => (
            <li class="border-b border-white/10">
              <a
                href={item.href}
                data-umami-event={item.event}
                data-umami-event-placement={item.event ? 'mobile-menu' : undefined}
                aria-current={item.isCurrent ? 'page' : undefined}
                class:list={[
                  'font-display flex items-center justify-between py-4 text-2xl',
                  item.isCurrent ? 'text-accent-on-dark' : 'text-on-dark',
                ]}
              >
                {item.label}
                <span aria-hidden="true" class="text-base text-on-dark-muted">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href={localizedRoute('contact', lang)} class="btn mt-6 w-full justify-center">
        {t('cta.book')}
      </a>
    </nav>
  </div>
</header>
