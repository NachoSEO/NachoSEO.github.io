---
import { getCollection } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';

export async function getStaticPaths() {
  const esCases = await getCollection('caseStudies', (entry) => entry.data.lang === 'es');
  const enCases = await getCollection('caseStudies', (entry) => entry.data.lang === 'en');

  return esCases.map((entry) => {
    const translation = enCases.find(
      (candidate) => candidate.data.translationKey === entry.data.translationKey
    );
    return {
      params: { slug: entry.data.slug },
      props: { entry, translationSlug: translation?.data.slug },
    };
  });
}

const { entry, translationSlug } = Astro.props;
const path = `/casos/${entry.data.slug}/`;
const alternatePath = translationSlug ? `/en/case-studies/${translationSlug}/` : undefined;
---

<CaseStudy entry={entry} path={path} alternatePath={alternatePath} />
