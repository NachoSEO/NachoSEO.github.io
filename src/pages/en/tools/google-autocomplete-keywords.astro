---
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';
import FaqAccordion from '../../../components/service/FaqAccordion.astro';
import AutocompleteExpander from '../../../components/tools/AutocompleteExpander.astro';

const path = '/en/tools/google-autocomplete-keywords/';

const faq = [
  {
    question: 'Where do the suggestions come from?',
    answer:
      "From Google Autocomplete: what the search engine suggests as you type. The tool combines your seed with letters, questions and modifiers, and merges all the suggestions without duplicates.",
  },
  {
    question: 'Does it include search volume?',
    answer:
      "No. A search showing up in Autocomplete means enough people search for it that Google suggests it, but it doesn't say how many. For volume, run them through Keyword Planner or your keyword tool.",
  },
  {
    question: 'What are the questions useful for in GEO?',
    answer:
      "The questions people type into Google are similar to what they ask ChatGPT or AI Mode, and to the searches those assistants run behind the scenes (the query fan-out). They are a good starting point to see what your content has to answer.",
  },
  {
    question: 'Is there a usage limit?',
    answer:
      "Each search sends up to 38 queries to Autocomplete, so there is a limit per IP to avoid overloading Google. If you get a limit warning, wait a few minutes. Results are stored for one day, and if you repeat a seed it comes back instantly.",
  },
];

const webApplication = {
  '@type': 'WebApplication',
  name: 'Google Autocomplete keywords',
  url: `https://nachomascort.com${path}`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@id': 'https://nachomascort.com/#person' },
};
---

<Base
  lang="en"
  title="Free Google Autocomplete Keyword Tool: Long Tail and Questions — Nacho Mascort"
  description="Pull long tail keywords and questions from Google Autocomplete: your seed combined with letters, questions and modifiers, by language and country. Free, with CSV export."
  path={path}
  alternatePath="/herramientas/keywords-autocomplete/"
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'Tools', path: '/en/tools/' },
    { name: 'Google Autocomplete keywords', path },
  ]}
  faq={faq}
  extraSchemaNodes={[webApplication]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
    <p class="meta"><a href="/en/tools/" class="hover:text-ink">Tools</a> · Keywords</p>
    <h1 class="display-1 mt-5">Google Autocomplete keywords</h1>
    <p class="lede mt-6">
      Type a keyword and get what Google suggests when you combine it with letters, questions and modifiers, in the language
      and country you choose. Real long tail searches and questions, ready to filter and download.
    </p>

    <div class="mt-10">
      <AutocompleteExpander lang="en" />
    </div>
  </div>

  <article class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 md:pt-24">
    <p class="section-label">How to use it</p>
    <div class="article-body mt-4">
      <h2>From one seed to hundreds of searches</h2>
      <p>
        Letters give you the longer searches that start with your seed («seo consultant b…», «seo consultant m…»).
        Questions give you what people wonder about the topic. Modifiers give you buying and comparison intent («for»,
        «vs», «price»). Click any suggestion to use it as a new seed and go one level deeper.
      </p>
      <p>
        I explained how it works under the hood in
        <a href="/en/blog/scraping-google-autocomplete-endpoints/">scraping the Google Autocomplete endpoints</a>. This tool
        is the web version of the script in that post.
      </p>
    </div>
  </article>

  <FaqAccordion lang="en" faq={faq} />
  <Cta lang="en" />
</Base>
