---
/**
 * Firma visual del sitio: la curva real 0→20M sesiones/mes (Softonic, 2 años),
 * dibujada como un chart anotado estilo dashboard.
 */
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const endLabel = lang === 'es' ? '20M sesiones/mes' : '20M sessions/mo';
const startLabel = lang === 'es' ? '0 · mes 1' : '0 · month 1';
const caption =
  lang === 'es'
    ? 'Programa de contenido que construí en Softonic: de 0 a 20 millones de sesiones orgánicas mensuales en 24 meses.'
    : 'Content program I built at Softonic: 0 to 20 million monthly organic sessions in 24 months.';
---

<figure class="mt-12" aria-label={caption}>
  <svg
    viewBox="0 0 720 220"
    role="img"
    class="w-full"
    fill="none"
    aria-describedby="growth-caption"
  >
    <line x1="0" y1="200" x2="720" y2="200" stroke="var(--tone-line)" stroke-width="1"></line>
    <line
      x1="0"
      y1="120"
      x2="720"
      y2="120"
      stroke="var(--tone-line)"
      stroke-width="1"
      stroke-dasharray="4 6"></line>
    <line
      x1="0"
      y1="40"
      x2="720"
      y2="40"
      stroke="var(--tone-line)"
      stroke-width="1"
      stroke-dasharray="4 6"></line>

    <path
      d="M 20 199 C 240 199, 340 190, 440 150 C 540 110, 620 60, 690 28"
      stroke="var(--tone-accent)"
      stroke-width="3"
      stroke-linecap="round"></path>
    <path
      d="M 20 199 C 240 199, 340 190, 440 150 C 540 110, 620 60, 690 28 L 690 200 L 20 200 Z"
      fill="var(--tone-accent)"
      opacity="0.07"></path>

    <circle cx="690" cy="28" r="5" fill="var(--tone-accent)"></circle>
    <text
      x="686"
      y="16"
      text-anchor="end"
      font-family="ui-monospace, Menlo, monospace"
      font-size="13"
      fill="var(--tone-ink)">{endLabel}</text>
    <text
      x="20"
      y="216"
      font-family="ui-monospace, Menlo, monospace"
      font-size="11"
      fill="var(--tone-muted)">{startLabel}</text>
    <text
      x="690"
      y="216"
      text-anchor="end"
      font-family="ui-monospace, Menlo, monospace"
      font-size="11"
      fill="var(--tone-muted)">{lang === 'es' ? 'mes 24' : 'month 24'}</text>
  </svg>
  <figcaption id="growth-caption" class="mt-3 font-mono text-xs text-muted">
    {caption}
  </figcaption>
</figure>
