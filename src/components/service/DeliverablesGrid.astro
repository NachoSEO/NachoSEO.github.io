---
import SectionLabel from '../SectionLabel.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  deliverables: { title: string; detail: string }[];
}

const { lang, deliverables } = Astro.props;
const es = lang === 'es';
---

<section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
  <SectionLabel label={es ? 'Entregables' : 'Deliverables'} />
  <h2 class="display-2 mt-6">{es ? 'Qué te llevas' : 'What you get'}</h2>
  <ul class="mt-10 grid gap-x-10 sm:grid-cols-2">
    {
      deliverables.map((deliverable) => (
        <li class="border-t border-line py-5">
          <h3 class="font-semibold">{deliverable.title}</h3>
          <p class="mt-1.5 text-[0.95rem] text-muted">{deliverable.detail}</p>
        </li>
      ))
    }
  </ul>
</section>
