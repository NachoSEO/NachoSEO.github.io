---
import { localizedRoute, otherLang, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** URL de la versión traducida exacta; si no existe, la home del otro idioma */
  alternatePath?: string;
}

const { lang, alternatePath } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const switchUrl = alternatePath ?? localizedRoute('home', other);
const currentPath = Astro.url.pathname;

const nav = [
  { href: localizedRoute('services', lang), label: t('nav.services') },
  { href: localizedRoute('cases', lang), label: t('nav.cases') },
  { href: localizedRoute('blog', lang), label: t('nav.blog') },
  { href: localizedRoute('about', lang), label: t('nav.about') },
] as const;
---

<header class="on-dark">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-4 sm:px-6">
    <a href={localizedRoute('home', lang)} class="group leading-tight">
      <span class="font-display block text-xl font-medium tracking-tight group-hover:text-accent-on-dark">
        Nacho Mascort
      </span>
      <span class="block text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-on-dark-muted">
        {t('site.tagline')}
      </span>
    </a>

    <div class="flex items-center gap-5 sm:order-last">
      <a
        href={switchUrl}
        hreflang={other}
        lang={other}
        aria-label={t('a11y.switchLang')}
        class="meta hover:text-on-dark"
      >
        {other}
      </a>
      <a href={localizedRoute('contact', lang)} class="btn btn--small">
        {t('cta.book')}
      </a>
    </div>

    <nav
      aria-label={lang === 'es' ? 'Principal' : 'Main'}
      class="flex w-full gap-6 overflow-x-auto text-[0.9rem] sm:ml-auto sm:w-auto"
    >
      {
        nav.map((item) => {
          const isCurrent = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'whitespace-nowrap hover:text-on-dark',
                isCurrent ? 'text-on-dark underline decoration-accent-on-dark underline-offset-[0.4em]' : 'text-on-dark-muted',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
