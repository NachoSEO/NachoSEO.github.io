---
import { site } from '../../site';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';

const steps = es
  ? [
      { step: '1', text: 'Llamada de 30 minutos: me cuentas dónde estás y qué quieres conseguir.' },
      { step: '2', text: 'En menos de 24h te digo si puedo ayudarte y por dónde empezaría.' },
      { step: '3', text: 'Propuesta concreta con alcance e hitos — o te digo que no lo necesitas.' },
    ]
  : [
      { step: '1', text: "A 30-minute call: tell me where you are and what you want to achieve." },
      { step: '2', text: "Within 24h I tell you whether I can help and where I'd start." },
      { step: '3', text: "A concrete proposal with scope and milestones — or I tell you that you don't need it." },
    ];
---

<section class="mx-auto max-w-5xl px-6 py-20">
  <div class="reveal relative overflow-hidden rounded-2xl bg-raised px-8 py-12">
    <div class="glow-orb parallax-slow absolute -top-24 right-[10%] h-64 w-64" aria-hidden="true">
    </div>
    <div class="relative">
      <h2 class="font-display text-3xl font-bold tracking-tight">
        {es ? '¿Hablamos de tu caso?' : 'Want to talk about your case?'}
      </h2>
      <p class="mt-2 max-w-xl text-muted">
        {es ? 'Esto es exactamente lo que pasa cuando reservas:' : 'This is exactly what happens when you book:'}
      </p>

      <ol class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          steps.map((item, index) => (
            <li class="reveal flex items-start gap-3" style={`--reveal-delay: ${index * 130}ms`}>
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-accent font-mono text-xs text-accent">
                {item.step}
              </span>
              <p class="text-sm text-muted">{item.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a
          href={site.calUrl}
          class="rounded-full bg-accent px-8 py-3 font-medium text-paper hover:opacity-90"
        >
          {es ? 'Agenda una llamada' : 'Book a call'}
        </a>
        <p class="font-mono text-xs text-muted">
          {es ? 'O escríbeme a' : 'Or email me at'}
          <a href={`mailto:${site.email}`} class="text-accent hover:underline">{site.email}</a>
        </p>
      </div>
    </div>
  </div>
</section>
