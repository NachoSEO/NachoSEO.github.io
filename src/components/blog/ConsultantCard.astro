---
/** Ficha de consultor para las listas del blog: foto redonda, nombre con su puesto y el texto como contenido */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  rank: number;
  name: string;
  role: string;
  photo: ImageMetadata;
  url?: string;
  /** Recorte de la foto cuando la cara no está centrada */
  position?: string;
  /** Respuestas SEO + GEO que le nombran en el estudio; null si no está entre los más nombrados */
  mentions?: number | null;
}

const { rank, name, role, photo, url, position = 'center', mentions } = Astro.props;
const slug = name
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-');
---

<section class="consultant-card not-prose" id={slug}>
  <Image
    src={photo}
    alt={name}
    width={160}
    height={160}
    format="webp"
    quality={75}
    class="consultant-photo"
    style={`object-position: ${position}`}
  />
  <div class="consultant-body">
    <h3>
      <span class="consultant-rank">{rank}.</span>
      {url ? <a href={url} rel="noopener">{name}</a> : name}
    </h3>
    <p class="consultant-role">{role}</p>
    {
      mentions !== undefined && (
        <p class="consultant-mentions">
          <a href="/estudios/consultores-seo-ia/">En el estudio</a>:{' '}
          {mentions === null ? 'no está entre los más nombrados por la IA' : `la IA le nombra en ${mentions} de 576 respuestas`}
        </p>
      )
    }
    <div class="consultant-text"><slot /></div>
  </div>
</section>

<style>
  .consultant-card {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.25rem;
    margin-top: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--tone-line);
  }
  .consultant-photo {
    width: 5rem;
    height: 5rem;
    border-radius: 999px;
    object-fit: cover;
    /* Las fotos recortadas sin fondo (como la mía) se ven sobre petróleo; las de fondo blanco llevan un borde fino */
    background: var(--tone-dark-2);
    box-shadow: 0 0 0 1px var(--tone-line);
  }
  .consultant-body h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
  }
  .consultant-rank {
    color: var(--tone-accent-ink);
  }
  .consultant-role {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    color: var(--tone-muted);
  }
  .consultant-mentions {
    margin: 0.35rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--tone-muted);
  }
  .consultant-mentions a {
    text-decoration: underline;
    text-decoration-color: var(--tone-accent);
    text-underline-offset: 0.2em;
  }
  .consultant-text :global(p) {
    margin-top: 0.75rem;
  }
  @media (max-width: 30rem) {
    .consultant-card {
      grid-template-columns: 3.5rem 1fr;
      gap: 1rem;
    }
    .consultant-photo {
      width: 3.5rem;
      height: 3.5rem;
    }
  }
</style>
