---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/press/*.png', { eager: true });
const logo = (key: string) => logoFiles[`../assets/logos/press/${key}.png`].default;

// Cada logo enlaza a la prueba: el programa donde di clase o la pieza que me cita.
// La altura compensa logos muy anchos o muy finos.
const groups = [
  {
    label: es ? 'He dado clase en' : "I've taught at",
    logos: [
      { key: 'upf', name: 'Universitat Pompeu Fabra', height: 38, url: 'https://web.archive.org/web/20230130085546/https://www.bsm.upf.edu/es/master-universitario-online-en-buscadores' },
      { key: 'webpositer', name: 'Webpositer Academy', height: 32, url: 'https://www.webpositeracademy.com/master-seo/' },
      { key: 'bigseo', name: 'BigSEO Academy', height: 22, url: 'https://romualdfons.com/master-seo-posicionamiento-web/' },
      { key: 'asdrubal', name: 'Asdrubal SEO · Máster de SEO Técnico', height: 44, url: 'https://sanchezdonate.net/master-seo-tecnico/' },
    ],
  },
  {
    label: es ? 'Me han mencionado' : 'Mentioned in',
    logos: [
      { key: 'google-search-central', name: 'Google Search Central', height: 22, url: 'https://developers.google.com/search/blog/2023/03/2022-recap-search-central-community' },
      { key: 'search-engine-roundtable', name: 'Search Engine Roundtable', height: 13, url: 'https://www.seroundtable.com/google-search-spam-updates-ai-42226.html' },
      { key: 'search-engine-journal', name: 'Search Engine Journal', height: 20, url: 'https://www.searchenginejournal.com/generate-text-from-images-with-python/324001/' },
      { key: 'learningseo', name: 'LearningSEO.io (Aleyda Solís)', height: 20, url: 'https://learningseo.io/seo_roadmap/automate-tasks/' },
      { key: 'el-confidencial', name: 'El Confidencial', height: 22, url: 'https://www.elconfidencial.com/tecnologia/2022-10-08/iran-internet-sanciones-estados-unidos_3502403/' },
      { key: 'abc', name: 'ABC', height: 28, url: 'https://www.abc.es/espana/comunidad-valenciana/abci-alicante-reunira-1000-profesionales-marketing-digital-evento-mas-grande-espana-201807121049_noticia.html' },
      { key: 'marketing-directo', name: 'Marketing Directo', height: 40, url: 'https://www.marketingdirecto.com/digital-general/digital/esta-experimentando-el-seo-un-proceso-de-automatizacion' },
      { key: 'prerender', name: 'Prerender.io', height: 24, url: 'https://prerender.io/resources/case-studies/how-prerender-helps-softonic-score-a-92-in-da-and-pagespeed/' },
      { key: 'flat101', name: 'Flat 101', height: 26, url: 'https://web.archive.org/web/20240621032236/https://www.flat101.es/video/episodio-13-se-dirige-el-seo-hacia-la-automatizacion/' },
      { key: 'eleven', name: 'La Máquina del SEO (Eleven)', height: 24, url: 'https://eleven.agency/blog/seo-inhouse-con-nacho-mascort/' },
    ],
  },
];
---

<section class="border-b border-line" aria-label={es ? 'Docencia y medios' : 'Teaching and press'}>
  <div class="mx-auto grid max-w-5xl gap-10 px-5 py-12 sm:px-6 md:grid-cols-[1fr_2fr] md:gap-12">
    {
      groups.map((group) => (
        <div>
          <p class="meta text-center md:text-left">{group.label}</p>
          <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-9 gap-y-6 md:justify-start">
            {group.logos.map((item) => (
              <li>
                <a href={item.url} rel="noopener" class="recognition-logo block" title={item.name}>
                  <Image
                    src={logo(item.key)}
                    alt={item.name}
                    height={item.height}
                    densities={[1, 2]}
                    class="w-auto max-w-none"
                    style={`height: ${item.height}px`}
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
