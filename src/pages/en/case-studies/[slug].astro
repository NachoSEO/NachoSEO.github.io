---
import { translatedPaths } from '../../../lib/translations';
import CaseStudy from '../../../layouts/CaseStudy.astro';

export function getStaticPaths() {
  return translatedPaths('caseStudies', 'en');
}

const { entry, translationSlug } = Astro.props;
const path = `/en/case-studies/${entry.data.slug}/`;
const alternatePath = translationSlug ? `/casos/${translationSlug}/` : undefined;
---

<CaseStudy entry={entry} path={path} alternatePath={alternatePath} />
