---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import GrowthCurve from '../components/GrowthCurve.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import SystemPanel from '../components/SystemPanel.astro';
import { site } from '../site';

const services = (await getCollection('services', (entry) => entry.data.lang === 'es')).sort(
  (a, b) => a.data.order - b.data.order
);

const stats = [
  { value: '1.000M+', label: 'usuarios/año en portfolio' },
  { value: '2M', label: 'visitas diarias (pico)' },
  { value: '0→20M', label: 'sesiones/mes en 2 años' },
  { value: '+40%', label: 'tráfico orgánico YoY' },
];

const process = [
  {
    step: '01',
    title: 'Diagnóstico',
    detail:
      'Una llamada y un análisis de tu operación: dónde se pierde el tiempo, qué canal rinde y cuál es el sistema mínimo que mueve la aguja.',
  },
  {
    step: '02',
    title: 'Sistema mínimo',
    detail:
      'Construyo la primera versión en semanas, no trimestres: un proceso automatizado o un canal ordenado, funcionando y medido.',
  },
  {
    step: '03',
    title: 'Escala y traspaso',
    detail:
      'Lo que funciona se amplía; lo que no, se corta. Al final, el sistema y la documentación son tuyos, no una dependencia mía.',
  },
];
---

<Base
  lang="es"
  title="Nacho Mascort — Growth, IA y SEO que funcionan como un sistema"
  description="Head of Growth fraccional, sistemas de IA y consultoría SEO/GEO. He dirigido webs con 2M de visitas diarias. Agenda una llamada."
  path="/"
  alternatePath="/en/"
>
  <section class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="glow-orb parallax-slow absolute -top-32 left-[8%] h-96 w-96" aria-hidden="true">
    </div>
    <div class="glow-orb parallax-fast absolute top-40 right-[-6%] h-72 w-72" aria-hidden="true">
    </div>

    <div class="hero-seq relative mx-auto max-w-5xl px-6 pt-24">
      <p class="eyebrow">growth · ia · seo</p>
      <h1 class="font-display mt-5 max-w-3xl text-5xl font-bold tracking-tight sm:text-7xl">
        Escala tu crecimiento sin escalar tu equipo
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Soy Nacho Mascort. He dirigido el crecimiento orgánico de webs con hasta
        <strong class="text-ink">2 millones de visitas al día</strong> y hoy construyo sistemas de
        IA que ejecutan ese trabajo. Hasta los ingenieros de Google me han contratado para hacer su
        SEO.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={site.calUrl}
          class="rounded-full bg-accent px-8 py-3 font-medium text-paper hover:opacity-90"
        >
          Agenda una llamada
        </a>
        <a href="/servicios/" class="font-medium text-accent hover:underline"> Ver servicios → </a>
      </div>
    </div>

    <div class="relative mx-auto max-w-5xl px-6">
      <GrowthCurve lang="es" />
    </div>
  </section>

  <LogoMarquee lang="es" />

  <section class="mx-auto max-w-5xl px-6 pt-16" aria-label="Cifras">
    <dl class="grid grid-cols-2 gap-6 sm:grid-cols-4">
      {
        stats.map((stat, index) => (
          <div class="reveal" style={`--reveal-delay: ${index * 90}ms`}>
            <dt class="font-mono text-xs text-muted">{stat.label}</dt>
            <dd class="font-display mt-1 text-3xl font-bold text-accent">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-5xl px-6 pt-24">
    <div class="reveal">
      <p class="eyebrow">servicios</p>
      <h2 class="font-display mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        Cuatro formas de trabajar conmigo
      </h2>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        services.map((service, index) => (
          <a
            href={`/servicios/${service.data.slug}/`}
            class="group card-lift reveal rounded-2xl border border-line p-6 hover:border-accent"
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <h3 class="font-display text-xl font-bold group-hover:text-accent">
              {service.data.title}
            </h3>
            <p class="mt-2 text-sm text-muted">{service.data.tagline}</p>
          </a>
        ))
      }
    </div>
  </section>

  <SystemPanel lang="es" />

  <section class="mx-auto max-w-5xl px-6 pt-24">
    <div class="reveal">
      <p class="eyebrow">cómo trabajo</p>
      <h2 class="font-display mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        De diagnóstico a sistema en tres pasos
      </h2>
    </div>
    <ol class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        process.map((item, index) => (
          <li class="reveal rounded-2xl bg-raised p-6" style={`--reveal-delay: ${index * 110}ms`}>
            <p class="font-mono text-xs text-accent">{item.step}</p>
            <h3 class="font-display mt-2 text-lg font-bold">{item.title}</h3>
            <p class="mt-2 text-sm text-muted">{item.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-5xl px-6 pt-24">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">docencia</p>
      <p class="mt-4 text-lg">
        Más de 8 años enseñando lo que ejecuto: profesor del
        <strong>Máster en Buscadores de la Universitat Pompeu Fabra</strong> y del
        <strong>Máster SEO de Webpositer Academy</strong>. Ponente en SEOnTheBeach, Clinic SEO y
        SEOPLUS.
      </p>
      <a href="/sobre-mi/" class="mt-4 inline-block font-medium text-accent hover:underline">
        Mi trayectoria completa →
      </a>
    </div>
  </section>

  <Cta lang="es" title="Cuéntame qué quieres hacer crecer" />
</Base>
