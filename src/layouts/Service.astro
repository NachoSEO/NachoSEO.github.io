---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import DeliverablesGrid from '../components/service/DeliverablesGrid.astro';
import FaqAccordion from '../components/service/FaqAccordion.astro';
import NextStepCta from '../components/service/NextStepCta.astro';
import ServiceFit from '../components/service/ServiceFit.astro';
import ServicePov from '../components/service/ServicePov.astro';
import ServiceProcess from '../components/service/ServiceProcess.astro';
import ServiceProof from '../components/service/ServiceProof.astro';
import ServiceFormats from '../components/service/ServiceFormats.astro';
import TeachingProof from '../components/service/TeachingProof.astro';
import { localizedRoute } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'services'>;
  path: string;
  alternatePath?: string;
}

const { entry, path, alternatePath } = Astro.props;
const lang = entry.data.lang as Lang;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());

const labels =
  lang === 'es'
    ? { services: 'Servicios', home: 'Inicio' }
    : { services: 'Services', home: 'Home' };

const serviceNode = {
  '@type': 'Service',
  name: entry.data.title,
  description: entry.data.description,
  serviceType: entry.data.title,
  provider: { '@id': `${Astro.site!.origin}/#person` },
  areaServed: 'Worldwide',
  availableLanguage: ['es', 'en'],
  url: new URL(path, Astro.site).href,
};

const serviceKey = entry.data.translationKey;
const { page } = entry.data;

---

<Base
  lang={lang}
  title={`${entry.data.title} — Nacho Mascort`}
  description={entry.data.description}
  path={path}
  alternatePath={alternatePath}
  breadcrumbs={[
    { name: labels.home, path: localizedRoute('home', lang) },
    { name: labels.services, path: localizedRoute('services', lang) },
    { name: entry.data.title, path },
  ]}
  faq={entry.data.faq}
  extraSchemaNodes={[serviceNode]}
>
  <ServiceHero lang={lang} title={entry.data.title} tagline={entry.data.tagline} proof={page.heroProof} />
  <ServiceFit lang={lang} fit={page.fit} />
  <ServicePov lang={lang} pov={page.pov} />
  <ServiceProcess lang={lang} process={page.process} />
  <DeliverablesGrid lang={lang} deliverables={entry.data.deliverables} />
  {
    page.proofCases.length > 0 ? (
      <ServiceProof lang={lang} proofCases={page.proofCases} />
    ) : (
      serviceKey === 'training' && <TeachingProof lang={lang} />
    )
  }
  <ServiceFormats lang={lang} formats={page.formats} pricing={page.pricing} availability={page.availability} />
  {
    hasBody && (
      <div class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
        <div class="article-body">
          <Content />
        </div>
      </div>
    )
  }
  <FaqAccordion lang={lang} faq={entry.data.faq} />
  <NextStepCta lang={lang} />
</Base>
