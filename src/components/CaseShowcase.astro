---
/**
 * Escena visual animada por caso de éxito, keyed por translationKey.
 * Decorativa (aria-hidden): las cifras indexables viven en el MDX y las métricas.
 */
import type { Lang } from '../i18n/ui';

interface Props {
  translationKey: string;
  lang: Lang;
}

const { translationKey, lang } = Astro.props;
const es = lang === 'es';

const waveHeights = [0.35, 0.6, 0.9, 0.5, 0.75, 1, 0.65, 0.85, 0.45, 0.7, 0.95, 0.55, 0.8, 0.4];
const cells = Array.from({ length: 60 }, (_, index) => index);
---

{
  translationKey === 'ad-factory' && (
    <div class="reveal mt-10 grid gap-4 sm:grid-cols-3" aria-hidden="true">
      <div data-tilt-max="4" class="scene tilt p-4">
        <p class="eyebrow">{es ? 'señales' : 'signals'}</p>
        <div class="task-feed mt-3 space-y-2 font-mono text-xs text-muted">
          <p style="--i: 0">▲ winner: hook 12s</p>
          <p style="--i: 1">▲ competitor: new angle</p>
          <p style="--i: 2">→ brief #341 {es ? 'creado' : 'created'}</p>
          <p style="--i: 3">→ brief #342 {es ? 'creado' : 'created'}</p>
        </div>
      </div>
      <div data-tilt-max="4" class="scene tilt p-4">
        <p class="eyebrow flex items-center gap-2">
          <span class="live-dot"></span>
          {es ? 'producción' : 'production'}
        </p>
        <div class="mt-3 space-y-2.5">
          {[
            { label: es ? 'motor generativo' : 'generative engine', to: '78%', d: '0ms' },
            { label: es ? 'revisión humana' : 'human review', to: '22%', d: '150ms' },
            { label: 'QA', to: '96%', d: '300ms' },
          ].map((row) => (
            <div>
              <p class="font-mono text-[0.65rem] text-muted">{row.label}</p>
              <div class="meter mt-1">
                <span style={`--to: ${row.to}; --d: ${row.d}`} />
              </div>
            </div>
          ))}
        </div>
      </div>
      <div data-tilt-max="4" class="scene tilt p-4">
        <p class="eyebrow">{es ? 'publicado' : 'shipped'}</p>
        <div class="mt-3 space-y-2 font-mono text-xs">
          <p class="text-muted">
            <span class="check-pop text-[#34d399]" style="--d: 100ms">✓</span> Meta API · 1.840
          </p>
          <p class="text-muted">
            <span class="check-pop text-[#34d399]" style="--d: 300ms">✓</span> Google API · 1.210
          </p>
          <p class="mt-3 font-display text-2xl font-bold text-accent">
            <span class="cycle-3">
              <span>200</span>
              <span>1.400</span>
              <span>3.000+</span>
            </span>
            <span class="ml-1 font-mono text-xs text-muted">{es ? '/semana' : '/week'}</span>
          </p>
        </div>
      </div>
    </div>
  )
}

{
  translationKey === 'claudegram' && (
    <div class="reveal mt-10 grid gap-4 sm:grid-cols-[1.2fr_1fr]" aria-hidden="true">
      <div data-tilt-max="4" class="scene tilt p-4">
        <p class="eyebrow">telegram</p>
        <div class="mt-3 flex flex-col gap-2">
          <p class="chat-msg chat-msg--me" style="--d: 100ms">
            {es ? 'Despliega la web y pásame el log' : 'Deploy the site and send me the log'}
          </p>
          <p class="chat-msg" style="--d: 500ms">
            <span class="font-mono text-[0.65rem] text-accent">claude code</span><br />
            {es ? 'Hecho ✓ build en 8s, 0 errores' : 'Done ✓ build in 8s, 0 errors'}
          </p>
          <p class="chat-msg chat-msg--me flex items-center gap-2" style="--d: 900ms">
            <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0" fill="var(--tone-accent)">
              <path d="M8 1a3 3 0 0 1 3 3v4a3 3 0 1 1-6 0V4a3 3 0 0 1 3-3Zm-5 7a5 5 0 0 0 10 0h1.5a6.5 6.5 0 0 1-5.75 6.46V17h-1.5v-2.54A6.5 6.5 0 0 1 1.5 8H3Z" />
            </svg>
            <span class="wave flex-1">
              {waveHeights.map((height, index) => (
                <span style={`--h: ${height}; --i: ${index}`} />
              ))}
            </span>
          </p>
        </div>
      </div>
      <div data-tilt-max="4" class="scene tilt flex flex-col justify-between p-4">
        <div>
          <p class="eyebrow">open source</p>
          <p class="mt-3 font-display text-3xl font-bold text-accent">147★</p>
          <p class="font-mono text-xs text-muted">55 forks · MIT</p>
        </div>
        <div class="mt-4 space-y-1.5 font-mono text-[0.65rem] text-muted">
          <p>
            <span class="check-pop text-[#34d399]" style="--d: 100ms">✓</span> bash · files · web
          </p>
          <p>
            <span class="check-pop text-[#34d399]" style="--d: 300ms">✓</span> Whisper → agente → TTS
          </p>
          <p>
            <span class="check-pop text-[#34d399]" style="--d: 500ms">✓</span> TypeScript · Agent SDK
          </p>
        </div>
      </div>
    </div>
  )
}

{
  translationKey === 'softonic' && (
    <div class="reveal mt-10 grid gap-4 sm:grid-cols-[1fr_1.2fr]" aria-hidden="true">
      <div data-tilt-max="4" class="scene tilt flex flex-col justify-center p-5">
        <p class="eyebrow">{es ? 'sesiones orgánicas/mes' : 'organic sessions/mo'}</p>
        <p class="mt-2 font-display text-4xl font-bold text-accent">
          <span class="cycle-3">
            <span>0</span>
            <span>8M</span>
            <span>20M</span>
          </span>
        </p>
        <p class="mt-1 font-mono text-xs text-muted">{es ? 'en 24 meses' : 'in 24 months'}</p>
      </div>
      <div data-tilt-max="4" class="scene tilt p-5">
        <p class="eyebrow">{es ? 'catálogo: 100k → 1M+ páginas' : 'catalog: 100k → 1M+ pages'}</p>
        <div class="cell-grid mt-3 grid-cols-[repeat(12,1fr)]" style="grid-template-columns: repeat(12, 1fr);">
          {cells.map((cell) => (
            <span style={`--d: ${cell}`} />
          ))}
        </div>
      </div>
    </div>
  )
}

{
  translationKey === 'word-tips' && (
    <div class="reveal mt-10 grid gap-4 sm:grid-cols-[1.2fr_1fr]" aria-hidden="true">
      <div data-tilt-max="4" class="scene tilt p-4">
        <p class="eyebrow">SERP · wordle solver</p>
        <div class="mt-3 space-y-2">
          <div class="serp-row serp-row--you">
            <span class="font-mono text-xs font-bold text-accent">#1</span>
            <span class="text-xs font-semibold">word.tips</span>
            <span class="ml-auto font-mono text-[0.6rem] text-muted">2M/día</span>
          </div>
          {['competitor-a.com', 'competitor-b.io', 'competitor-c.net'].map((site, index) => (
            <div class="serp-row">
              <span class="font-mono text-xs text-muted">#{index + 2}</span>
              <span class="text-xs text-muted">{site}</span>
            </div>
          ))}
        </div>
      </div>
      <div data-tilt-max="4" class="scene tilt flex flex-col justify-between p-4">
        <div>
          <p class="eyebrow">{es ? 'pico de tráfico' : 'traffic peak'}</p>
          <p class="mt-2 font-display text-3xl font-bold text-accent">2M<span class="text-base">{es ? '/día' : '/day'}</span></p>
          <p class="font-mono text-xs text-muted">~60M{es ? '/mes' : '/mo'} · 100% organic</p>
        </div>
        <svg viewBox="0 0 160 48" class="mt-4 w-full" fill="none">
          <path
            d="M2 44 C 30 42, 55 36, 80 26 S 130 6, 158 3"
            stroke="var(--tone-accent)"
            stroke-width="2.5"
            stroke-linecap="round"
            pathLength="1"
            class="spark-draw"
          />
        </svg>
      </div>
    </div>
  )
}
