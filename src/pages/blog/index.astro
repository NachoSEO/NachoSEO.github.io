---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

const posts = await getCollection('blog', (entry) => entry.data.lang === 'es');
---

<Base
  lang="es"
  title="Blog sobre growth, IA y SEO — Nacho Mascort"
  description="Artículos sobre growth, IA aplicada a marketing, SEO, GEO/AEO y automatización, escritos desde la ejecución real."
  path="/blog/"
  alternatePath="/en/blog/"
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog/' },
  ]}
>
  <div class="mx-auto max-w-3xl px-6 pt-16 pb-8">
    <p class="eyebrow">blog</p>
    <h1 class="font-display mt-4 text-4xl font-bold tracking-tight">Blog</h1>
    <p class="mt-4 text-lg text-muted">
      Growth, IA aplicada, SEO y automatización. Escrito desde la trinchera, no desde la teoría.
    </p>

    {
      posts.length === 0 ? (
        <p class="mt-10 rounded-2xl bg-raised px-6 py-5 text-muted">
          Los primeros artículos en español están en camino. Mientras tanto, puedes leer los
          <a href="/en/blog/" class="text-accent underline">
            artículos en inglés
          </a>
          .
        </p>
      ) : (
        <PostList posts={posts} lang="es" />
      )
    }
  </div>
</Base>
