---
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';
import FaqAccordion from '../../../components/service/FaqAccordion.astro';
import SessionValueCalculator from '../../../components/tools/SessionValueCalculator.astro';

const path = '/en/tools/organic-session-value-calculator/';

const faq = [
  {
    question: 'Why use margin instead of revenue?',
    answer:
      'Because two products with the same revenue can leave very different amounts of money. If you prioritize SEO by revenue, you can end up pushing what sells the most and earns the least. Gross margin lets you compare what each session actually contributes.',
  },
  {
    question: 'Which clicks should I enter?',
    answer:
      'The non-brand organic clicks from Search Console. Brand traffic comes from the brand, and if you mix it in, the value of SEO comes out inflated.',
  },
  {
    question: 'Do I take the conversion rate from analytics?',
    answer:
      'Better from the backend: real orders or leads attributed to the organic channel. Web analytics usually undercounts because of cookie consent, so use it to split between page types and not as a total.',
  },
  {
    question: 'How do I use it to prioritize?',
    answer:
      'Switch on "By page type" and enter the clicks and conversion rate of each one (categories, product pages, blog...). The table shows what each page type brings in and its share. The order you get almost never matches the order of search volume.',
  },
  {
    question: 'What does the Google Ads comparison tell me?',
    answer:
      'Two things. What it would cost to buy on Ads the clicks SEO brings you today, and the highest CPC you can pay without losing money, which is exactly the value of a session. If your CPC is above it, bidding on those searches does not pay off and SEO is the profitable route.',
  },
  {
    question: 'How are ROI and payback calculated?',
    answer:
      'It multiplies the extra clicks you expect to win by the value of a session and adds them up month by month with a cautious ramp: 25% of the effect by month 3, 55% by month 6 and 100% after a year. It compares that cumulative margin with the fee and the upfront investment. The conservative and optimistic scenarios use half and one and a half times those clicks.',
  },
  {
    question: 'What does the share link store?',
    answer:
      'Your numbers go in the part of the link after the "#", which the browser never sends to the server. Nothing is saved: whoever opens the link sees the calculator with your numbers and nothing else.',
  },
];

const webApplication = {
  '@type': 'WebApplication',
  name: 'Organic session value calculator',
  url: `https://nachomascort.com${path}`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@id': 'https://nachomascort.com/#person' },
};
---

<Base
  lang="en"
  title="Organic Session Value Calculator (SEO) — Nacho Mascort"
  description="Work out what each organic session is worth for your business (sales, leads or advertising), by page type, against Google Ads and with the ROI of your SEO spend."
  path={path}
  alternatePath="/herramientas/calculadora-valor-sesion-seo/"
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'Tools', path: '/en/tools/' },
    { name: 'Organic session value calculator', path },
  ]}
  faq={faq}
  extraSchemaNodes={[webApplication]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
    <p class="meta"><a href="/en/tools/" class="hover:text-ink">Tools</a> · Business</p>
    <h1 class="display-1 mt-5">Organic session value calculator</h1>
    <p class="lede mt-6">
      What each visit from Google is really worth, based on your business model. With that number you can compare page
      types, see whether SEO or Google Ads pays off better and work out when you get your investment back.
    </p>

    <div class="mt-10">
      <SessionValueCalculator lang="en" />
    </div>
  </div>

  <article class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 md:pt-24">
    <p class="section-label">How to use it</p>
    <div class="article-body mt-4">
      <h2>One number per page type</h2>
      <p>
        The value per session changes a lot from one type of page to another. A category page can earn several euros per
        session and a blog post, a few cents. Calculate a value for each page type and multiply it by its clicks: that
        shows you which parts of your site pay for the project and which only bring traffic.
      </p>
      <p>
        It is the first step of the methodology I use for SEO projects. I explain all of it, with an example from start to
        finish, in <a href="/en/blog/seo-project-methodology/">my methodology for SEO projects</a>.
      </p>
    </div>
  </article>

  <FaqAccordion lang="en" faq={faq} />
  <Cta lang="en" />
</Base>
