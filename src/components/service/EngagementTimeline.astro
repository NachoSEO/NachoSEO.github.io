---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  serviceKey: string;
  timeline: { period: string; title: string; bullets: string[] }[];
}

const { lang, serviceKey, timeline } = Astro.props;
const es = lang === 'es';
const heading =
  serviceKey === 'training'
    ? es ? 'Paso a paso' : 'Step by step'
    : es ? 'Los primeros 90 días' : 'The first 90 days';
---

<section class="mx-auto max-w-5xl px-6 pt-24">
  <div class="grid gap-10 lg:grid-cols-[240px_1fr]">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="eyebrow">{es ? 'plan' : 'plan'}</p>
      <h2 class="font-display mt-4 text-3xl font-bold tracking-tight">{heading}</h2>
      <p class="mt-3 text-sm text-muted">
        {es
          ? 'Sin retainers eternos: hitos concretos desde la primera semana.'
          : 'No endless retainers: concrete milestones from week one.'}
      </p>
    </div>

    <div class="timeline-track relative">
      <div class="absolute bottom-2 left-[7px] top-2 w-0.5 bg-line" aria-hidden="true"></div>
      <div class="rail-progress absolute bottom-2 left-[7px] top-2 w-0.5 bg-accent" aria-hidden="true">
      </div>
      <ol class="space-y-10">
        {
          timeline.map((phase, index) => (
            <li class="reveal relative pl-10" style={`--reveal-delay: ${index * 120}ms`}>
              <span
                class="absolute left-0 top-1 h-4 w-4 rounded-full border-2 border-accent bg-paper"
                aria-hidden="true"
              />
              <p class="font-mono text-xs text-accent">{phase.period}</p>
              <h3 class="font-display mt-1 text-xl font-bold">{phase.title}</h3>
              <ul class="mt-3 space-y-1.5">
                {phase.bullets.map((bullet) => (
                  <li class="flex items-start gap-2 text-sm text-muted">
                    <span class="mt-0.5 text-accent" aria-hidden="true">
                      →
                    </span>
                    {bullet}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
