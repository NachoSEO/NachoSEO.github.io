---
/** Los tres niveles de la metodología (theme, iniciativa y tarea) con el ejemplo de plan.ts, en formato compacto */
import { getPlan, type Lang } from './plan';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const { initiatives, tasks, teams, theme } = getPlan(lang);
const copy = {
  es: {
    theme: 'Theme o milestone',
    goal: 'Objetivo:',
    initiative: 'Iniciativa',
    metric: 'Métrica:',
    caption:
      'El problema de las fichas convertido en plan: un theme o milestone con su objetivo y sus resultados clave, dos iniciativas con su métrica y once tareas de cinco equipos.',
  },
  en: {
    theme: 'Theme or milestone',
    goal: 'Goal:',
    initiative: 'Initiative',
    metric: 'Metric:',
    caption:
      'The product page problem turned into a plan: a theme or milestone with its goal and key results, two initiatives with their metric and eleven tasks from five teams.',
  },
}[lang];
---

<figure class="method-levels not-prose my-10">
  <div class="ml-theme">
    <span class="ml-level">{copy.theme}</span>
    <div>
      <p class="ml-title">{copy.goal} {theme.title}</p>
      <ul class="ml-krs">
        {theme.keyResults.map((kr, index) => <li><span>KR{index + 1}</span> {kr}</li>)}
      </ul>
    </div>
  </div>
  <div class="ml-initiatives">
    {
      initiatives.map((initiative, index) => (
        <div class="ml-initiative">
          <span class="ml-level">{copy.initiative}</span>
          <p class="ml-title">{initiative.title}</p>
          <p class="ml-sub">{copy.metric} {initiative.metric}</p>
          <ul>
            {tasks
              .filter((task) => task.initiative === index)
              .map((task) => (
                <li>
                  <i style={`--team: ${teams[task.team].color}`} title={teams[task.team].label} aria-hidden="true" />
                  {task.title}
                  <span class="ml-team">{teams[task.team].label}</span>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </div>
  <figcaption>{copy.caption}</figcaption>
</figure>

<style>
  @layer components {
    figure.method-levels ul {
      list-style: none;
      padding-left: 0;
      margin-top: 0.5rem;
    }
    figure.method-levels li + li {
      margin-top: 0;
    }
    figure.method-levels p {
      margin-top: 0;
    }
  }
  .method-levels {
    font-size: 0.82rem;
    line-height: 1.4;
  }
  .ml-theme {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    border-radius: 0.75rem 0.75rem 0 0;
    background: var(--color-dark);
    color: var(--color-on-dark);
    padding: 0.7rem 0.9rem;
  }
  .ml-theme .ml-level {
    color: var(--color-accent-on-dark);
  }
  .ml-krs {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.3rem;
    color: var(--color-on-dark-muted);
  }
  .ml-krs span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-accent-on-dark);
  }
  .ml-initiatives {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    border: 1px solid var(--color-line);
    border-top: 0;
    border-radius: 0 0 0.75rem 0.75rem;
    background: var(--color-line);
    overflow: hidden;
  }
  .ml-initiative {
    background: var(--color-raised);
    padding: 0.7rem 0.9rem;
  }
  .ml-level {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }
  .ml-title {
    font-weight: 650;
    font-size: 0.92rem;
  }
  .ml-sub {
    color: var(--color-muted);
  }
  .ml-initiative ul {
    display: grid;
    gap: 0.2rem;
  }
  .ml-initiative li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .ml-initiative i {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 0.15rem;
    background: var(--team);
  }
  .ml-team {
    margin-left: auto;
    padding-left: 0.5rem;
    color: var(--color-muted);
    font-size: 0.7rem;
    white-space: nowrap;
  }
  .method-levels figcaption {
    margin-top: 0.6rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }
</style>
