---
/**
 * Módulo firma: banda oscura con el enfoque (texto crawlable) + diagrama de
 * workflow por servicio con un packet de datos recorriendo el sistema.
 */
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  serviceKey: string;
  approach: { intro: string[]; steps: { title: string; detail: string }[] };
}

const { lang, serviceKey, approach } = Astro.props;
const es = lang === 'es';

type Node = { label: string; sub?: string; live?: boolean; accent?: boolean };
type Stage = Node[];

const diagrams: Record<string, Stage[]> = {
  'ai-automation': [
    [{ label: 'trigger', sub: es ? 'CRM · formulario · cron' : 'CRM · form · cron' }],
    [
      { label: es ? 'agente · investiga' : 'agent · research' },
      { label: es ? 'agente · redacta' : 'agent · write' },
    ],
    [{ label: es ? 'revisión humana' : 'human review', sub: '✋', live: true }],
    [
      { label: 'CMS', sub: es ? 'publicado' : 'published' },
      { label: 'CRM', sub: es ? 'actualizado' : 'updated' },
      { label: es ? 'informe → tu inbox' : 'report → your inbox' },
    ],
  ],
  'fractional-growth': [
    [{ label: es ? 'objetivos de negocio' : 'business goals' }],
    [{ label: es ? 'estrategia + OKRs' : 'strategy + OKRs' }],
    [
      { label: 'SEO' },
      { label: 'Email · CRM' },
      { label: 'Affiliates' },
      { label: 'Social · YouTube' },
    ],
    [{ label: 'dashboard', sub: es ? 'una sola verdad' : 'one source of truth', live: true }],
    [{ label: es ? 'revisión mensual' : 'monthly review', sub: es ? 'escalar o cortar ↺' : 'scale or cut ↺' }],
  ],
  'seo-geo': [
    [{ label: es ? 'keyword research semántico' : 'semantic keyword research' }],
    [{ label: es ? 'arquitectura' : 'architecture' }],
    [{ label: es ? 'contenido + QA' : 'content + QA', live: true }],
    [{ label: es ? 'entidad · schema · llms.txt' : 'entity · schema · llms.txt' }],
    [
      { label: 'Google', sub: 'SERP #1 ▲', accent: true },
      { label: es ? 'motores IA' : 'AI engines', sub: es ? 'citado ✓' : 'cited ✓', accent: true },
    ],
  ],
  training: [
    [{ label: es ? 'diagnóstico' : 'diagnosis', sub: es ? '1 llamada' : '1 call' }],
    [{ label: es ? 'programa a medida' : 'custom program' }],
    [{ label: es ? 'sesiones' : 'sessions', sub: es ? 'sobre vuestra web' : 'on your website', live: true }],
    [{ label: es ? 'ejercicios + material' : 'exercises + material' }],
    [{ label: es ? 'seguimiento' : 'follow-up' }],
  ],
};

const stages = diagrams[serviceKey] ?? [];
const heading =
  serviceKey === 'training'
    ? es ? 'Cómo funciona' : 'How it works'
    : es ? 'Mi enfoque: un sistema, no trucos' : 'My approach: a system, not tricks';
---

<section id="sistema" class="panel-system relative mt-24 overflow-hidden py-20">
  <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
  <div class="glow-orb parallax-slow absolute -bottom-24 left-[15%] h-72 w-72" aria-hidden="true">
  </div>

  <div class="relative mx-auto max-w-5xl px-6">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{es ? 'el sistema' : 'the system'}</p>
      <h2 class="font-display mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{heading}</h2>
      {approach.intro.map((paragraph) => <p class="mt-4 text-muted">{paragraph}</p>)}
    </div>

    <div class="reveal relative mt-12" style="--reveal-delay: 150ms" aria-hidden="true">
      <div class="packet-lane absolute inset-x-0 top-1/2 hidden lg:block">
        <span class="packet"></span>
      </div>
      <div class="relative z-10 flex flex-col items-stretch lg:flex-row lg:items-center">
        {
          stages.map((stage, stageIndex) => (
            <>
              {stageIndex > 0 && (
                <>
                  <div class="flow-line hidden min-w-6 flex-1 lg:block" />
                  <div class="flow-line-v mx-auto lg:hidden" />
                </>
              )}
              <div class="flex flex-col gap-2">
                {stage.map((node) => (
                  <div
                    class:list={[
                      'flow-node bg-raised px-4 py-3',
                      node.live && 'flow-node--live',
                      node.accent && 'border-accent',
                    ]}
                  >
                    <p
                      class:list={[
                        'font-mono text-xs font-semibold',
                        node.accent ? 'text-accent' : '',
                      ]}
                    >
                      {node.label}
                    </p>
                    {node.sub && <p class="mt-0.5 font-mono text-[10px] text-muted">{node.sub}</p>}
                  </div>
                ))}
              </div>
            </>
          ))
        }
      </div>
    </div>

    <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        approach.steps.map((step, index) => (
          <li class="reveal" style={`--reveal-delay: ${index * 100}ms`}>
            <p class="font-mono text-xs text-accent">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="font-display mt-1 font-bold">{step.title}</h3>
            <p class="mt-1 text-sm text-muted">{step.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
