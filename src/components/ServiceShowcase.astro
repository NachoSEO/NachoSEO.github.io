---
/**
 * Escena animada a medida por servicio. Ilustrativa (aria-hidden): el contenido
 * indexable vive en el MDX; esto es el "wow" visual de cada oferta.
 */
import type { Lang } from '../i18n/ui';

interface Props {
  serviceKey: string;
  lang: Lang;
}

const { serviceKey, lang } = Astro.props;
const es = lang === 'es';
---

{
  serviceKey === 'ai-automation' && (
    <div class="reveal mt-12 grid gap-4 sm:grid-cols-3" aria-hidden="true">
      {[
        {
          name: es ? 'agente · investiga' : 'agent · research',
          tasks: es
            ? ['→ leyendo 40 fuentes…', '→ extrayendo datos clave', '→ brief generado ✓']
            : ['→ reading 40 sources…', '→ extracting key data', '→ brief generated ✓'],
          meter: '82%',
        },
        {
          name: es ? 'agente · redacta' : 'agent · write',
          tasks: es
            ? ['→ borrador v1 en tu tono', '→ revisión de estilo', '→ 12 piezas listas ✓']
            : ['→ draft v1 in your tone', '→ style review', '→ 12 pieces ready ✓'],
          meter: '64%',
        },
        {
          name: es ? 'agente · publica' : 'agent · publish',
          tasks: es
            ? ['→ CMS: programado', '→ CRM: 34 leads etiquetados', '→ informe enviado ✓']
            : ['→ CMS: scheduled', '→ CRM: 34 leads tagged', '→ report sent ✓'],
          meter: '91%',
        },
      ].map((bot, index) => (
        <div class="scene p-5">
          <p class="flex items-center gap-2 font-mono text-xs text-muted">
            <span class="live-dot" />
            {bot.name}
          </p>
          <div class="task-feed mt-3 space-y-1.5 font-mono text-xs text-muted">
            {bot.tasks.map((task, taskIndex) => (
              <p style={`--i: ${taskIndex + index}`}>{task}</p>
            ))}
          </div>
          <div class="meter mt-4" style={`--to: ${bot.meter}; --d: ${index * 150}ms`}>
            <span />
          </div>
          <p class="mt-2 flex justify-between font-mono text-[10px] text-muted">
            <span>{es ? 'hoy' : 'today'}</span>
            <span class="text-accent">{bot.meter}</span>
          </p>
        </div>
      ))}
    </div>
  )
}

{
  serviceKey === 'fractional-growth' && (
    <div class="reveal mt-12 grid gap-4 lg:grid-cols-2" aria-hidden="true">
      <div class="scene p-5">
        <p class="eyebrow">{es ? 'okr · q3' : 'okr · q3'}</p>
        <p class="font-display mt-2 text-sm font-bold">
          {es ? 'O: duplicar ingresos orgánicos' : 'O: double organic revenue'}
        </p>
        <div class="mt-4 space-y-4">
          {[
            { kr: es ? 'KR1 · +50% tráfico cualificado' : 'KR1 · +50% qualified traffic', to: '100%', done: true },
            { kr: es ? 'KR2 · CRO del funnel al 4,2%' : 'KR2 · funnel CRO to 4.2%', to: '72%', done: false },
            { kr: es ? 'KR3 · 3 canales nuevos rentables' : 'KR3 · 3 new profitable channels', to: '45%', done: false },
          ].map((item, index) => (
            <div>
              <p class="flex items-center justify-between font-mono text-xs text-muted">
                <span>{item.kr}</span>
                {item.done ? (
                  <span class="check-pop text-[#34d399]" style={`--d: ${800 + index * 200}ms`}>
                    ✓
                  </span>
                ) : (
                  <span class="text-accent">{item.to}</span>
                )}
              </p>
              <div class="meter mt-1.5" style={`--to: ${item.to}; --d: ${index * 180}ms`}>
                <span />
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="scene p-5">
        <p class="eyebrow">{es ? 'canales · semana 32' : 'channels · week 32'}</p>
        <div class="mt-4 space-y-3">
          {[
            { name: 'SEO', to: '88%', delta: '+12%' },
            { name: 'Email / CRM', to: '64%', delta: '+8%' },
            { name: 'Affiliates', to: '52%', delta: '+21%' },
            { name: 'Social', to: '41%', delta: '+5%' },
            { name: 'YouTube', to: '33%', delta: '+17%' },
          ].map((channel, index) => (
            <div class="grid grid-cols-[90px_1fr_auto] items-center gap-3">
              <span class="font-mono text-xs text-muted">{channel.name}</span>
              <div class="meter" style={`--to: ${channel.to}; --d: ${index * 140}ms`}>
                <span />
              </div>
              <span class="font-mono text-xs text-[#34d399]">{channel.delta}</span>
            </div>
          ))}
        </div>
        <p class="mt-4 flex items-center gap-2 font-mono text-[10px] text-muted">
          <span class="live-dot" />
          {es ? 'dashboard actualizado en tiempo real' : 'dashboard updating in real time'}
        </p>
      </div>
    </div>
  )
}

{
  serviceKey === 'seo-geo' && (
    <div class="reveal mt-12 grid gap-4 lg:grid-cols-2" aria-hidden="true">
      <div class="scene p-5">
        <p class="eyebrow">{es ? 'serp · tu keyword' : 'serp · your keyword'}</p>
        <div class="mt-4 space-y-2">
          <div class="rounded-lg border border-line p-3">
            <p class="font-mono text-[10px] text-muted">competidor-a.com</p>
            <p class="mt-0.5 h-2 w-3/4 rounded bg-line" />
          </div>
          <div class="rounded-lg border border-accent bg-paper p-3 shadow-[0_0_20px_-6px_var(--tone-accent)]">
            <p class="flex items-center justify-between font-mono text-[10px]">
              <span class="text-accent">tuempresa.com</span>
              <span class="cycle-3 text-right font-bold">
                <span class="text-muted">#8</span>
                <span class="text-muted">#3</span>
                <span class="text-accent">#1 ▲</span>
              </span>
            </p>
            <p class="mt-0.5 h-2 w-full rounded bg-accent/30" />
            <svg viewBox="0 0 200 36" class="mt-2 w-full" fill="none">
              <path
                class="spark-draw"
                d="M 4 32 C 50 30, 90 26, 120 18 C 150 10, 175 6, 196 4"
                pathLength="1"
                stroke="#34d399"
                stroke-width="2.5"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <div class="rounded-lg border border-line p-3">
            <p class="font-mono text-[10px] text-muted">competidor-b.com</p>
            <p class="mt-0.5 h-2 w-2/3 rounded bg-line" />
          </div>
        </div>
      </div>
      <div class="scene p-5">
        <p class="eyebrow">{es ? 'motores de respuesta' : 'answer engines'}</p>
        <div class="mt-4 rounded-xl bg-paper p-4">
          <p class="font-mono text-xs text-muted">
            {es ? '“¿quién puede escalar nuestro SEO?”' : '“who can scale our SEO?”'}
          </p>
          <div class="mt-3 flex gap-1.5">
            <span class="type-dot" style="--i: 0" />
            <span class="type-dot" style="--i: 1" />
            <span class="type-dot" style="--i: 2" />
          </div>
          <p class="mt-3 text-sm leading-relaxed">
            {es
              ? 'Según varias fuentes, una opción con historial demostrado es…'
              : 'According to several sources, an option with a proven record is…'}
          </p>
          <p
            class="check-pop mt-3 items-center gap-2 rounded-full border border-accent px-3 py-1 font-mono text-xs text-accent"
            style="--d: 900ms"
          >
            ⌁ {es ? 'citado:' : 'cited:'} tuempresa.com ✓
          </p>
        </div>
        <p class="mt-3 font-mono text-[10px] text-muted">ChatGPT · Perplexity · AI Overviews</p>
      </div>
    </div>
  )
}

{
  serviceKey === 'training' && (
    <div class="reveal mt-12 grid gap-4 lg:grid-cols-2" aria-hidden="true">
      <div class="scene p-5">
        <p class="eyebrow">{es ? 'programa · a medida' : 'program · custom'}</p>
        <ul class="mt-4 space-y-2.5">
          {(es
            ? ['Search Console a fondo', 'GEO/AEO: aparecer en la IA', 'Agentes para marketing', 'Sistemas de contenido', 'Gestión del equipo growth']
            : ['Search Console in depth', 'GEO/AEO: showing up in AI', 'Agents for marketing', 'Content systems', 'Managing the growth team']
          ).map((item, index) => (
            <li class="flex items-center gap-3 font-mono text-xs">
              <span
                class="check-pop h-4 w-4 items-center justify-center rounded border border-accent text-[10px] text-accent"
                style={`--d: ${index * 250}ms`}
              >
                ✓
              </span>
              <span class:list={[index > 2 ? 'text-muted' : '']}>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="scene p-5">
        <p class="eyebrow">{es ? 'nivel del equipo' : 'team level'}</p>
        <div class="mt-4 space-y-4">
          {[
            { label: es ? 'antes de la formación' : 'before training', to: '34%', color: 'var(--tone-muted)' },
            { label: es ? 'después · sesión 4' : 'after · session 4', to: '86%', color: 'var(--tone-accent)' },
          ].map((row, index) => (
            <div>
              <p class="flex justify-between font-mono text-xs text-muted">
                <span>{row.label}</span>
                <span style={`color: ${row.color}`}>{row.to}</span>
              </p>
              <div class="meter mt-1.5" style={`--to: ${row.to}; --d: ${index * 400}ms`}>
                <span style={`background: ${row.color}`} />
              </div>
            </div>
          ))}
        </div>
        <p class="mt-5 flex items-center gap-2 font-mono text-[10px] text-muted">
          <span class="live-dot" />
          {es
            ? 'ejercicios sobre vuestra web real, no teoría'
            : 'exercises on your real website, not theory'}
        </p>
      </div>
    </div>
  )
}
