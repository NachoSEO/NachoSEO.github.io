---
import SectionLabel from '../SectionLabel.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  fit: { yes: string[]; no: string[] };
}

const { lang, fit } = Astro.props;
const es = lang === 'es';

const columns = [
  { title: es ? 'Es para ti si…' : "It's a fit if…", items: fit.yes, mark: '✓', markClass: 'text-accent-ink' },
  { title: es ? 'No es para ti si…' : "It's not a fit if…", items: fit.no, mark: '—', markClass: 'text-muted' },
];
---

<section class="mx-auto max-w-5xl px-5 pt-24 sm:px-6">
  <SectionLabel label={es ? 'Para quién es' : "Who it's for"} />
  <h2 class="display-2 mt-3">{es ? '¿Es para ti?' : 'Is it for you?'}</h2>
  <div class="mt-10 grid gap-5 md:grid-cols-2">
    {
      columns.map((column) => (
        <div class="card">
          <h3 class="font-semibold">{column.title}</h3>
          <ul class="mt-4 space-y-3">
            {column.items.map((item) => (
              <li class="flex gap-3 text-[0.95rem]">
                <span class:list={['shrink-0 font-semibold', column.markClass]} aria-hidden="true">
                  {column.mark}
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
