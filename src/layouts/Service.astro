---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import FaqAccordion from '../components/service/FaqAccordion.astro';
import NextStepCta from '../components/service/NextStepCta.astro';
import ServiceProcess from '../components/service/ServiceProcess.astro';
import ServiceApproach from '../components/service/ServiceApproach.astro';
import ServiceEvidence from '../components/service/ServiceEvidence.astro';
import ServiceOffer from '../components/service/ServiceOffer.astro';
import ClientLogos from '../components/ClientLogos.astro';
import { localizedRoute } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { ServiceId } from '../lib/brief';

interface Props {
  entry: CollectionEntry<'services'>;
  path: string;
  alternatePath?: string;
}

const { entry, path, alternatePath } = Astro.props;
const lang = entry.data.lang as Lang;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
// Servicio que llega pre-marcado al formulario de presupuesto
const briefServiceByKey: Record<string, ServiceId> = {
  'seo-geo': 'geo',
  'seo-audit': 'geo',
  'seo-migrations': 'geo',
  'international-seo': 'geo',
  'traffic-recovery': 'geo',
  geo: 'geo',
  'ai-automation': 'ia',
  'fractional-growth': 'fraccional',
  training: 'formacion',
};

const labels =
  lang === 'es'
    ? { services: 'Servicios', home: 'Inicio' }
    : { services: 'Services', home: 'Home' };

const serviceNode = {
  '@type': 'Service',
  name: entry.data.title,
  description: entry.data.description,
  serviceType: entry.data.title,
  provider: { '@id': `${Astro.site!.origin}/#person` },
  areaServed: 'Worldwide',
  availableLanguage: ['es', 'en'],
  url: new URL(path, Astro.site).href,
};

const { page } = entry.data;

// El "no es para ti" vive ahora en las preguntas frecuentes, justo antes del precio
const notFit = page.fit.no.length
  ? [{ question: lang === 'es' ? '¿Cuándo no te conviene contratarme?' : "When shouldn't you hire me?", answer: page.fit.no.map((item) => `${lang === 'es' ? 'Si' : 'If'} ${item.charAt(0).toLowerCase()}${item.slice(1)}`).join(' ') }]
  : [];
const priceIndex = entry.data.faq.findIndex((item) => /cuesta|cost|price/i.test(item.question));
const faq =
  priceIndex === -1
    ? [...entry.data.faq, ...notFit]
    : [...entry.data.faq.slice(0, priceIndex), ...notFit, ...entry.data.faq.slice(priceIndex)];

---

<Base
  lang={lang}
  title={`${entry.data.title} — Nacho Mascort`}
  description={entry.data.description}
  path={path}
  alternatePath={alternatePath}
  breadcrumbs={[
    { name: labels.home, path: localizedRoute('home', lang) },
    { name: labels.services, path: localizedRoute('services', lang) },
    { name: entry.data.title, path },
  ]}
  faq={faq}
  extraSchemaNodes={[serviceNode]}
>
  <ServiceHero lang={lang} title={entry.data.title} tagline={entry.data.tagline} proof={page.heroProof} />
  <ClientLogos lang={lang} />
  <ServiceApproach lang={lang} pov={page.pov} checks={page.checks} />
  <ServiceEvidence lang={lang} proofCases={page.proofCases} related={page.related} />
  <ServiceProcess lang={lang} process={page.process} loopFrom={page.processLoopFrom} />
  <ServiceOffer
    lang={lang}
    deliverables={entry.data.deliverables}
    formats={page.formats}
    pricing={page.pricing}
    availability={page.availability}
    briefService={briefServiceByKey[entry.data.translationKey]}
    engagement={page.engagement}
  />
  {
    hasBody && (
      <div class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
        <div class="article-body">
          <Content />
        </div>
      </div>
    )
  }
  <FaqAccordion lang={lang} faq={faq} />
  <NextStepCta lang={lang} briefService={briefServiceByKey[entry.data.translationKey]} availability={page.availability} />
</Base>
