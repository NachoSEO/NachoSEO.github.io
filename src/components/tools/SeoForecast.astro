---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';

const copy = es
  ? {
      dropTitle: 'Arrastra aquí el export de Search Console',
      dropHint: 'El ZIP entero o sus CSV (Consultas.csv / Queries.csv y Fechas.csv / Dates.csv). Los archivos no salen de tu navegador.',
      tabsLabel: 'Tipo de forecast',
      tabScenario: 'Escenarios por posición',
      tabTrend: 'Proyección en el tiempo',
      brandLabel: 'Consultas de marca (regex, se excluyen)',
      brandPlaceholder: 'nacho|mascort',
      rangeLabel: 'Consultas entre las posiciones',
      rangeAnd: 'y',
      modeLabel: 'Escenario',
      modeTarget: 'Llevarlas a la posición',
      modeClimb: 'Subirlas este número de puestos',
      monthsLabel: 'Meses que cubre el export',
      monthsAuto: 'Calculado con las fechas del export.',
      valueLabel: 'Valor de una sesión orgánica (€, opcional)',
      valueHelp: 'Sácalo con la <a href="/herramientas/calculadora-valor-sesion-seo/">calculadora del valor de una sesión</a>.',
      horizonLabel: 'Horizonte',
      horizonOptions: [
        { value: 13, label: '3 meses' },
        { value: 26, label: '6 meses' },
        { value: 52, label: '12 meses' },
      ],
      windowLabel: 'Tendencia con las últimas',
      windowOptions: [
        { value: 13, label: '13 semanas' },
        { value: 26, label: '26 semanas' },
        { value: 52, label: '52 semanas' },
        { value: 1000, label: 'Todo el histórico' },
      ],
      seasonalityLabel: 'Aplicar la estacionalidad del último año',
      exportCsv: 'Descargar CSV',
      noscript: 'El forecast funciona con JavaScript. Actívalo para cargar tu export.',
    }
  : {
      dropTitle: 'Drop your Search Console export here',
      dropHint: 'The whole ZIP or its CSVs (Queries.csv and Dates.csv). Files never leave your browser.',
      tabsLabel: 'Forecast type',
      tabScenario: 'Position scenarios',
      tabTrend: 'Projection over time',
      brandLabel: 'Branded queries (regex, excluded)',
      brandPlaceholder: 'acme|acme corp',
      rangeLabel: 'Queries between positions',
      rangeAnd: 'and',
      modeLabel: 'Scenario',
      modeTarget: 'Move them to position',
      modeClimb: 'Move them up this many places',
      monthsLabel: 'Months the export covers',
      monthsAuto: 'Worked out from the dates in the export.',
      valueLabel: 'Value of an organic session (€, optional)',
      valueHelp: 'Get it with the <a href="/en/tools/organic-session-value-calculator/">session value calculator</a>.',
      horizonLabel: 'Horizon',
      horizonOptions: [
        { value: 13, label: '3 months' },
        { value: 26, label: '6 months' },
        { value: 52, label: '12 months' },
      ],
      windowLabel: 'Trend from the last',
      windowOptions: [
        { value: 13, label: '13 weeks' },
        { value: 26, label: '26 weeks' },
        { value: 52, label: '52 weeks' },
        { value: 1000, label: 'All history' },
      ],
      seasonalityLabel: "Apply last year's seasonality",
      exportCsv: 'Download CSV',
      noscript: 'The forecast runs on JavaScript. Enable it to load your export.',
    };

/** Textos que necesita el script del cliente */
const messages = es
  ? {
      loaded: '{files} · {queries} consultas · {days} días',
      noData: 'No encuentro consultas ni fechas en esos archivos. Sube el ZIP que descarga Search Console desde Rendimiento → Exportar.',
      readError: 'No he podido leer el archivo. Usa el ZIP o los CSV del export de Search Console.',
      needQueries: 'Para los escenarios hace falta el CSV de consultas del export.',
      needDates: 'Para la proyección hace falta el CSV de fechas del export.',
      needWeeks: 'Hacen falta al menos {n} semanas completas de datos. Exporta un periodo más largo.',
      brandInvalid: 'La regex de marca no es válida; la ignoro.',
      seasonalityOff: 'Hacen falta {n} semanas de histórico para la estacionalidad (tienes {have}). Exporta 16 meses.',
      statCurrent: 'Clics al mes ahora (sin marca)',
      statExtra: 'Clics extra al mes',
      statValue: 'Valor extra al mes',
      statQueries: 'Consultas en el escenario',
      curveTitle: 'Tu curva de CTR',
      curveHelp: 'Sale de tus propios datos sin marca. Las posiciones en gris no tienen impresiones suficientes y están interpoladas.',
      tableTitle: 'Consultas con más clics extra',
      colQuery: 'Consulta',
      colPosition: 'Posición',
      colClicks: 'Clics (periodo)',
      colExtra: 'Extra / mes',
      statForecast: 'Clics previstos ({months})',
      statRange: 'Rango del 80 %: {low}–{high}',
      statGrowth: 'Tendencia mensual',
      statRecent: 'Últimas 4 semanas',
      perWeek: '{n} / semana',
      monthsLabel: { 13: '3 meses', 26: '6 meses', 52: '12 meses' },
      chartTitle: 'Clics semanales: histórico y previsión',
      legendActual: 'Histórico',
      legendForecast: 'Previsión',
      legendBand: 'Rango del 80 %',
      tableMonth: 'Mes',
      tableLow: 'Mínimo',
      tableValue: 'Previsión',
      tableHigh: 'Máximo',
      weekOf: 'Semana del {date}',
      seasonalNote: 'Con estacionalidad: tendencia por crecimiento interanual y forma del último año.',
      linearNote: 'Sin estacionalidad: recta sobre el logaritmo de los clics semanales.',
    }
  : {
      loaded: '{files} · {queries} queries · {days} days',
      noData: "I can't find queries or dates in those files. Upload the ZIP Search Console gives you from Performance → Export.",
      readError: "I couldn't read the file. Use the Search Console export ZIP or its CSVs.",
      needQueries: 'Scenarios need the queries CSV from the export.',
      needDates: 'The projection needs the dates CSV from the export.',
      needWeeks: 'It needs at least {n} full weeks of data. Export a longer period.',
      brandInvalid: "The brand regex isn't valid, so I'm ignoring it.",
      seasonalityOff: 'Seasonality needs {n} weeks of history (you have {have}). Export 16 months.',
      statCurrent: 'Clicks per month now (non-brand)',
      statExtra: 'Extra clicks per month',
      statValue: 'Extra value per month',
      statQueries: 'Queries in the scenario',
      curveTitle: 'Your CTR curve',
      curveHelp: "It comes from your own non-brand data. Grey positions don't have enough impressions and are interpolated.",
      tableTitle: 'Queries with the most extra clicks',
      colQuery: 'Query',
      colPosition: 'Position',
      colClicks: 'Clicks (period)',
      colExtra: 'Extra / month',
      statForecast: 'Forecast clicks ({months})',
      statRange: '80% range: {low}–{high}',
      statGrowth: 'Monthly trend',
      statRecent: 'Last 4 weeks',
      perWeek: '{n} / week',
      monthsLabel: { 13: '3 months', 26: '6 months', 52: '12 months' },
      chartTitle: 'Weekly clicks: history and forecast',
      legendActual: 'History',
      legendForecast: 'Forecast',
      legendBand: '80% range',
      tableMonth: 'Month',
      tableLow: 'Low',
      tableValue: 'Forecast',
      tableHigh: 'High',
      weekOf: 'Week of {date}',
      seasonalNote: "With seasonality: trend from year-over-year growth and last year's shape.",
      linearNote: 'Without seasonality: a straight line on the log of weekly clicks.',
    };

const inputClass =
  'w-full rounded-lg border border-line bg-paper px-4 py-3 text-[0.95rem] text-ink transition-colors focus:border-ink';
const labelClass = 'text-sm font-semibold';
---

<div class="card sm:p-8" data-forecast-tool data-lang={lang} data-messages={JSON.stringify(messages)}>
  <label class="dropzone" data-dropzone>
    <input type="file" accept=".zip,.csv,text/csv,application/zip" multiple class="sr-only" data-file-input />
    <span class="display-3 block">{copy.dropTitle}</span>
    <span class="mt-2 block text-sm text-muted">{copy.dropHint}</span>
    <span class="meta mt-4 block" data-file-status></span>
  </label>
  <p role="alert" class="mt-4 text-sm font-semibold text-accent-ink" data-error hidden></p>
  <noscript><p class="mt-4 text-sm font-semibold text-accent-ink">{copy.noscript}</p></noscript>

  <div role="tablist" aria-label={copy.tabsLabel} class="mt-8 inline-flex flex-wrap rounded-full border border-line bg-paper p-1">
    <button type="button" role="tab" id="forecast-tab-scenario" aria-selected="true" aria-controls="forecast-panel-scenario" class="tool-tab" data-tab="scenario">{copy.tabScenario}</button>
    <button type="button" role="tab" id="forecast-tab-trend" aria-selected="false" aria-controls="forecast-panel-trend" tabindex="-1" class="tool-tab" data-tab="trend">{copy.tabTrend}</button>
  </div>

  <div id="forecast-panel-scenario" role="tabpanel" aria-labelledby="forecast-tab-scenario" class="mt-6 grid gap-5 md:grid-cols-2" data-panel="scenario">
    <div>
      <label for="forecast-brand" class={labelClass}>{copy.brandLabel}</label>
      <input id="forecast-brand" type="text" spellcheck="false" autocomplete="off" placeholder={copy.brandPlaceholder} class:list={[inputClass, 'mt-2 font-mono']} data-brand />
    </div>
    <div>
      <span class={labelClass} id="forecast-range-label">{copy.rangeLabel}</span>
      <div class="mt-2 flex items-center gap-3" role="group" aria-labelledby="forecast-range-label">
        <input type="number" min="1" max="100" step="1" value="4" aria-label="min" class={inputClass} data-min />
        <span class="text-sm text-muted">{copy.rangeAnd}</span>
        <input type="number" min="1" max="100" step="1" value="20" aria-label="max" class={inputClass} data-max />
      </div>
    </div>
    <div>
      <label for="forecast-mode" class={labelClass}>{copy.modeLabel}</label>
      <div class="mt-2 flex items-center gap-3">
        <select id="forecast-mode" class={inputClass} data-mode>
          <option value="target">{copy.modeTarget}</option>
          <option value="climb">{copy.modeClimb}</option>
        </select>
        <input type="number" min="1" max="50" step="1" value="3" aria-label={copy.modeLabel} class:list={[inputClass, 'max-w-[6rem]']} data-mode-value />
      </div>
    </div>
    <div>
      <label for="forecast-months" class={labelClass}>{copy.monthsLabel}</label>
      <input id="forecast-months" type="number" min="0.5" max="16" step="0.5" value="3" class:list={[inputClass, 'mt-2']} data-months />
      <p class="mt-2 text-sm text-muted" data-months-auto hidden>{copy.monthsAuto}</p>
    </div>
    <div class="md:col-span-2">
      <label for="forecast-value" class={labelClass}>{copy.valueLabel}</label>
      <input id="forecast-value" type="number" min="0" step="0.01" class:list={[inputClass, 'mt-2 max-w-[12rem]']} data-session-value />
      <p class="mt-2 text-sm text-muted" set:html={copy.valueHelp} />
    </div>
  </div>

  <div id="forecast-panel-trend" role="tabpanel" aria-labelledby="forecast-tab-trend" class="mt-6 grid gap-5 md:grid-cols-3" data-panel="trend" hidden>
    <div>
      <label for="forecast-horizon" class={labelClass}>{copy.horizonLabel}</label>
      <select id="forecast-horizon" class:list={[inputClass, 'mt-2']} data-horizon>
        {copy.horizonOptions.map((option) => <option value={option.value} selected={option.value === 26}>{option.label}</option>)}
      </select>
    </div>
    <div>
      <label for="forecast-window" class={labelClass}>{copy.windowLabel}</label>
      <select id="forecast-window" class:list={[inputClass, 'mt-2']} data-window>
        {copy.windowOptions.map((option) => <option value={option.value} selected={option.value === 26}>{option.label}</option>)}
      </select>
    </div>
    <div class="flex items-end pb-3">
      <label class="flex cursor-pointer items-center gap-3 text-sm">
        <input type="checkbox" checked class="h-4 w-4 accent-[var(--tone-accent)]" data-seasonality />
        {copy.seasonalityLabel}
      </label>
    </div>
    <p class="text-sm text-muted md:col-span-3" data-seasonality-note hidden></p>
  </div>
</div>

<section class="card mt-5 sm:p-8" aria-live="polite" data-result="scenario" hidden>
  <dl class="grid grid-cols-2 gap-x-6 gap-y-5 md:grid-cols-4" data-scenario-stats></dl>
  <h2 class="display-3 mt-10">{messages.curveTitle}</h2>
  <p class="mt-2 text-sm text-muted">{messages.curveHelp}</p>
  <div class="mt-4 overflow-x-auto"><table class="forecast-curve w-full text-center text-sm" data-curve></table></div>
  <div class="mt-10 flex flex-wrap items-baseline justify-between gap-3">
    <h2 class="display-3">{messages.tableTitle}</h2>
    <button type="button" class="btn btn--ghost" data-export="scenario">{copy.exportCsv}</button>
  </div>
  <div class="mt-4 overflow-x-auto"><table class="w-full min-w-[34rem] text-left text-sm" data-scenario-table></table></div>
</section>

<section class="card mt-5 sm:p-8" aria-live="polite" data-result="trend" hidden>
  <dl class="grid grid-cols-2 gap-x-6 gap-y-5 md:grid-cols-3" data-trend-stats></dl>
  <h2 class="display-3 mt-10">{messages.chartTitle}</h2>
  <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted" aria-hidden="true">
    <li class="flex items-center gap-2"><span class="forecast-key forecast-key--actual"></span>{messages.legendActual}</li>
    <li class="flex items-center gap-2"><span class="forecast-key forecast-key--forecast"></span>{messages.legendForecast}</li>
    <li class="flex items-center gap-2"><span class="forecast-key forecast-key--band"></span>{messages.legendBand}</li>
  </ul>
  <div class="relative mt-4" data-chart-wrap>
    <svg class="block h-auto w-full" viewBox="0 0 720 300" role="img" aria-label={messages.chartTitle} data-chart></svg>
    <div class="forecast-tooltip" role="status" data-tooltip hidden></div>
  </div>
  <p class="mt-3 text-sm text-muted" data-method-note></p>
  <div class="mt-10 flex flex-wrap items-baseline justify-end gap-3">
    <button type="button" class="btn btn--ghost" data-export="trend">{copy.exportCsv}</button>
  </div>
  <div class="mt-4 overflow-x-auto"><table class="w-full min-w-[28rem] text-left text-sm" data-trend-table></table></div>
</section>

<script>
  import {
    buildCtrCurve,
    CURVE_POSITIONS,
    detectExport,
    forecastWeeks,
    MIN_WEEKS,
    parseCsv,
    readDates,
    readQueries,
    readZip,
    runScenario,
    SEASONALITY_MIN_WEEKS,
    toWeeks,
    weeksToMonths,
    type DateRow,
    type QueryRow,
    type ScenarioRow,
  } from '../../lib/forecast';
  import { toCsv } from '../../lib/csv';

  const tool = document.querySelector<HTMLElement>('[data-forecast-tool]');
  const scenarioBox = document.querySelector<HTMLElement>('[data-result="scenario"]');
  const trendBox = document.querySelector<HTMLElement>('[data-result="trend"]');

  if (tool && scenarioBox && trendBox) {
    const messages = JSON.parse(tool.dataset.messages ?? '{}');
    const locale = tool.dataset.lang === 'es' ? 'es-ES' : 'en-US';
    const integer = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 });
    const compact = new Intl.NumberFormat(locale, { notation: 'compact', maximumFractionDigits: 1 });
    const percent = new Intl.NumberFormat(locale, { style: 'percent', maximumFractionDigits: 1, signDisplay: 'exceptZero' });
    const ctrFormat = new Intl.NumberFormat(locale, { style: 'percent', maximumFractionDigits: 1 });
    const euros = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const decimal = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
    const monthName = new Intl.DateTimeFormat(locale, { month: 'short', year: 'numeric', timeZone: 'UTC' });
    const dayName = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    const format = (template: string, values: Record<string, string | number>) =>
      template.replace(/\{(\w+)\}/g, (_, name) => String(values[name]));
    const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') =>
      Object.assign(document.createElement(tag), { className, textContent: text });
    const field = <T extends HTMLElement>(name: string) => tool.querySelector<T>(`[data-${name}]`)!;

    const errorBox = field<HTMLElement>('error');
    const fileStatus = field<HTMLElement>('file-status');
    const fileInput = field<HTMLInputElement>('file-input');
    const dropzone = field<HTMLElement>('dropzone');
    const monthsInput = field<HTMLInputElement>('months');
    const seasonalityInput = field<HTMLInputElement>('seasonality');
    const seasonalityNote = field<HTMLElement>('seasonality-note');
    const tabs = [...tool.querySelectorAll<HTMLButtonElement>('[data-tab]')];

    let queries: QueryRow[] = [];
    let dates: DateRow[] = [];
    let activeTab: 'scenario' | 'trend' = 'scenario';
    let scenarioRows: ScenarioRow[] = [];
    let trendCsv = '';

    const showError = (message: string) => {
      errorBox.textContent = message;
      errorBox.hidden = !message;
    };

    function activateTab(tab: HTMLButtonElement) {
      for (const candidate of tabs) {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
        tool!.querySelector<HTMLElement>(`[data-panel="${candidate.dataset.tab}"]`)!.hidden = !selected;
      }
      activeTab = tab.dataset.tab as 'scenario' | 'trend';
      render();
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        activateTab(next);
        next.focus();
      });
    });

    async function loadFiles(files: File[]) {
      showError('');
      try {
        const texts: { name: string; text: string }[] = [];
        for (const file of files) {
          if (/\.zip$/i.test(file.name)) texts.push(...(await readZip(await file.arrayBuffer())));
          else texts.push({ name: file.name, text: await file.text() });
        }
        for (const { text } of texts) {
          const rows = parseCsv(text);
          const kind = detectExport(rows);
          if (kind === 'queries') queries = readQueries(rows);
          if (kind === 'dates') dates = readDates(rows);
        }
        if (queries.length === 0 && dates.length === 0) return showError(messages.noData);
        fileStatus.textContent = format(messages.loaded, {
          files: files.map((file) => file.name).join(', '),
          queries: integer.format(queries.length),
          days: integer.format(dates.length),
        });
        if (dates.length > 0) {
          monthsInput.value = String(Math.round((dates.length / 30.44) * 10) / 10);
          field<HTMLElement>('months-auto').hidden = false;
        }
        if (queries.length === 0 && dates.length > 0) activateTab(tabs[1]);
        else render();
      } catch {
        showError(messages.readError);
      }
    }

    fileInput.addEventListener('change', () => fileInput.files?.length && loadFiles([...fileInput.files]));
    dropzone.addEventListener('dragover', (event) => {
      event.preventDefault();
      dropzone.classList.add('is-dragover');
    });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('is-dragover'));
    dropzone.addEventListener('drop', (event) => {
      event.preventDefault();
      dropzone.classList.remove('is-dragover');
      if (event.dataTransfer?.files.length) loadFiles([...event.dataTransfer.files]);
    });

    const stat = (label: string, value: string, note = '') => {
      const wrap = element('div');
      wrap.append(element('dt', 'meta', label), element('dd', 'display-2 mt-1', value));
      if (note) wrap.append(element('dd', 'mt-1 text-sm text-muted', note));
      return wrap;
    };

    // ---------- Escenarios ----------

    function renderScenario() {
      trendBox!.hidden = true;
      if (queries.length === 0) {
        scenarioBox!.hidden = true;
        return dates.length ? showError(messages.needQueries) : undefined;
      }
      let brandPattern: RegExp | null = null;
      const brandSource = field<HTMLInputElement>('brand').value.trim();
      try {
        brandPattern = brandSource ? new RegExp(brandSource, 'i') : null;
        showError('');
      } catch {
        showError(messages.brandInvalid);
      }
      const nonBrand = brandPattern ? queries.filter((row) => !brandPattern!.test(row.query)) : queries;
      const curve = buildCtrCurve(nonBrand);
      const months = Math.max(0.5, Number(monthsInput.value) || 3);
      const mode = field<HTMLSelectElement>('mode').value as 'target' | 'climb';
      scenarioRows = runScenario(nonBrand, curve.ctr, {
        minPosition: Number(field<HTMLInputElement>('min').value) || 1,
        maxPosition: Number(field<HTMLInputElement>('max').value) || 100,
        mode,
        value: Math.max(1, Number(field<HTMLInputElement>('mode-value').value) || 1),
        brandPattern: null,
      });
      const extraPerMonth = scenarioRows.reduce((sum, row) => sum + row.extraClicks, 0) / months;
      const currentPerMonth = nonBrand.reduce((sum, row) => sum + row.clicks, 0) / months;
      const sessionValue = Number(field<HTMLInputElement>('session-value').value) || 0;

      const stats = scenarioBox!.querySelector<HTMLElement>('[data-scenario-stats]')!;
      stats.replaceChildren(
        stat(messages.statCurrent, integer.format(currentPerMonth)),
        stat(messages.statExtra, `+${integer.format(extraPerMonth)}`, currentPerMonth ? percent.format(extraPerMonth / currentPerMonth) : ''),
        stat(messages.statValue, sessionValue ? `+${euros.format(extraPerMonth * sessionValue)}` : '—'),
        stat(messages.statQueries, integer.format(scenarioRows.filter((row) => row.extraClicks > 0).length))
      );

      const curveTable = scenarioBox!.querySelector<HTMLTableElement>('[data-curve]')!;
      const head = element('tr');
      const body = element('tr');
      for (let position = 1; position <= CURVE_POSITIONS; position++) {
        head.append(element('th', 'px-2 py-1 font-semibold', String(position)));
        body.append(element('td', `px-2 py-1 font-mono text-[0.8rem] ${curve.observed[position - 1] ? '' : 'text-muted opacity-60'}`, ctrFormat.format(curve.ctr[position - 1])));
      }
      curveTable.replaceChildren(element('thead'), element('tbody'));
      curveTable.tHead!.append(head);
      curveTable.tBodies[0].append(body);

      const table = scenarioBox!.querySelector<HTMLTableElement>('[data-scenario-table]')!;
      const headRow = element('tr');
      headRow.append(...[messages.colQuery, messages.colPosition, messages.colClicks, messages.colExtra].map((label, index) => element('th', `py-2 pr-4 font-semibold ${index ? 'text-right' : ''}`, label)));
      const rows = scenarioRows.filter((row) => row.extraClicks > 0).slice(0, 50).map((row) => {
        const tr = element('tr', 'border-t border-line');
        tr.append(
          element('td', 'py-2 pr-4 break-all', row.query),
          element('td', 'py-2 pr-4 text-right whitespace-nowrap font-mono text-[0.85rem]', `${decimal.format(row.position)} → ${decimal.format(row.newPosition)}`),
          element('td', 'py-2 pr-4 text-right whitespace-nowrap font-mono text-[0.85rem]', `${integer.format(row.clicks)} → ${integer.format(row.projectedClicks)}`),
          element('td', 'py-2 text-right font-mono text-[0.85rem] font-semibold', `+${integer.format(row.extraClicks / months)}`)
        );
        return tr;
      });
      table.replaceChildren(element('thead'), element('tbody'));
      table.tHead!.append(headRow);
      table.tBodies[0].append(...rows);
      scenarioBox!.hidden = false;
    }

    // ---------- Proyección ----------

    const daysInMonth = (month: string) => new Date(Date.UTC(+month.slice(0, 4), +month.slice(5, 7), 0)).getUTCDate();
    const SVG = 'http://www.w3.org/2000/svg';
    const svgElement = (tag: string, attributes: Record<string, string | number>) => {
      const node = document.createElementNS(SVG, tag);
      for (const [name, value] of Object.entries(attributes)) node.setAttribute(name, String(value));
      return node;
    };

    function renderTrend() {
      scenarioBox!.hidden = true;
      if (dates.length === 0) {
        trendBox!.hidden = true;
        return queries.length ? showError(messages.needDates) : undefined;
      }
      const weeks = toWeeks(dates);
      if (weeks.length < MIN_WEEKS) {
        trendBox!.hidden = true;
        return showError(format(messages.needWeeks, { n: MIN_WEEKS }));
      }
      showError('');
      const horizon = Number(field<HTMLSelectElement>('horizon').value);
      const canSeason = weeks.length >= SEASONALITY_MIN_WEEKS;
      seasonalityInput.disabled = !canSeason;
      seasonalityNote.hidden = canSeason;
      seasonalityNote.textContent = canSeason ? '' : format(messages.seasonalityOff, { n: SEASONALITY_MIN_WEEKS, have: weeks.length });
      const result = forecastWeeks(weeks, {
        trendWeeks: Number(field<HTMLSelectElement>('window').value),
        horizonWeeks: horizon,
        seasonality: seasonalityInput.checked,
      });
      const total = (key: 'value' | 'low' | 'high') => result.points.reduce((sum, point) => sum + point[key], 0);
      const recent = weeks.slice(-4).reduce((sum, point) => sum + point.clicks, 0) / 4;

      trendBox!.querySelector<HTMLElement>('[data-trend-stats]')!.replaceChildren(
        stat(format(messages.statForecast, { months: messages.monthsLabel[horizon] }), integer.format(total('value')), format(messages.statRange, { low: compact.format(total('low')), high: compact.format(total('high')) })),
        stat(messages.statGrowth, percent.format(result.monthlyGrowth)),
        stat(messages.statRecent, format(messages.perWeek, { n: integer.format(recent) }))
      );
      trendBox!.querySelector<HTMLElement>('[data-method-note]')!.textContent = result.seasonalityApplied ? messages.seasonalNote : messages.linearNote;

      const history = weeks.slice(-52);
      drawChart(history, result.points);

      // Solo meses enteros: el primero y el último suelen quedar a medias
      const months = weeksToMonths(result.points, ['low', 'value', 'high']).filter((month) => month.days === daysInMonth(month.month));
      const table = trendBox!.querySelector<HTMLTableElement>('[data-trend-table]')!;
      const headRow = element('tr');
      headRow.append(...[messages.tableMonth, messages.tableLow, messages.tableValue, messages.tableHigh].map((label, index) => element('th', `py-2 pr-4 font-semibold ${index ? 'text-right' : ''}`, label)));
      table.replaceChildren(element('thead'), element('tbody'));
      table.tHead!.append(headRow);
      table.tBodies[0].append(
        ...months.map((month) => {
          const tr = element('tr', 'border-t border-line');
          tr.append(
            element('td', 'py-2 pr-4', monthName.format(new Date(`${month.month}-01T00:00:00Z`))),
            ...[month.low, month.value, month.high].map((value, index) => element('td', `py-2 pr-4 text-right font-mono text-[0.85rem] ${index === 1 ? 'font-semibold' : 'text-muted'}`, integer.format(value)))
          );
          return tr;
        })
      );
      trendCsv = ['month,low,forecast,high', ...months.map((month) => `${month.month},${Math.round(month.low)},${Math.round(month.value)},${Math.round(month.high)}`)].join('\n');
      trendBox!.hidden = false;
    }

    function drawChart(history: { week: string; clicks: number }[], forecast: { week: string; value: number; low: number; high: number }[]) {
      const svg = trendBox!.querySelector<SVGSVGElement>('[data-chart]')!;
      const tooltip = trendBox!.querySelector<HTMLElement>('[data-tooltip]')!;
      const width = 720;
      const height = 300;
      const margin = { top: 12, right: 12, bottom: 28, left: 52 };
      const points = [
        ...history.map((point) => ({ week: point.week, value: point.clicks, low: NaN, high: NaN, actual: true })),
        ...forecast.map((point) => ({ ...point, actual: false })),
      ];
      const maxValue = Math.max(...points.map((point) => (point.actual ? point.value : point.high))) || 1;
      const step = 10 ** Math.floor(Math.log10(maxValue / 4));
      const tick = [1, 2, 2.5, 5, 10].map((factor) => factor * step).find((candidate) => maxValue / candidate <= 4)!;
      const yMax = Math.ceil(maxValue / tick) * tick;
      const x = (index: number) => margin.left + (index / Math.max(1, points.length - 1)) * (width - margin.left - margin.right);
      const y = (value: number) => margin.top + (1 - value / yMax) * (height - margin.top - margin.bottom);

      svg.replaceChildren();
      for (let value = 0; value <= yMax + 1e-9; value += tick) {
        svg.append(svgElement('line', { x1: margin.left, x2: width - margin.right, y1: y(value), y2: y(value), class: 'forecast-grid' }));
        const label = svgElement('text', { x: margin.left - 8, y: y(value) + 4, 'text-anchor': 'end', class: 'forecast-axis' });
        label.textContent = compact.format(value);
        svg.append(label);
      }
      // Una etiqueta por mes (la semana que lo empieza), saltando las que quedarían a menos de 80 unidades de la anterior
      let lastLabelX = -Infinity;
      points.forEach((point, index) => {
        if (point.week.slice(8, 10) > '07' || x(index) - lastLabelX < 80) return;
        lastLabelX = x(index);
        const label = svgElement('text', { x: x(index), y: height - 8, 'text-anchor': 'middle', class: 'forecast-axis' });
        label.textContent = monthName.format(new Date(`${point.week.slice(0, 7)}-01T00:00:00Z`));
        svg.append(label);
      });

      const firstForecast = history.length;
      const band = [
        ...forecast.map((point, index) => `${x(firstForecast + index)},${y(point.high)}`),
        ...forecast.map((point, index) => `${x(firstForecast + index)},${y(point.low)}`).reverse(),
      ];
      svg.append(svgElement('polygon', { points: band.join(' '), class: 'forecast-band' }));
      const path = (items: { index: number; value: number }[]) => items.map((item, order) => `${order ? 'L' : 'M'}${x(item.index)},${y(item.value)}`).join('');
      svg.append(svgElement('path', { d: path(history.map((point, index) => ({ index, value: point.clicks }))), class: 'forecast-line forecast-line--actual' }));
      svg.append(svgElement('path', { d: path([{ index: firstForecast - 1, value: history.at(-1)!.clicks }, ...forecast.map((point, index) => ({ index: firstForecast + index, value: point.value }))]), class: 'forecast-line forecast-line--forecast' }));

      const crosshair = svgElement('line', { y1: margin.top, y2: height - margin.bottom, class: 'forecast-crosshair', visibility: 'hidden' });
      const marker = svgElement('circle', { r: 5, class: 'forecast-marker', visibility: 'hidden' });
      svg.append(crosshair, marker);
      svg.onpointermove = (event) => {
        const box = svg.getBoundingClientRect();
        const svgX = ((event.clientX - box.left) / box.width) * width;
        const index = Math.round(((svgX - margin.left) / (width - margin.left - margin.right)) * (points.length - 1));
        const point = points[Math.min(points.length - 1, Math.max(0, index))];
        const pointIndex = points.indexOf(point);
        crosshair.setAttribute('x1', String(x(pointIndex)));
        crosshair.setAttribute('x2', String(x(pointIndex)));
        marker.setAttribute('cx', String(x(pointIndex)));
        marker.setAttribute('cy', String(y(point.value)));
        marker.setAttribute('class', `forecast-marker ${point.actual ? 'forecast-marker--actual' : 'forecast-marker--forecast'}`);
        crosshair.setAttribute('visibility', 'visible');
        marker.setAttribute('visibility', 'visible');
        tooltip.replaceChildren(
          element('span', 'block text-xs text-muted', format(messages.weekOf, { date: dayName.format(new Date(`${point.week}T00:00:00Z`)) })),
          element('span', 'block font-semibold', `${point.actual ? messages.legendActual : messages.legendForecast}: ${integer.format(point.value)}`),
          ...(point.actual ? [] : [element('span', 'block text-xs text-muted', `${messages.legendBand}: ${integer.format(point.low)}–${integer.format(point.high)}`)])
        );
        tooltip.hidden = false;
        const left = (x(pointIndex) / width) * box.width;
        tooltip.style.left = `${Math.min(box.width - tooltip.offsetWidth, Math.max(0, left - tooltip.offsetWidth / 2))}px`;
      };
      svg.onpointerleave = () => {
        tooltip.hidden = true;
        crosshair.setAttribute('visibility', 'hidden');
        marker.setAttribute('visibility', 'hidden');
      };
    }

    function render() {
      if (queries.length === 0 && dates.length === 0) return;
      if (activeTab === 'scenario') renderScenario();
      else renderTrend();
    }

    function download(name: string, content: string) {
      const url = URL.createObjectURL(new Blob([content], { type: 'text/csv;charset=utf-8' }));
      const link = Object.assign(document.createElement('a'), { href: url, download: name });
      document.body.append(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    document.querySelector<HTMLButtonElement>('[data-export="scenario"]')!.addEventListener('click', () =>
      download(
        'forecast-escenario.csv',
        toCsv(
          ['query', 'impressions', 'clicks', 'position', 'new_position', 'projected_clicks', 'extra_clicks'],
          scenarioRows.map((row) => [row.query, row.impressions, row.clicks, row.position, row.newPosition, row.projectedClicks, row.extraClicks])
        )
      )
    );
    document.querySelector<HTMLButtonElement>('[data-export="trend"]')!.addEventListener('click', () => download('forecast-proyeccion.csv', trendCsv));

    tool.addEventListener('input', (event) => {
      if ((event.target as HTMLElement).matches('[data-file-input]')) return;
      render();
    });
  }
</script>

