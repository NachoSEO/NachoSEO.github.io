---
import Base from '../layouts/Base.astro';
---

<Base
  lang="es"
  title="404 — Nacho Mascort"
  description="Página no encontrada / Page not found"
  path="/404.html"
  noindex
>
  <div class="mx-auto max-w-2xl px-6 py-24">
    <p class="eyebrow">404</p>
    <h1 class="font-display mt-4 text-4xl font-bold">Página no encontrada</h1>
    <p class="mt-3 text-muted">
      Esta URL no existe. <a href="/" class="text-accent underline">Ir al inicio</a>
    </p>
    <h2 class="font-display mt-10 text-2xl font-bold" lang="en">Page not found</h2>
    <p class="mt-3 text-muted" lang="en">
      This URL doesn't exist. <a href="/en/" class="text-accent underline">Go home</a>
    </p>
  </div>
</Base>
