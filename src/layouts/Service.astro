---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import MetricsBar from '../components/service/MetricsBar.astro';
import ProblemSection from '../components/service/ProblemSection.astro';
import WorkflowBlueprint from '../components/service/WorkflowBlueprint.astro';
import EngagementTimeline from '../components/service/EngagementTimeline.astro';
import DeliverablesGrid from '../components/service/DeliverablesGrid.astro';
import BeforeAfter from '../components/service/BeforeAfter.astro';
import MaturityLadder from '../components/service/MaturityLadder.astro';
import Packages from '../components/service/Packages.astro';
import ComparisonTable from '../components/service/ComparisonTable.astro';
import FaqAccordion from '../components/service/FaqAccordion.astro';
import NextStepCta from '../components/service/NextStepCta.astro';
import { localizedRoute } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'services'>;
  path: string;
  alternatePath?: string;
}

const { entry, path, alternatePath } = Astro.props;
const lang = entry.data.lang as Lang;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());

const labels =
  lang === 'es'
    ? { services: 'Servicios', home: 'Inicio' }
    : { services: 'Services', home: 'Home' };

const serviceNode = {
  '@type': 'Service',
  name: entry.data.title,
  description: entry.data.description,
  serviceType: entry.data.title,
  provider: { '@id': `${Astro.site!.origin}/#person` },
  areaServed: 'Worldwide',
  availableLanguage: ['es', 'en'],
  url: new URL(path, Astro.site).href,
};

const serviceKey = entry.data.translationKey;
---

<Base
  lang={lang}
  title={`${entry.data.title} — Nacho Mascort`}
  description={entry.data.description}
  path={path}
  alternatePath={alternatePath}
  breadcrumbs={[
    { name: labels.home, path: localizedRoute('home', lang) },
    { name: labels.services, path: localizedRoute('services', lang) },
    { name: entry.data.title, path },
  ]}
  faq={entry.data.faq}
  extraSchemaNodes={[serviceNode]}
>
  <ServiceHero
    lang={lang}
    serviceKey={serviceKey}
    title={entry.data.title}
    tagline={entry.data.tagline}
  />

  <MetricsBar lang={lang} metrics={entry.data.metrics} proof={entry.data.proof} />

  <LogoMarquee lang={lang} />

  <ProblemSection lang={lang} problem={entry.data.problem} />

  <WorkflowBlueprint lang={lang} serviceKey={serviceKey} approach={entry.data.approach} />

  <EngagementTimeline lang={lang} serviceKey={serviceKey} timeline={entry.data.timeline} />

  <DeliverablesGrid lang={lang} serviceKey={serviceKey} deliverables={entry.data.deliverables} />

  {serviceKey === 'ai-automation' && <MaturityLadder lang={lang} />}
  {
    serviceKey !== 'ai-automation' && entry.data.transformation && (
      <BeforeAfter lang={lang} transformation={entry.data.transformation} />
    )
  }

  <Packages lang={lang} packages={entry.data.packages} />

  {entry.data.comparison && <ComparisonTable lang={lang} comparison={entry.data.comparison} />}

  {
    hasBody && (
      <div class="article-body mx-auto max-w-3xl px-6 pt-24">
        <Content />
      </div>
    )
  }

  <FaqAccordion lang={lang} faq={entry.data.faq} />

  <NextStepCta lang={lang} />
</Base>
