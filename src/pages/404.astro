---
import Base from '../layouts/Base.astro';
import { localizedRoute, useTranslations } from '../i18n/utils';

const es = useTranslations('es');
const en = useTranslations('en');
const linkClass = 'underline decoration-accent underline-offset-4 hover:text-accent-ink';
---

<Base lang="es" title="404 — Nacho Mascort" description="Página no encontrada / Page not found" path="/404.html" noindex>
  <div class="mx-auto max-w-5xl px-5 py-16 sm:px-6 md:py-24">
    <p class="meta">404</p>
    <h1 class="display-1 mt-5">{es('notFound.title')}</h1>
    <p class="mt-3 text-muted">
      {es('notFound.body')} <a href={localizedRoute('home', 'es')} class={linkClass}>{es('notFound.cta')}</a>
    </p>
    <h2 class="display-2 mt-14" lang="en">{en('notFound.title')}</h2>
    <p class="mt-3 text-muted" lang="en">
      {en('notFound.body')} <a href={localizedRoute('home', 'en')} class={linkClass}>{en('notFound.cta')}</a>
    </p>
  </div>
</Base>
