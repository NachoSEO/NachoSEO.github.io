---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionLabel from '../SectionLabel.astro';
import { caseBrands } from '../../data/case-brands';
import { localizedRoute } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  proofCases: { caseKey: string; summary: string }[];
}

const { lang, proofCases } = Astro.props;
const es = lang === 'es';
const casesBase = localizedRoute('cases', lang);
const allCases = await getCollection('caseStudies', (entry) => entry.data.lang === lang);

const items = proofCases
  .map((proof) => ({ proof, entry: allCases.find((entry) => entry.data.translationKey === proof.caseKey) }))
  .filter((item) => item.entry);
---

<section class="on-dark mt-16 md:mt-24">
  <div class="mx-auto max-w-5xl px-5 py-14 md:py-20 sm:px-6">
    <SectionLabel label={es ? 'Resultados' : 'Results'} />
    <h2 class="display-2 mt-3">{es ? 'Lo he hecho antes' : "I've done it before"}</h2>
    <div class:list={['mt-10 grid gap-5', items.length > 1 && 'md:grid-cols-2']}>
      {
        items.map(({ proof, entry }) => {
          const brand = caseBrands[proof.caseKey]?.brand;
          const [metric] = entry!.data.metrics;
          return (
            <a
              href={`${casesBase}${entry!.data.slug}/`}
              class="case-row group flex flex-col rounded-xl border border-white/15 p-7"
            >
              <span class="flex h-8 items-center">
                {brand?.kind === 'image' ? (
                  <Image
                    src={brand.mono}
                    alt={brand.alt}
                    height={28}
                    densities={[1, 2]}
                    class="case-logo w-auto"
                    style="height: 28px"
                  />
                ) : (
                  brand && <span class="case-logo font-display text-xl font-medium">{brand.text}</span>
                )}
              </span>
              {metric && (
                <p class="mt-6">
                  <span class="accent block font-display text-4xl font-medium tracking-tight">{metric.value}</span>
                  <span class="mt-1 block text-sm text-on-dark-muted">{metric.label}</span>
                </p>
              )}
              <p class="mt-5 flex-1 text-[0.95rem]">{proof.summary}</p>
              <p class="mt-6 text-[0.95rem] font-semibold">
                {es ? 'Leer el caso' : 'Read the case'} <span class="case-arrow inline-block" aria-hidden="true">→</span>
              </p>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
