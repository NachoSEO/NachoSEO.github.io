---
import { site } from '../../site';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  packages: { name: string; forWho: string; includes: string[]; note?: string; featured?: boolean }[];
}

const { lang, packages } = Astro.props;
const es = lang === 'es';
---

<section class="mx-auto max-w-5xl px-6 pt-24">
  <div class="reveal">
    <p class="eyebrow">{es ? 'formas de trabajar' : 'ways to work together'}</p>
    <h2 class="font-display mt-4 text-3xl font-bold tracking-tight">
      {es ? 'Elige el formato' : 'Pick the format'}
    </h2>
  </div>

  <div class:list={['mt-10 grid gap-6', packages.length === 3 ? 'lg:grid-cols-3' : 'sm:grid-cols-2']}>
    {
      packages.map((pack, index) => (
        <div
          class:list={[
            'card-lift tilt reveal relative flex flex-col rounded-2xl border p-6',
            pack.featured ? 'border-accent bg-raised' : 'border-line',
          ]}
          style={`--reveal-delay: ${index * 110}ms`}
        >
          {pack.featured && (
            <p class="absolute -top-3 left-6 rounded-full bg-accent px-3 py-0.5 font-mono text-[10px] font-medium text-paper">
              {es ? 'más habitual' : 'most common'}
            </p>
          )}
          <h3 class="font-display text-xl font-bold">{pack.name}</h3>
          <p class="mt-1 text-sm text-muted">{pack.forWho}</p>
          <ul class="mt-4 flex-1 space-y-2">
            {pack.includes.map((item, itemIndex) => (
              <li class="flex items-start gap-2 text-sm">
                <span
                  class="check-pop mt-0.5 text-accent"
                  style={`--d: ${300 + itemIndex * 120}ms`}
                  aria-hidden="true"
                >
                  ✓
                </span>
                {item}
              </li>
            ))}
          </ul>
          {pack.note && <p class="mt-3 font-mono text-xs text-muted">{pack.note}</p>}
          <a
            href={site.calUrl}
            class:list={[
              'mt-5 rounded-full px-6 py-2.5 text-center text-sm font-medium',
              pack.featured
                ? 'btn-cta'
                : 'border border-line hover:border-accent hover:text-accent',
            ]}
          >
            {es ? 'Hablemos de este formato' : "Let's talk about this format"}
          </a>
        </div>
      ))
    }
  </div>

  <p class="reveal mt-6 font-mono text-xs text-muted" style="--reveal-delay: 300ms">
    {es
      ? '— Horas senior. Sin juniors ni subcontratas. El precio se concreta en la llamada, según alcance.'
      : '— Senior hours. No juniors, no subcontracting. Pricing is set on the call, based on scope.'}
  </p>
</section>
