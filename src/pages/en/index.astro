---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import IsoFactory from '../../components/IsoFactory.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import SystemPanel from '../../components/SystemPanel.astro';
import { site } from '../../site';

const services = (await getCollection('services', (entry) => entry.data.lang === 'en')).sort(
  (a, b) => a.data.order - b.data.order
);

const stats = [
  { value: '1B+', label: 'annual users in portfolio' },
  { value: '2M', label: 'daily visits (peak)' },
  { value: '0→20M', label: 'sessions/mo in 2 years' },
  { value: '+40%', label: 'organic traffic YoY' },
];

const process = [
  {
    step: '01',
    title: 'Diagnosis',
    detail:
      "A call and an analysis of your operation: where time gets lost, which channel performs, and the smallest system that moves the needle.",
  },
  {
    step: '02',
    title: 'Minimum system',
    detail:
      'I build the first version in weeks, not quarters: one automated process or one channel in order, running and measured.',
  },
  {
    step: '03',
    title: 'Scale and handover',
    detail:
      "What works gets expanded; what doesn't gets cut. In the end, the system and its docs are yours — not a dependency on me.",
  },
];
---

<Base
  lang="en"
  title="Nacho Mascort — Growth, AI & SEO that run as a system"
  description="Fractional Head of Growth, AI systems and SEO/GEO consulting. I've led sites with 2M daily visits and I build AI systems that execute growth work. Book a call."
  path="/en/"
  alternatePath="/"
>
  <section class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="glow-orb parallax-slow absolute -top-32 left-[8%] h-96 w-96" aria-hidden="true">
    </div>
    <div class="glow-orb parallax-fast absolute top-40 right-[-6%] h-72 w-72" aria-hidden="true">
    </div>

    <div class="hero-seq relative mx-auto max-w-5xl px-6 pt-24">
      <p class="eyebrow">growth · ai · seo</p>
      <h1 class="font-display mt-5 max-w-3xl text-5xl font-light tracking-tight sm:text-7xl">
        Scale your growth <b class="font-semibold">without scaling your headcount</b>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        I'm Nacho Mascort. I've led organic growth for sites with up to
        <strong class="text-ink">2 million visits a day</strong>, and now I build AI systems that
        execute that work. Even Google engineers have hired me to do their SEO.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={site.calUrl}
          class="btn-cta px-8 py-3 font-medium"
        >
          Book a call
        </a>
        <a href="/en/services/" class="font-medium text-accent hover:underline"> See services → </a>
      </div>
    </div>

    <IsoFactory lang="en" />
  </section>

  <LogoMarquee lang="en" />

  <section class="mx-auto max-w-5xl px-6 pt-16" aria-label="Numbers">
    <dl class="grid grid-cols-2 gap-6 sm:grid-cols-4">
      {
        stats.map((stat, index) => (
          <div class="reveal" style={`--reveal-delay: ${index * 90}ms`}>
            <dt class="font-mono text-xs text-muted">{stat.label}</dt>
            <dd class="font-display mt-1 text-3xl font-bold text-accent">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-5xl px-6 pt-24">
    <div class="reveal">
      <p class="eyebrow">services</p>
      <h2 class="font-display mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        Four ways to work with me
      </h2>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        services.map((service, index) => (
          <a
            href={`/en/services/${service.data.slug}/`}
            class="group card-lift tilt reveal rounded-2xl border border-line p-6 hover:border-accent"
            data-tilt-max="6"
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <h3 class="font-display text-xl font-bold group-hover:text-accent">
              {service.data.title}
            </h3>
            <p class="mt-2 text-sm text-muted">{service.data.tagline}</p>
          </a>
        ))
      }
    </div>
  </section>

  <SystemPanel lang="en" />

  <section class="mx-auto max-w-5xl px-6 pt-24">
    <div class="reveal">
      <p class="eyebrow">how I work</p>
      <h2 class="font-display mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        From diagnosis to system in three steps
      </h2>
    </div>
    <ol class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        process.map((item, index) => (
          <li class="reveal rounded-2xl bg-raised p-6" style={`--reveal-delay: ${index * 110}ms`}>
            <p class="font-mono text-xs text-accent">{item.step}</p>
            <h3 class="font-display mt-2 text-lg font-bold">{item.title}</h3>
            <p class="mt-2 text-sm text-muted">{item.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-5xl px-6 pt-24">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">teaching</p>
      <p class="mt-4 text-lg">
        8+ years teaching what I execute: professor at
        <strong>Universitat Pompeu Fabra's Master in Search Engines</strong> and
        <strong>Webpositer Academy's SEO Master</strong>. Speaker at SEOnTheBeach, Clinic SEO and
        SEOPLUS.
      </p>
      <a href="/en/about/" class="mt-4 inline-block font-medium text-accent hover:underline">
        My full track record →
      </a>
    </div>
  </section>

  <Cta lang="en" title="Tell me what you want to grow" />
</Base>
