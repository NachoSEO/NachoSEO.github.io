---
/**
 * Miniatura ilustrativa de un entregable (tabla, hoja de ruta, ticket, panel…), elegida por el título.
 * Son maquetas con datos de ejemplo, para que se vea qué forma tiene lo que te llevas.
 */
interface Props {
  title: string;
  lang?: 'es' | 'en';
}

const { title, lang = 'es' } = Astro.props;
const en = lang === 'en';
const t = title.toLowerCase();

// Los títulos de los entregables se escriben en cada idioma: la detección vale para los dos
const kind = (() => {
  if (/fan-out/.test(t)) return 'fanout';
  if (/medición de partida|baseline measurement/.test(t)) return 'presence';
  if (/fuentes|menciones|sources?|mentions/.test(t)) return 'sources';
  if (/hreflang|estructura internacional|international structure/.test(t)) return 'hreflang';
  if (/demanda por mercado|expansión|demand by market|expansion/.test(t)) return 'markets';
  if (/inventario|mapa de redirecciones|inventory|redirect map/.test(t)) return 'redirects';
  if (/rastreo e indexación|crawling and indexing/.test(t)) return 'crawl';
  if (/quality|calidad/.test(t)) return 'scores';
  if (/hoja de ruta|plan|roadmap/.test(t)) return 'roadmap';
  if (/staging/.test(t)) return 'staging';
  if (/lanzamiento|^(supported )?launch/.test(t)) return 'launch';
  if (/revisión de cambios|review of changes/.test(t)) return 'ticket';
  if (/medición|seguimiento|measurement|monitoring/.test(t)) return 'metrics';
  if (/método|documentado|method|documented/.test(t)) return 'doc';
  if (/sesión|session/.test(t)) return 'session';
  if (/page type|diagnóstico|auditoría|caída|diagnosis|audit|drop/.test(t)) return 'table';
  return 'checklist';
})();

const copy = en
  ? {
      table: [['Categories', 92, '€72,200'], ['Product pages', 48, '€36,400'], ['Blog', 6, '€3,050']],
      crawl: ['Indexed', 'Discovered', 'Crawled'],
      scores: ['Effort', 'Originality', 'Talent', 'Accuracy'],
      ticket: ['SEO-142 · In review', 'Noindex on filters without demand', 'Canonical and meta robots', 'No block in robots.txt', 'Internal linking'],
      staging: ['staging.example.com · review', 'Indexable, no inherited noindex', 'Canonicals to the new URLs', 'Content visible without JavaScript'],
      launch: ['/old/sneakers', 'new URLs'],
      presence: ['Answers that name you', '12%'],
      metrics: ['Indexed', '28,100'],
      doc: 'SEO QA process',
      session: ['Team session · 60 min', 'Issues in order of impact', 'Who fixes each one', 'Questions answered'],
      redirects: ['/old/sneakers', '/sneakers/', '/old/red-sneakers', '/sneakers/red/', '/old/offer-2019'],
      hreflang: ['example.es', 'example.mx', 'example.com'],
      markets: [['Spain', 88], ['Mexico', 64], ['Argentina', 31]],
      fanout: ['"best seo consultants spain"', 'site:example.com case studies clients', '"[brand] reviews experience"'],
      sources: [['Industry media', 74], ['Lists and rankings', 52], ['Profiles', 33]],
      checklist: ['Case studies with data', 'Who you are and what you have done', 'Structured data'],
    }
  : {
      table: [['Categorías', 92, '72.200 €'], ['Fichas', 48, '36.400 €'], ['Blog', 6, '3.050 €']],
      crawl: ['Indexada', 'Descubierta', 'Rastreada'],
      scores: ['Esfuerzo', 'Originalidad', 'Talento', 'Exactitud'],
      ticket: ['SEO-142 · En revisión', 'Noindex en filtros sin demanda', 'Canonical y meta robots', 'Sin bloqueo en robots.txt', 'Enlazado interno'],
      staging: ['staging.ejemplo.com · revisión', 'Indexable y sin noindex heredado', 'Canonicals a las URLs nuevas', 'Contenido visible sin JavaScript'],
      launch: ['/old/zapatillas', 'URLs nuevas'],
      presence: ['Respuestas que te nombran', '12 %'],
      metrics: ['Indexadas', '28.100'],
      doc: 'Proceso de QA de SEO',
      session: ['Sesión con el equipo · 60 min', 'Problemas por orden de impacto', 'Quién arregla cada uno', 'Dudas resueltas'],
      redirects: ['/old/zapatillas', '/zapatillas/', '/old/zapatillas-rojas', '/zapatillas/rojas/', '/old/oferta-2019'],
      hreflang: ['ejemplo.es', 'ejemplo.mx', 'ejemplo.com'],
      markets: [['España', 88], ['México', 64], ['Argentina', 31]],
      fanout: ['"mejores consultores seo españa"', 'site:ejemplo.com casos clientes', '"[marca] opiniones experiencia"'],
      sources: [['Medios del sector', 74], ['Listas y rankings', 52], ['Perfiles', 33]],
      checklist: ['Casos con datos', 'Quién eres y qué has hecho', 'Datos estructurados'],
    };
const tableRows = copy.table.map(([name, width, value]) => ({ name, width, value }));
---

<div class="dp" aria-hidden="true">
  <div class="dp-bar"><i></i><i></i><i></i></div>
  <div class="dp-body">
    {
      kind === 'table' && (
        <div class="dp-rows">
          {tableRows.map((row) => (
            <div class="dp-row">
              <span>{row.name}</span>
              <span class="dp-track"><span style={`width: ${row.width}%`} /></span>
              <span class="dp-num">{row.value}</span>
            </div>
          ))}
        </div>
      )
    }
    {
      kind === 'crawl' && (
        <div class="dp-stack">
          <span class="dp-seg ok" style="flex: 41">{copy.crawl[0]}</span>
          <span class="dp-seg crawl" style="flex: 41">{copy.crawl[1]}</span>
          <span class="dp-seg bad" style="flex: 18">{copy.crawl[2]}</span>
        </div>
      )
    }
    {
      kind === 'scores' && (
        <div class="dp-rows">
          {[
            [copy.scores[0], 3],
            [copy.scores[1], 2],
            [copy.scores[2], 3],
            [copy.scores[3], 4],
          ].map(([name, score]) => (
            <div class="dp-row">
              <span>{name}</span>
              <span class="dp-dots">{[1, 2, 3, 4].map((dot) => <i class:list={[dot <= Number(score) && 'on']} />)}</span>
              <span class="dp-num">{score}/4</span>
            </div>
          ))}
        </div>
      )
    }
    {
      kind === 'roadmap' && (
        <div class="dp-gantt">
          {[
            [0, 2, 'seo'],
            [1, 3, 'tech'],
            [3, 2, 'content'],
            [4, 2, 'seo'],
          ].map(([start, span, team]) => (
            <span class={`dp-g ${team}`} style={`grid-column: ${Number(start) + 1} / span ${span}`} />
          ))}
        </div>
      )
    }
    {
      kind === 'ticket' && (
        <div class="dp-ticket">
          <p class="dp-mono">{copy.ticket[0]}</p>
          <p class="dp-strong">{copy.ticket[1]}</p>
          <p class="dp-check on">{copy.ticket[2]}</p>
          <p class="dp-check on">{copy.ticket[3]}</p>
          <p class="dp-check">{copy.ticket[4]}</p>
        </div>
      )
    }
    {
      kind === 'staging' && (
        <div class="dp-session">
          <p class="dp-mono">{copy.staging[0]}</p>
          <p class="dp-check on">{copy.staging[1]}</p>
          <p class="dp-check on">{copy.staging[2]}</p>
          <p class="dp-check">{copy.staging[3]}</p>
        </div>
      )
    }
    {
      kind === 'launch' && (
        <div class="dp-redirects dp-mono">
          <p><span>{copy.launch[0]}</span> → 301 ✓</p>
          <p><span>robots.txt</span> → 200 ✓</p>
          <p><span>sitemap.xml</span> → {copy.launch[1]} ✓</p>
        </div>
      )
    }
    {
      kind === 'presence' && (
        <div class="dp-metrics">
          <div>
            <p class="dp-mono">{copy.presence[0]}</p>
            <p class="dp-big">{copy.presence[1]}</p>
          </div>
          <svg viewBox="0 0 100 36" class="dp-spark">
            <polyline points="0,30 20,31 35,28 50,29 65,24 80,22 100,17" />
          </svg>
        </div>
      )
    }
    {
      kind === 'metrics' && (
        <div class="dp-metrics">
          <div>
            <p class="dp-mono">{copy.metrics[0]}</p>
            <p class="dp-big">{copy.metrics[1]}</p>
          </div>
          <svg viewBox="0 0 100 36" class="dp-spark">
            <polyline points="0,32 20,31 35,30 50,26 65,18 80,11 100,4" />
          </svg>
        </div>
      )
    }
    {
      kind === 'doc' && (
        <div class="dp-doc">
          <p class="dp-strong">{copy.doc}</p>
          <span style="width: 90%" />
          <span style="width: 75%" />
          <span style="width: 82%" />
          <span style="width: 60%" />
        </div>
      )
    }
    {
      kind === 'session' && (
        <div class="dp-session">
          <p class="dp-mono">{copy.session[0]}</p>
          <p class="dp-check on">{copy.session[1]}</p>
          <p class="dp-check on">{copy.session[2]}</p>
          <p class="dp-check on">{copy.session[3]}</p>
        </div>
      )
    }
    {
      kind === 'redirects' && (
        <div class="dp-redirects dp-mono">
          <p><span>{copy.redirects[0]}</span> → {copy.redirects[1]}</p>
          <p><span>{copy.redirects[2]}</span> → {copy.redirects[3]}</p>
          <p><span>{copy.redirects[4]}</span> → 410</p>
        </div>
      )
    }
    {
      kind === 'hreflang' && (
        <div class="dp-redirects dp-mono">
          <p>hreflang="es-ES" → {copy.hreflang[0]}</p>
          <p>hreflang="es-MX" → {copy.hreflang[1]}</p>
          <p>hreflang="x-default" → {copy.hreflang[2]}</p>
        </div>
      )
    }
    {
      kind === 'markets' && (
        <div class="dp-rows">
          {copy.markets.map(([name, width]) => (
            <div class="dp-row">
              <span>{name}</span>
              <span class="dp-track"><span style={`width: ${width}%`} /></span>
            </div>
          ))}
        </div>
      )
    }
    {
      kind === 'fanout' && (
        <div class="dp-redirects dp-mono">
          {copy.fanout.map((query) => <p>{query}</p>)}
        </div>
      )
    }
    {
      kind === 'sources' && (
        <div class="dp-rows">
          {copy.sources.map(([name, width]) => (
            <div class="dp-row">
              <span>{name}</span>
              <span class="dp-track"><span style={`width: ${width}%`} /></span>
            </div>
          ))}
        </div>
      )
    }
    {
      kind === 'checklist' && (
        <div class="dp-session">
          <p class="dp-check on">{copy.checklist[0]}</p>
          <p class="dp-check on">{copy.checklist[1]}</p>
          <p class="dp-check">{copy.checklist[2]}</p>
        </div>
      )
    }
  </div>
</div>

<style>
  .dp {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    background: var(--color-paper);
    font-size: 0.68rem;
    line-height: 1.35;
  }
  .dp-bar {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-line);
    padding: 0.35rem 0.5rem;
  }
  .dp-bar i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-line);
  }
  .dp-body {
    min-height: 5.6rem;
    padding: 0.6rem 0.7rem;
  }
  .dp-rows {
    display: grid;
    gap: 0.4rem;
  }
  .dp-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
  }
  .dp-track {
    height: 0.45rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-line);
  }
  .dp-track span {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }
  .dp-num,
  .dp-mono {
    font-family: var(--font-mono);
    color: var(--color-muted);
  }
  .dp-stack {
    display: flex;
    gap: 2px;
    overflow: hidden;
    margin-top: 1.2rem;
    border-radius: 0.3rem;
  }
  .dp-seg {
    padding: 0.35rem 0.3rem;
    color: #fff;
    font-size: 0.6rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .ok {
    background: #2f6f4f;
  }
  .crawl,
  .tech {
    background: var(--color-ink);
  }
  .bad,
  .seo {
    background: var(--color-accent);
  }
  .content {
    background: #6b5ca5;
  }
  .dp-dots {
    display: flex;
    gap: 0.2rem;
  }
  .dp-dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-line);
  }
  .dp-dots i.on {
    background: var(--color-accent);
  }
  .dp-gantt {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.35rem 0.2rem;
    padding-top: 0.2rem;
  }
  .dp-g {
    height: 0.75rem;
    border-radius: 0.2rem;
  }
  .dp-ticket,
  .dp-session,
  .dp-doc {
    display: grid;
    gap: 0.25rem;
  }
  .dp-strong {
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .dp-check::before {
    content: '○';
    margin-right: 0.35rem;
    color: var(--color-muted);
  }
  .dp-check.on::before {
    content: '✓';
    color: var(--color-accent-ink);
  }
  .dp-metrics {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: 0.8rem;
  }
  .dp-big {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .dp-spark polyline {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.5;
  }
  .dp-doc span {
    display: block;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-line);
  }
  .dp-redirects {
    display: grid;
    gap: 0.35rem;
    font-size: 0.64rem;
  }
  .dp-redirects span {
    color: var(--color-ink);
  }
</style>
