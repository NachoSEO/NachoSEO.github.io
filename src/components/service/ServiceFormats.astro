---
import SectionLabel from '../SectionLabel.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  formats: { name: string; detail: string }[];
  pricing: string;
  availability?: string;
}

const { lang, formats, pricing, availability } = Astro.props;
const es = lang === 'es';
---

<section class="mx-auto max-w-5xl px-5 pt-24 sm:px-6">
  <SectionLabel label={es ? 'Formatos' : 'Formats'} />
  <h2 class="display-2 mt-3">{es ? 'Cómo podemos trabajar' : 'How we can work together'}</h2>
  <div class:list={['mt-10 grid gap-5', formats.length > 1 && 'md:grid-cols-2']}>
    {
      formats.map((format) => (
        <div class="card">
          <h3 class="display-3">{format.name}</h3>
          <p class="mt-3 text-[0.95rem] text-muted">{format.detail}</p>
        </div>
      ))
    }
  </div>
  <div class="mt-8 grid max-w-[65ch] gap-4 text-[0.95rem]">
    <p>{pricing}</p>
    {availability && <p class="font-semibold">{availability}</p>}
  </div>
</section>
