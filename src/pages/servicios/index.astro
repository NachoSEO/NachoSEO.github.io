---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import SectionLabel from '../../components/SectionLabel.astro';

// Los servicios de SEO técnico y GEO van primero (order < 7); growth, IA y formación, en un bloque aparte
const services = (await getCollection('services', (entry) => entry.data.lang === 'es')).sort(
  (a, b) => a.data.order - b.data.order
);
const seoServices = services.filter((service) => service.data.order < 7);
const otherServices = services.filter((service) => service.data.order >= 7);
---

<Base
  lang="es"
  title="Servicios de SEO técnico y GEO — Nacho Mascort"
  description="Auditoría, migraciones, SEO internacional, recuperar tráfico tras un core update, GEO y consultoría SEO técnica. Trabajas directamente conmigo."
  path="/servicios/"
  alternatePath="/en/services/"
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/servicios/' },
  ]}
>
  <div class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
    <p class="meta">Servicios</p>
    <h1 class="display-1 mt-5">Servicios de SEO técnico y GEO</h1>
    <p class="lede mt-6 max-w-[62ch]">Para webs con tráfico en juego y problemas caros: caídas, migraciones, varios idiomas, una web que crece sin control o una competencia a la que ya recomienda la IA. En todos trabajas directamente conmigo.</p>
    <p class="mt-5 text-[0.95rem]">
      <a href="/servicios/precios/" class="link-arrow">Cuánto cuesta y cómo calculo el precio</a>
    </p>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        seoServices.map((service) => (
          <a href={`/servicios/${service.data.slug}/`} class="card flex flex-col">
            <h2 class="card-title display-3 transition-colors">{service.data.title}</h2>
            <p class="mt-3 text-[0.95rem]">{service.data.tagline}</p>
            <p class="mt-3 flex-1 text-sm text-muted">{service.data.proof}</p>
            <p class="link-arrow mt-5 text-[0.95rem]">Ver servicio</p>
          </a>
        ))
      }
    </div>
  </div>

  <section id="otros" class="mx-auto max-w-5xl scroll-mt-24 px-5 pt-16 md:pt-24 sm:px-6">
    <SectionLabel label="Otros servicios" />
    <h2 class="display-2 mt-3">Growth, IA y formación</h2>
    <ul class="row-list mt-8">
      {
        otherServices.map((service) => (
          <li>
            <a href={`/servicios/${service.data.slug}/`} class="row-link group grid gap-1 py-5 sm:grid-cols-[16rem_1fr] sm:gap-6 sm:px-2">
              <span class="row-title display-3 transition-colors">{service.data.title}</span>
              <span class="text-[0.95rem] text-muted">{service.data.tagline}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Cta lang="es" />
</Base>
