---
import Base from '../../layouts/Base.astro';
import AboutPage from '../../components/AboutPage.astro';
import { aboutPage } from '../../data/profile';
---

<Base
  lang="en"
  title="About — Nacho Mascort"
  description={aboutPage.en.description}
  path="/en/about/"
  alternatePath="/sobre-mi/"
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'About', path: '/en/about/' },
  ]}
  extraSchemaNodes={[
    { '@type': 'ProfilePage', url: new URL('/en/about/', Astro.site).href, mainEntity: { '@id': `${Astro.site!.origin}/#person` } },
  ]}
>
  <AboutPage lang="en" />
</Base>
