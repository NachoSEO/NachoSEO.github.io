---
/** Los tres niveles de la metodología (theme, iniciativa y tarea) con el ejemplo de plan.ts, en formato compacto */
import { initiatives, tasks, teams, theme } from './plan';
---

<figure class="method-levels not-prose my-10">
  <div class="ml-theme">
    <span class="ml-level">Theme o milestone</span>
    <div>
      <p class="ml-title">{theme.title}</p>
      <p class="ml-sub">OKR: {theme.okr}</p>
    </div>
  </div>
  <div class="ml-initiatives">
    {
      initiatives.map((initiative, index) => (
        <div class="ml-initiative">
          <span class="ml-level">Iniciativa</span>
          <p class="ml-title">{initiative.title}</p>
          <p class="ml-sub">Métrica: {initiative.metric}</p>
          <ul>
            {tasks
              .filter((task) => task.initiative === index)
              .map((task) => (
                <li>
                  <i style={`--team: ${teams[task.team].color}`} title={teams[task.team].label} aria-hidden="true" />
                  {task.title}
                  <span class="ml-team">{teams[task.team].label}</span>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </div>
  <figcaption>El problema de las fichas convertido en plan: un theme o milestone con su OKR, dos iniciativas con su métrica y once tareas de cinco equipos.</figcaption>
</figure>

<style>
  @layer components {
    figure.method-levels ul {
      list-style: none;
      padding-left: 0;
      margin-top: 0.5rem;
    }
    figure.method-levels li + li {
      margin-top: 0;
    }
    figure.method-levels p {
      margin-top: 0;
    }
  }
  .method-levels {
    font-size: 0.82rem;
    line-height: 1.4;
  }
  .ml-theme {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    border-radius: 0.75rem 0.75rem 0 0;
    background: var(--color-dark);
    color: var(--color-on-dark);
    padding: 0.7rem 0.9rem;
  }
  .ml-theme .ml-level {
    color: var(--color-accent-on-dark);
  }
  .ml-theme .ml-sub {
    color: var(--color-on-dark-muted);
  }
  .ml-initiatives {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    border: 1px solid var(--color-line);
    border-top: 0;
    border-radius: 0 0 0.75rem 0.75rem;
    background: var(--color-line);
    overflow: hidden;
  }
  .ml-initiative {
    background: var(--color-raised);
    padding: 0.7rem 0.9rem;
  }
  .ml-level {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }
  .ml-title {
    font-weight: 650;
    font-size: 0.92rem;
  }
  .ml-sub {
    color: var(--color-muted);
  }
  .ml-initiative ul {
    display: grid;
    gap: 0.2rem;
  }
  .ml-initiative li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .ml-initiative i {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 0.15rem;
    background: var(--team);
  }
  .ml-team {
    margin-left: auto;
    padding-left: 0.5rem;
    color: var(--color-muted);
    font-size: 0.7rem;
    white-space: nowrap;
  }
  .method-levels figcaption {
    margin-top: 0.6rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }
</style>
