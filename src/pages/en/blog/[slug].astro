---
import { getCollection } from 'astro:content';
import Post from '../../../layouts/Post.astro';

export async function getStaticPaths() {
  const enPosts = await getCollection('blog', (entry) => entry.data.lang === 'en');
  const esPosts = await getCollection('blog', (entry) => entry.data.lang === 'es');

  return enPosts.map((entry) => {
    const translation = esPosts.find(
      (candidate) => candidate.data.translationKey === entry.data.translationKey
    );
    return {
      params: { slug: entry.data.slug },
      props: { entry, translationSlug: translation?.data.slug },
    };
  });
}

const { entry, translationSlug } = Astro.props;
const path = `/en/blog/${entry.data.slug}/`;
const alternatePath = translationSlug ? `/blog/${translationSlug}/` : undefined;
---

<Post entry={entry} path={path} alternatePath={alternatePath} />
