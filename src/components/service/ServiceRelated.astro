---
import SectionLabel from '../SectionLabel.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  related: { title: string; href: string; note: string }[];
}

const { lang, related } = Astro.props;
const es = lang === 'es';
---

<section class="mx-auto max-w-5xl px-5 pt-16 md:pt-24 sm:px-6">
  <SectionLabel label={es ? 'Para leer antes de hablar' : 'Worth reading first'} />
  <ul class="row-list mt-6">
    {
      related.map((item) => (
        <li>
          <a href={item.href} class="row-link group grid gap-1 py-5 sm:grid-cols-[1fr_1fr] sm:gap-6 sm:px-2">
            <span class="row-title font-semibold transition-colors">{item.title}</span>
            <span class="text-[0.95rem] text-muted">{item.note}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
