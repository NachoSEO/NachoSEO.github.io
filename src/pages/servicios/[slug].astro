---
import { getCollection } from 'astro:content';
import Service from '../../layouts/Service.astro';

export async function getStaticPaths() {
  const esServices = await getCollection('services', (entry) => entry.data.lang === 'es');
  const enServices = await getCollection('services', (entry) => entry.data.lang === 'en');

  return esServices.map((entry) => {
    const translation = enServices.find(
      (candidate) => candidate.data.translationKey === entry.data.translationKey
    );
    return {
      params: { slug: entry.data.slug },
      props: { entry, translationSlug: translation?.data.slug },
    };
  });
}

const { entry, translationSlug } = Astro.props;
const path = `/servicios/${entry.data.slug}/`;
const alternatePath = translationSlug ? `/en/services/${translationSlug}/` : undefined;
---

<Service entry={entry} path={path} alternatePath={alternatePath} />
