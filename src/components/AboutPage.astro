---
import { Image } from 'astro:assets';
import AboutCredentials from './AboutCredentials.astro';
import Cta from './Cta.astro';
import SectionLabel from './SectionLabel.astro';
import aboutPhoto from '../assets/img/nacho-about.jpg';
import { aboutPage, bio, projects, timeline } from '../data/profile';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy =
  lang === 'es'
    ? { label: 'Sobre mí', cv: 'Descargar CV (PDF)', photoAlt: 'Retrato de Nacho Mascort', track: 'Trayectoria', projects: 'Proyectos' }
    : { label: 'About', cv: 'Download CV (PDF)', photoAlt: 'Portrait of Nacho Mascort', track: 'Track record', projects: 'Projects' };
---

<article class="mx-auto max-w-5xl px-5 pt-16 sm:px-6 sm:pt-20">
  <p class="meta">{copy.label}</p>
  <div class="mt-5 grid gap-10 md:grid-cols-[1.4fr_1fr] md:gap-14">
    <div>
      <h1 class="display-1">{aboutPage[lang].title}</h1>
      <div class="mt-8 max-w-[62ch] space-y-5 text-[1.05rem] leading-relaxed">
        {
          bio[lang].map((paragraph) => (
            <p>{paragraph.map((segment) => (segment.strong ? <strong>{segment.text}</strong> : segment.text))}</p>
          ))
        }
      </div>
      <a href="/cv/nacho-mascort-cv.pdf" download="nacho-mascort-cv.pdf" class="link-arrow mt-8 inline-block">
        {copy.cv}
      </a>
    </div>
    <Image
      src={aboutPhoto}
      alt={copy.photoAlt}
      widths={[400, 800]}
      sizes="(min-width: 768px) 22rem, 90vw"
      loading="eager"
      class="aspect-[4/5] w-full max-w-[22rem] rounded-2xl object-cover md:self-start"
    />
  </div>

  <section class="mt-16 md:mt-24">
    <SectionLabel label={copy.track} asHeading />
    <ol class="row-list mt-8">
      {
        timeline[lang].map((item) => (
          <li class="grid gap-1 py-5 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <span class="meta pt-1">{item.period}</span>
            <div>
              <h3 class="font-semibold">{item.role}</h3>
              <p class="mt-1.5 max-w-[65ch] text-[0.95rem] text-muted">{item.detail}</p>
              {item.results && (
                <ul class="mt-3 max-w-[65ch] list-disc space-y-1.5 pl-5 text-[0.95rem] marker:text-accent">
                  {item.results.map((result) => <li>{result}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-16 md:mt-24">
    <SectionLabel label={copy.projects} asHeading />
    <ul class="row-list mt-8">
      {
        projects[lang].map((project) => (
          <li>
            <a href={project.url} rel="noopener" class="row-link group grid gap-1 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6 sm:px-2">
              <span class="row-title display-3 transition-colors">{project.name}</span>
              <p class="text-[0.95rem] text-muted">{project.detail}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <AboutCredentials lang={lang} />
</article>

<Cta lang={lang} />
