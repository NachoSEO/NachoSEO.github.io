---
import Base from '../layouts/Base.astro';
---

<Base
  lang="es"
  title="404 — Nacho Mascort"
  description="Página no encontrada / Page not found"
  path="/404.html"
  noindex
>
  <div class="mx-auto max-w-5xl px-5 sm:px-6 py-24">
    <p class="meta">404</p>
    <h1 class="display-1 mt-5">Página no encontrada</h1>
    <p class="mt-3 text-muted">
      Esta URL no existe. <a href="/" class="underline decoration-accent underline-offset-4 hover:text-accent-ink">Ir al inicio</a>
    </p>
    <h2 class="display-2 mt-14" lang="en">Page not found</h2>
    <p class="mt-3 text-muted" lang="en">
      This URL doesn't exist. <a href="/en/" class="underline decoration-accent underline-offset-4 hover:text-accent-ink">Go home</a>
    </p>
  </div>
</Base>
