---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';

const copy = es
  ? {
      signals: 'señales',
      agent: 'agente',
      actions: 'acciones',
      results: 'resultados',
      feedA: ['keywords', 'competencia', 'rendimiento'],
      feedB: ['investiga', 'produce', 'publica'],
      feedC: ['contenido', 'ads', 'crm'],
      sessions: 'sesiones/mes',
      adsWeek: 'ads/semana',
    }
  : {
      signals: 'signals',
      agent: 'agent',
      actions: 'actions',
      results: 'results',
      feedA: ['keywords', 'competitors', 'performance'],
      feedB: ['research', 'produce', 'publish'],
      feedC: ['content', 'ads', 'crm'],
      sessions: 'sessions/mo',
      adsWeek: 'ads/week',
    };

const packets = [
  // señales → agente
  { left: 130, top: 105, dx: 120, dy: 85, pt: '4.2s', pd: '0s' },
  { left: 130, top: 105, dx: 120, dy: 85, pt: '4.2s', pd: '2.1s' },
  // agente → acciones
  { left: 340, top: 190, dx: 110, dy: -85, pt: '4.6s', pd: '1.4s' },
  { left: 340, top: 190, dx: 110, dy: -85, pt: '4.6s', pd: '3.6s' },
  // agente → resultados
  { left: 340, top: 210, dx: 115, dy: 105, pt: '5s', pd: '2.6s' },
];

const bots = [
  // patrulla inferior: izquierda → resultados
  { left: 46, top: 320, dx: 300, dy: -80, pt: '9s', pd: '0.8s' },
  // retorno superior: acciones → señales
  { left: 480, top: 52, dx: -330, dy: 55, pt: '10s', pd: '3.5s' },
  // columna central: de arriba a abajo
  { left: 300, top: 26, dx: -46, dy: 300, pt: '11s', pd: '6s' },
];

const ghostPads = [
  { left: 150, top: 250, width: 54, height: 38 },
  { left: 480, top: 200, width: 54, height: 38 },
  { left: 250, top: 330, width: 54, height: 38 },
];
---

<div
  class="iso-stage tilt relative mx-auto mt-2 h-[340px] max-w-5xl px-6 sm:h-[460px]"
  data-tilt-max="4"
  aria-hidden="true"
>
  <!-- métricas flotando sobre la escena -->
  <div class="iso-float inline-flex left-[2%] top-[4%] sm:left-[5%]" style="--fd: 0s">
    <span class="text-[#34d399]">▲</span>
    <span class="cycle-3 font-bold text-accent">
      <span>2M</span>
      <span>9M</span>
      <span>20M</span>
    </span>
    <span class="text-muted">{copy.sessions}</span>
  </div>
  <div class="iso-float top-[14%] right-[3%] hidden sm:inline-flex" style="--fd: 1.3s">
    <span class="font-bold text-accent">+40%</span>
    <span class="text-muted">YoY</span>
    <span class="meter meter--loop w-14" style="height: 5px">
      <span style="--to: 88%"></span>
    </span>
  </div>
  <div class="iso-float bottom-[6%] left-[6%] hidden sm:inline-flex" style="--fd: 2.2s">
    <span class="cycle-3 font-bold text-accent">
      <span>200</span>
      <span>1.400</span>
      <span>3.000+</span>
    </span>
    <span class="text-muted">{copy.adsWeek}</span>
    <span class="text-[#34d399]">▲</span>
  </div>
  <div class="iso-float bottom-[26%] right-[5%] hidden lg:inline-flex" style="--fd: 3.1s">
    <span class="cycle-3">
      <span><span class="text-[#34d399]">✓</span> email {es ? 'enviado' : 'sent'} · 42s</span>
      <span><span class="text-[#34d399]">✓</span> post {es ? 'publicado' : 'published'}</span>
      <span><span class="text-[#34d399]">✓</span> {es ? 'informe listo' : 'report ready'}</span>
    </span>
  </div>

  <div class="iso-plane absolute top-1/2 left-1/2 h-[400px] w-[560px] -translate-x-1/2 -translate-y-1/2">
    <div class="iso-grid"></div>

    <!-- rutas pintadas en el suelo -->
    <svg class="iso-route" viewBox="0 0 560 400" preserveAspectRatio="none" fill="none">
      <path d="M 84 103 L 288 193"></path>
      <path d="M 288 193 L 476 103"></path>
      <path d="M 288 193 L 466 335"></path>
      <path d="M 84 103 L 115 310"></path>
    </svg>

    {
      ghostPads.map((pad) => (
        <span
          class="iso-pad--ghost"
          style={`left: ${pad.left}px; top: ${pad.top}px; width: ${pad.width}px; height: ${pad.height}px;`}
        />
      ))
    }

    <!-- señales -->
    <div class="iso-spot" style="left: 34px; top: 70px; width: 100px; height: 66px;">
      <span class="iso-pad"></span>
      <div class="iso-card" style="--w: 122px; --lift: 26px;">
        <div class="iso-card-inner p-2.5" style="--bd: 0s">
          <p class="font-mono text-[0.62rem] tracking-wide text-muted">{copy.signals}</p>
          <div class="mt-1 space-y-0.5">
            {copy.feedA.map((line) => (
              <p class="truncate font-mono text-[0.58rem] text-muted/80">· {line}</p>
            ))}
          </div>
        </div>
      </div>
      <span class="iso-label">input</span>
    </div>

    <!-- agente (núcleo) -->
    <div class="iso-spot" style="left: 230px; top: 155px; width: 116px; height: 76px;">
      <span class="iso-pad iso-pad--accent"></span>
      <div class="iso-card iso-card--accent" style="--w: 140px; --lift: 46px;">
        <div class="iso-card-inner p-3" style="--bd: 0.9s">
          <p class="flex items-center gap-1.5 font-mono text-[0.65rem] tracking-wide text-ink">
            <span class="live-dot" style="width: 7px; height: 7px;"></span>
            {copy.agent}
          </p>
          <div class="mt-1 space-y-0.5">
            {copy.feedB.map((line) => (
              <p class="font-mono text-[0.58rem] text-muted">✓ {line}</p>
            ))}
          </div>
        </div>
      </div>
      <span class="iso-label">claude · 24/7</span>
    </div>

    <!-- anillos de actividad del agente (en el suelo) -->
    <span class="iso-ping" style="left: 253px; top: 168px; width: 70px; height: 50px; --pd: 0s"></span>
    <span class="iso-ping" style="left: 253px; top: 168px; width: 70px; height: 50px; --pd: 1.5s"></span>

    <!-- acciones -->
    <div class="iso-spot" style="left: 426px; top: 70px; width: 100px; height: 66px;">
      <span class="iso-pad"></span>
      <div class="iso-card" style="--w: 122px; --lift: 30px;">
        <div class="iso-card-inner p-2.5" style="--bd: 1.8s">
          <p class="font-mono text-[0.62rem] tracking-wide text-muted">{copy.actions}</p>
          <div class="mt-1 space-y-0.5">
            {copy.feedC.map((line) => (
              <p class="truncate font-mono text-[0.58rem] text-muted/80">→ {line}</p>
            ))}
          </div>
        </div>
      </div>
      <span class="iso-label">output</span>
    </div>

    <!-- resultados (tarjeta con curva) -->
    <div class="iso-spot" style="left: 412px; top: 300px; width: 108px; height: 70px;">
      <span class="iso-pad"></span>
      <div class="iso-card" style="--w: 130px; --lift: 34px;">
        <div class="iso-card-inner p-2.5" style="--bd: 2.7s">
          <p class="font-mono text-[0.62rem] tracking-wide text-muted">{copy.results}</p>
          <svg viewBox="0 0 104 30" class="mt-1 w-full" fill="none">
            <path
              d="M2 26 C 24 24, 40 19, 56 14 S 88 5, 102 3"
              stroke="var(--tone-accent)"
              stroke-width="2"
              stroke-linecap="round"
              pathLength="1"
              class="curve-draw"
            ></path>
            <circle cx="102" cy="3" r="2.5" fill="var(--tone-accent)" class="curve-dot"></circle>
          </svg>
        </div>
      </div>
      <span class="iso-label">+40% YoY</span>
    </div>

    <!-- KPIs subiendo (gráfico de barras de pie) -->
    <div class="iso-spot" style="left: 64px; top: 288px; width: 88px; height: 58px;">
      <span class="iso-pad"></span>
      <div class="iso-card" style="--w: 96px; --lift: 24px;">
        <div class="iso-card-inner p-2" style="--bd: 1.4s">
          <p class="font-mono text-[0.58rem] tracking-wide text-muted">kpis <span class="text-[#34d399]">▲</span></p>
          <div class="iso-bars mt-1">
            {[0.35, 0.55, 0.45, 0.7, 0.88, 1].map((height, index) => (
              <span style={`--bh: ${height * 100}%; --i: ${index}`} />
            ))}
          </div>
        </div>
      </div>
      <span class="iso-label">growth</span>
    </div>

    <!-- dron orbitando el agente -->
    <div class="iso-orbit" style="left: 288px; top: 193px;">
      <span></span>
    </div>

    {
      packets.map((packet) => (
        <span
          class="iso-packet"
          style={`left: ${packet.left}px; top: ${packet.top}px; --dx: ${packet.dx}px; --dy: ${packet.dy}px; --pt: ${packet.pt}; --pd: ${packet.pd};`}
        />
      ))
    }

    {
      bots.map((bot) => (
        <span
          class="iso-bot"
          style={`left: ${bot.left}px; top: ${bot.top}px; --dx: ${bot.dx}px; --dy: ${bot.dy}px; --pt: ${bot.pt}; --pd: ${bot.pd};`}
        >
          <svg viewBox="0 0 12 11" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.1">
            <path d="M6 0.5v1.8" />
            <rect x="1.2" y="2.6" width="9.6" height="7" rx="2" />
            <circle cx="4.4" cy="6" r="0.9" fill="currentColor" stroke="none" />
            <circle cx="7.6" cy="6" r="0.9" fill="currentColor" stroke="none" />
          </svg>
        </span>
      ))
    }
  </div>
</div>
